  },
  {
   "id": "s3",
   "start": 8.734,
   "end": 13.51,
   "captions": [
    {
     "text": "Profis machen das nie.",
     "start": 8.734,
     "end": 10.19
    },
    {
     "text": "Sie prüfen 4 Dinge –",
     "start": 10.19,
     "end": 11.587
