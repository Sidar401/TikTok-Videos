   "start": 0.0,
   "end": 4.17,
   "captions": [
    {
     "text": "Eine Aktie für 5 €",
     "start": 0.0,
     "end": 1.469
    },
    {
     "text": "kann teurer sein",
     "start": 1.469,
     "end": 2.775
    },
    {
     "text": "als eine für 500 €",
     "start": 2.775,
     "end": 4.17
    }
   ]
  },
  {
   "id": "s2",
   "start": 4.17,
   "end": 8.734,
   "captions": [
    {
     "text": "Klingt verrückt –",
     "start": 4.17,
     "end": 5.074
    },
    {
     "text": "aber genau hier machen",
     "start": 5.074,
     "end": 6.34
    },
