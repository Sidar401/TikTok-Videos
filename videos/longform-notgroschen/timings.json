{"dauer": 155.46, "saetze": [{"id": "s1", "start": 0.0, "end": 5.864, "captions": [{"text": "Bei jedem Zweiten", "start": 0.0, "end": 0.983}, {"text": "in Deutschland ist das Geld", "start": 0.983, "end": 2.545}, {"text": "nach 3 Monaten weg,", "start": 2.545, "end": 3.817}, {"text": "wenn plötzlich kein", "start": 3.817, "end": 4.916}, {"text": "Gehalt mehr kommt", "start": 4.916, "end": 5.864}]}, {"id": "s2", "start": 5.864, "end": 9.945, "captions": [{"text": "Und bei mehr", "start": 5.864, "end": 6.666}, {"text": "als jedem Fünften reicht", "start": 6.666, "end": 8.338}, {"text": "es nicht mal 4 Wochen", "start": 8.338, "end": 9.945}]}, {"id": "s3", "start": 9.945, "end": 13.564, "captions": [{"text": "Schick das Video jemandem,", "start": 9.945, "end": 11.623}, {"text": "der noch keinen", "start": 11.623, "end": 12.629}, {"text": "Notgroschen hat", "start": 12.629, "end": 13.564}]}, {"id": "s4", "start": 13.564, "end": 18.643, "captions": [{"text": "Folge HundeFinanzTv,", "start": 13.564, "end": 15.025}, {"text": "wir bringen dir jeden Tag", "start": 15.025, "end": 16.939}, {"text": "die wichtigsten Geld‑News", "start": 16.939, "end": 18.643}]}, {"id": "s5", "start": 18.643, "end": 23.674, "captions": [{"text": "Die Zahlen", "start": 18.643, "end": 19.138}, {"text": "kommen aus einer neuen", "start": 19.138, "end": 20.689}, {"text": "Umfrage von Civey", "start": 20.689, "end": 21.816}, {"text": "für die Versicherung Debeka", "start": 21.816, "end": 23.674}]}, {"id": "s6", "start": 23.674, "end": 29.012, "captions": [{"text": "Befragt wurden im September", "start": 23.674, "end": 25.829}, {"text": "1.000 Erwachsene,", "start": 25.829, "end": 27.215}, {"text": "Rentner nicht mitgezählt", "start": 27.215, "end": 29.012}]}, {"id": "s7", "start": 29.012, "end": 34.578, "captions": [{"text": "51 % könnten ihre Ausgaben", "start": 29.012, "end": 31.084}, {"text": "höchstens 3 Monate", "start": 31.084, "end": 32.758}, {"text": "aus eigenem Geld zahlen", "start": 32.758, "end": 34.578}]}, {"id": "s8", "start": 34.578, "end": 38.987, "captions": [{"text": "Nur 23 % würden", "start": 34.578, "end": 35.855}, {"text": "länger als ein halbes", "start": 35.855, "end": 37.661}, {"text": "Jahr durchhalten", "start": 37.661, "end": 38.987}]}, {"id": "s9", "start": 38.987, "end": 45.205, "captions": [{"text": "Und bei Frauen ist der Anteil,", "start": 38.987, "end": 40.855}, {"text": "bei dem das Geld", "start": 40.855, "end": 41.879}, {"text": "keinen Monat reicht,", "start": 41.879, "end": 43.158}, {"text": "fast doppelt so hoch", "start": 43.158, "end": 44.437}, {"text": "wie bei Männern", "start": 44.437, "end": 45.205}]}, {"id": "s10", "start": 45.205, "end": 47.014, "captions": [{"text": "Warum ist das so gefährlich?", "start": 45.205, "end": 47.014}]}, {"id": "s11", "start": 47.014, "end": 49.839, "captions": [{"text": "Weil das Leben nicht fragt,", "start": 47.014, "end": 48.643}, {"text": "ob es gerade passt", "start": 48.643, "end": 49.839}]}, {"id": "s12", "start": 49.839, "end": 55.641, "captions": [{"text": "Die Waschmaschine geht kaputt,", "start": 49.839, "end": 51.823}, {"text": "das Auto muss", "start": 51.823, "end": 52.683}, {"text": "in die Werkstatt,", "start": 52.683, "end": 53.807}, {"text": "oder der Job ist plötzlich weg", "start": 53.807, "end": 55.641}]}, {"id": "s13", "start": 55.641, "end": 58.729, "captions": [{"text": "Ohne Notgroschen landen", "start": 55.641, "end": 57.302}, {"text": "viele dann im Dispo", "start": 57.302, "end": 58.729}]}, {"id": "s14", "start": 58.729, "end": 62.632, "captions": [{"text": "Und der kostet oft mehr", "start": 58.729, "end": 60.698}, {"text": "als 10 % Zinsen im Jahr", "start": 60.698, "end": 62.632}]}, {"id": "s15", "start": 62.632, "end": 66.457, "captions": [{"text": "Aus einer kaputten", "start": 62.632, "end": 63.706}, {"text": "Waschmaschine wird", "start": 63.706, "end": 64.883}, {"text": "so schnell ein Schuldenberg", "start": 64.883, "end": 66.457}]}, {"id": "s16", "start": 66.457, "end": 68.738, "captions": [{"text": "Wie viel Notgroschen", "start": 66.457, "end": 67.689}, {"text": "brauchst du also?", "start": 67.689, "end": 68.738}]}, {"id": "s17", "start": 68.738, "end": 73.247, "captions": [{"text": "Die Verbraucherzentrale", "start": 68.738, "end": 70.433}, {"text": "rät: 2 bis 3", "start": 70.433, "end": 71.786}, {"text": "Netto‑Monatsgehälter", "start": 71.786, "end": 73.247}]}, {"id": "s18", "start": 73.247, "end": 77.572, "captions": [{"text": "Ein Beispiel: Leonie verdient", "start": 73.247, "end": 75.581}, {"text": "2000 € netto im Monat", "start": 75.581, "end": 77.572}]}, {"id": "s19", "start": 77.572, "end": 81.937, "captions": [{"text": "Ihr Notgroschen sollte also", "start": 77.572, "end": 79.739}, {"text": "bei 4.000 bis 6.000 € liegen", "start": 79.739, "end": 81.937}]}, {"id": "s20", "start": 81.937, "end": 83.346, "captions": [{"text": "Klingt viel, oder?", "start": 81.937, "end": 83.346}]}, {"id": "s21", "start": 83.346, "end": 86.462, "captions": [{"text": "Deshalb hier 3 Schritte,", "start": 83.346, "end": 85.236}, {"text": "wie du ihn aufbaust", "start": 85.236, "end": 86.462}]}, {"id": "s22", "start": 86.462, "end": 91.396, "captions": [{"text": "Schritt 1: Rechne aus,", "start": 86.462, "end": 87.972}, {"text": "was du jeden Monat", "start": 87.972, "end": 89.364}, {"text": "wirklich zum Leben brauchst", "start": 89.364, "end": 91.396}]}, {"id": "s23", "start": 91.396, "end": 97.793, "captions": [{"text": "Miete, Essen, Versicherungen,", "start": 91.396, "end": 93.759}, {"text": "Handy. Das ist", "start": 93.759, "end": 94.771}, {"text": "deine Grundlage,", "start": 94.771, "end": 96.106}, {"text": "nicht dein Wunsch‑Budget", "start": 96.106, "end": 97.793}]}, {"id": "s24", "start": 97.793, "end": 103.158, "captions": [{"text": "Schritt 2:", "start": 97.793, "end": 98.573}, {"text": "Spar automatisch,", "start": 98.573, "end": 99.754}, {"text": "direkt an dem Tag,", "start": 99.754, "end": 101.271}, {"text": "an dem das Gehalt kommt", "start": 101.271, "end": 103.158}]}, {"id": "s25", "start": 103.158, "end": 108.035, "captions": [{"text": "Schon 100 € im Monat machen", "start": 103.158, "end": 105.822}, {"text": "in 3 Jahren 3.600 €", "start": 105.822, "end": 108.035}]}, {"id": "s26", "start": 108.035, "end": 114.489, "captions": [{"text": "Schritt 3: Leg", "start": 108.035, "end": 109.078}, {"text": "den Notgroschen getrennt", "start": 109.078, "end": 110.844}, {"text": "vom Girokonto an,", "start": 110.844, "end": 112.095}, {"text": "zum Beispiel", "start": 112.095, "end": 112.979}, {"text": "auf ein Tagesgeldkonto", "start": 112.979, "end": 114.489}]}, {"id": "s27", "start": 114.489, "end": 119.941, "captions": [{"text": "Dort kommst du jederzeit ran,", "start": 114.489, "end": 116.466}, {"text": "bekommst Zinsen und gibst", "start": 116.466, "end": 118.265}, {"text": "ihn nicht aus Versehen aus", "start": 118.265, "end": 119.941}]}, {"id": "s28", "start": 119.941, "end": 124.319, "captions": [{"text": "Ganz wichtig:", "start": 119.941, "end": 120.726}, {"text": "Der Notgroschen gehört", "start": 120.726, "end": 122.294}, {"text": "nicht in Aktien oder Bitcoin", "start": 122.294, "end": 124.319}]}, {"id": "s29", "start": 124.319, "end": 128.708, "captions": [{"text": "Denn genau dann,", "start": 124.319, "end": 125.249}, {"text": "wenn du das Geld brauchst,", "start": 125.249, "end": 126.894}, {"text": "kann der Kurs", "start": 126.894, "end": 127.716}, {"text": "gerade unten sein", "start": 127.716, "end": 128.708}]}, {"id": "s30", "start": 128.708, "end": 134.001, "captions": [{"text": "Das haben wir", "start": 128.708, "end": 129.498}, {"text": "am Wochenende gesehen,", "start": 129.498, "end": 130.975}, {"text": "als Gold und Bitcoin", "start": 130.975, "end": 132.317}, {"text": "gleichzeitig abgestürzt sind", "start": 132.317, "end": 134.001}]}, {"id": "s31", "start": 134.001, "end": 139.216, "captions": [{"text": "Wer selbstständig", "start": 134.001, "end": 135.011}, {"text": "ist oder Kinder hat,", "start": 135.011, "end": 136.429}, {"text": "plant besser eher 6", "start": 136.429, "end": 138.049}, {"text": "Monatsgehälter ein", "start": 138.049, "end": 139.216}]}, {"id": "s32", "start": 139.216, "end": 144.433, "captions": [{"text": "Erst wenn der Notgroschen", "start": 139.216, "end": 140.703}, {"text": "steht,", "start": 140.703, "end": 141.085}, {"text": "lohnt sich", "start": 141.085, "end": 141.724}, {"text": "der nächste Schritt,", "start": 141.724, "end": 143.0}, {"text": "zum Beispiel ein Sparplan", "start": 143.0, "end": 144.433}]}, {"id": "s33", "start": 144.433, "end": 150.122, "captions": [{"text": "Merk dir: Der Notgroschen", "start": 144.433, "end": 145.923}, {"text": "macht dich nicht reich,", "start": 145.923, "end": 147.549}, {"text": "aber er schützt dich davor,", "start": 147.549, "end": 149.459}, {"text": "arm zu werden", "start": 149.459, "end": 150.122}]}, {"id": "s34", "start": 150.122, "end": 154.866, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 150.122, "end": 151.636}, {"text": "keine Anlageberatung,", "start": 151.636, "end": 153.375}, {"text": "nur eine Erklärung", "start": 153.375, "end": 154.866}]}]}