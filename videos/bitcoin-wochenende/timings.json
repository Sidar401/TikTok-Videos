{
  "dauer": 75.83,
  "saetze": [
    {
      "id": "s1",
      "start": 0.0,
      "end": 4.271,
      "captions": [
        {
          "text": "Bitcoin stürzt",
          "start": 0.0,
          "end": 1.049
        },
        {
          "text": "am Wochenende weiter ab,",
          "start": 1.049,
          "end": 2.767
        },
        {
          "text": "Richtung 65.000 Dollar",
          "start": 2.767,
          "end": 4.271
        }
      ]
    },
    {
      "id": "s2",
      "start": 4.271,
      "end": 7.785,
      "captions": [
        {
          "text": "Schreib uns in die Kommentare,",
          "start": 4.271,
          "end": 5.956
        },
        {
          "text": "ob du jetzt nachkaufst",
          "start": 5.956,
          "end": 7.296
        },
        {
          "text": "oder wartest",
          "start": 7.296,
          "end": 7.785
        }
      ]
    },
    {
      "id": "s3",
      "start": 7.785,
      "end": 11.154,
      "captions": [
        {
          "text": "Innerhalb einer Woche hat",
          "start": 7.785,
          "end": 9.35
        },
        {
          "text": "Bitcoin rund 14 % verloren",
          "start": 9.35,
          "end": 11.154
        }
      ]
    },
    {
      "id": "s4",
      "start": 11.154,
      "end": 15.858,
      "captions": [
        {
          "text": "Und vom Rekord im Oktober",
          "start": 11.154,
          "end": 12.974
        },
        {
          "text": "2025 ist er jetzt",
          "start": 12.974,
          "end": 14.262
        },
        {
          "text": "fast die Hälfte entfernt",
          "start": 14.262,
          "end": 15.858
        }
      ]
    },
    {
      "id": "s5",
      "start": 15.858,
      "end": 21.249,
      "captions": [
        {
          "text": "Am Freitag ist Bitcoin",
          "start": 15.858,
          "end": 17.008
        },
        {
          "text": "unter eine wichtige Linie",
          "start": 17.008,
          "end": 18.569
        },
        {
          "text": "gefallen: den Durchschnitt",
          "start": 18.569,
          "end": 19.996
        },
        {
          "text": "der letzten 200 Wochen",
          "start": 19.996,
          "end": 21.249
        }
      ]
    },
    {
      "id": "s6",
      "start": 21.249,
      "end": 26.255,
      "captions": [
        {
          "text": "Viele Anleger sehen",
          "start": 21.249,
          "end": 22.357
        },
        {
          "text": "diese Linie als Boden,",
          "start": 22.357,
          "end": 23.708
        },
        {
          "text": "und genau dieser Boden",
          "start": 23.708,
          "end": 25.084
        },
        {
          "text": "ist jetzt durchbrochen",
          "start": 25.084,
          "end": 26.255
        }
      ]
    },
    {
      "id": "s7",
      "start": 26.255,
      "end": 31.258,
      "captions": [
        {
          "text": "Grund Nummer eins:",
          "start": 26.255,
          "end": 27.168
        },
        {
          "text": "In Amerika sprechen sich",
          "start": 27.168,
          "end": 28.56
        },
        {
          "text": "immer mehr Notenbanker",
          "start": 28.56,
          "end": 29.984
        },
        {
          "text": "für höhere Zinsen aus",
          "start": 29.984,
          "end": 31.258
        }
      ]
    },
    {
      "id": "s8",
      "start": 31.258,
      "end": 36.189,
      "captions": [
        {
          "text": "Höhere Zinsen machen",
          "start": 31.258,
          "end": 32.479
        },
        {
          "text": "sichere Anlagen attraktiver,",
          "start": 32.479,
          "end": 34.284
        },
        {
          "text": "und riskante",
          "start": 34.284,
          "end": 35.068
        },
        {
          "text": "wie Bitcoin verlieren",
          "start": 35.068,
          "end": 36.189
        }
      ]
    },
    {
      "id": "s9",
      "start": 36.189,
      "end": 43.826,
      "captions": [
        {
          "text": "Grund Nummer",
          "start": 36.189,
          "end": 36.704
        },
        {
          "text": "zwei: Aus den Bitcoin‑Fonds",
          "start": 36.704,
          "end": 38.253
        },
        {
          "text": "in Amerika fließt seit über",
          "start": 38.253,
          "end": 39.974
        },
        {
          "text": "einer Woche jeden Tag Geld ab,",
          "start": 39.974,
          "end": 41.833
        },
        {
          "text": "zusammen fast zwei",
          "start": 41.833,
          "end": 42.98
        },
        {
          "text": "Milliarden Dollar",
          "start": 42.98,
          "end": 43.826
        }
      ]
    },
    {
      "id": "s10",
      "start": 43.826,
      "end": 46.153,
      "captions": [
        {
          "text": "Grund Nummer drei:",
          "start": 43.826,
          "end": 44.882
        },
        {
          "text": "Wetten auf Kredit",
          "start": 44.882,
          "end": 46.153
        }
      ]
    },
    {
      "id": "s11",
      "start": 46.153,
      "end": 52.213,
      "captions": [
        {
          "text": "In 24 Stunden wurden",
          "start": 46.153,
          "end": 47.601
        },
        {
          "text": "solche Wetten über fast",
          "start": 47.601,
          "end": 49.267
        },
        {
          "text": "1,5 Milliarden Dollar",
          "start": 49.267,
          "end": 50.788
        },
        {
          "text": "zwangsweise aufgelöst",
          "start": 50.788,
          "end": 52.213
        }
      ]
    },
    {
      "id": "s12",
      "start": 52.213,
      "end": 60.037,
      "captions": [
        {
          "text": "Und an einer Wettbörse",
          "start": 52.213,
          "end": 53.765
        },
        {
          "text": "schätzen Händler die Chance,",
          "start": 53.765,
          "end": 55.861
        },
        {
          "text": "dass Bitcoin bis Neujahr",
          "start": 55.861,
          "end": 57.658
        },
        {
          "text": "unter 55.000 Dollar fällt,",
          "start": 57.658,
          "end": 59.597
        },
        {
          "text": "auf 23 %",
          "start": 59.597,
          "end": 60.037
        }
      ]
    },
    {
      "id": "s13",
      "start": 60.037,
      "end": 64.45,
      "captions": [
        {
          "text": "Was heißt das für dich?",
          "start": 60.037,
          "end": 61.24
        },
        {
          "text": "Nicht in Panik verkaufen,",
          "start": 61.24,
          "end": 62.699
        },
        {
          "text": "aber auch nicht",
          "start": 62.699,
          "end": 63.583
        },
        {
          "text": "blind nachkaufen",
          "start": 63.583,
          "end": 64.45
        }
      ]
    },
    {
      "id": "s14",
      "start": 64.45,
      "end": 68.352,
      "captions": [
        {
          "text": "Kurzer Hinweis: Das ist",
          "start": 64.45,
          "end": 65.739
        },
        {
          "text": "keine Anlageberatung,",
          "start": 65.739,
          "end": 67.208
        },
        {
          "text": "nur eine Erklärung",
          "start": 67.208,
          "end": 68.352
        }
      ]
    },
    {
      "id": "s15",
      "start": 68.352,
      "end": 75.229,
      "captions": [
        {
          "text": "Wie Hacker gerade",
          "start": 68.352,
          "end": 69.272
        },
        {
          "text": "6,3 Milliarden Dollar",
          "start": 69.272,
          "end": 70.552
        },
        {
          "text": "in Krypto gestohlen haben,",
          "start": 70.552,
          "end": 72.137
        },
        {
          "text": "siehst du in einem ganzen",
          "start": 72.137,
          "end": 73.66
        },
        {
          "text": "Video bei uns auf dem Kanal",
          "start": 73.66,
          "end": 75.229
        }
      ]
    }
  ]
