{"dauer": 70.824, "saetze": [{"id": "s1", "start": 0.0, "end": 4.271, "captions": [{"text": "Bitcoin stürzt", "start": 0.0, "end": 1.049}, {"text": "am Wochenende weiter ab,", "start": 1.049, "end": 2.767}, {"text": "Richtung 65.000 Dollar", "start": 2.767, "end": 4.271}]}, {"id": "s2", "start": 4.271, "end": 7.785, "captions": [{"text": "Schreib uns in die Kommentare,", "start": 4.271, "end": 5.956}, {"text": "ob du jetzt nachkaufst", "start": 5.956, "end": 7.296}, {"text": "oder wartest", "start": 7.296, "end": 7.785}]}, {"id": "s3", "start": 7.785, "end": 11.154, "captions": [{"text": "Innerhalb einer Woche hat", "start": 7.785, "end": 9.35}, {"text": "Bitcoin rund 14 % verloren", "start": 9.35, "end": 11.154}]}, {"id": "s4", "start": 11.154, "end": 15.858, "captions": [{"text": "Und vom Rekord im Oktober", "start": 11.154, "end": 12.974}, {"text": "2025 ist er jetzt", "start": 12.974, "end": 14.262}, {"text": "fast die Hälfte entfernt", "start": 14.262, "end": 15.858}]}, {"id": "s5", "start": 15.858, "end": 21.249, "captions": [{"text": "Am Freitag ist Bitcoin", "start": 15.858, "end": 17.008}, {"text": "unter eine wichtige Linie", "start": 17.008, "end": 18.569}, {"text": "gefallen: den Durchschnitt", "start": 18.569, "end": 19.996}, {"text": "der letzten 200 Wochen", "start": 19.996, "end": 21.249}]}, {"id": "s6", "start": 21.249, "end": 26.252, "captions": [{"text": "Grund Nummer eins:", "start": 21.249, "end": 22.162}, {"text": "In Amerika sprechen sich", "start": 22.162, "end": 23.554}, {"text": "immer mehr Notenbanker", "start": 23.554, "end": 24.978}, {"text": "für höhere Zinsen aus", "start": 24.978, "end": 26.252}]}, {"id": "s7", "start": 26.252, "end": 31.183, "captions": [{"text": "Höhere Zinsen machen", "start": 26.252, "end": 27.473}, {"text": "sichere Anlagen attraktiver,", "start": 27.473, "end": 29.278}, {"text": "und riskante", "start": 29.278, "end": 30.062}, {"text": "wie Bitcoin verlieren", "start": 30.062, "end": 31.183}]}, {"id": "s8", "start": 31.183, "end": 38.82, "captions": [{"text": "Grund Nummer", "start": 31.183, "end": 31.698}, {"text": "zwei: Aus den Bitcoin‑Fonds", "start": 31.698, "end": 33.247}, {"text": "in Amerika fließt seit über", "start": 33.247, "end": 34.968}, {"text": "einer Woche jeden Tag Geld ab,", "start": 34.968, "end": 36.827}, {"text": "zusammen fast zwei", "start": 36.827, "end": 37.974}, {"text": "Milliarden Dollar", "start": 37.974, "end": 38.82}]}, {"id": "s9", "start": 38.82, "end": 41.147, "captions": [{"text": "Grund Nummer drei:", "start": 38.82, "end": 39.876}, {"text": "Wetten auf Kredit", "start": 39.876, "end": 41.147}]}, {"id": "s10", "start": 41.147, "end": 47.207, "captions": [{"text": "In 24 Stunden wurden", "start": 41.147, "end": 42.595}, {"text": "solche Wetten über fast", "start": 42.595, "end": 44.261}, {"text": "1,5 Milliarden Dollar", "start": 44.261, "end": 45.782}, {"text": "zwangsweise aufgelöst", "start": 45.782, "end": 47.207}]}, {"id": "s11", "start": 47.207, "end": 55.031, "captions": [{"text": "Und an einer Wettbörse", "start": 47.207, "end": 48.759}, {"text": "schätzen Händler die Chance,", "start": 48.759, "end": 50.855}, {"text": "dass Bitcoin bis Neujahr", "start": 50.855, "end": 52.652}, {"text": "unter 55.000 Dollar fällt,", "start": 52.652, "end": 54.591}, {"text": "auf 23 %", "start": 54.591, "end": 55.031}]}, {"id": "s12", "start": 55.031, "end": 59.444, "captions": [{"text": "Was heißt das für dich?", "start": 55.031, "end": 56.234}, {"text": "Nicht in Panik verkaufen,", "start": 56.234, "end": 57.693}, {"text": "aber auch nicht", "start": 57.693, "end": 58.577}, {"text": "blind nachkaufen", "start": 58.577, "end": 59.444}]}, {"id": "s13", "start": 59.444, "end": 63.346, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 59.444, "end": 60.733}, {"text": "keine Anlageberatung,", "start": 60.733, "end": 62.202}, {"text": "nur eine Erklärung", "start": 62.202, "end": 63.346}]}, {"id": "s14", "start": 63.346, "end": 70.223, "captions": [{"text": "Wie Hacker gerade", "start": 63.346, "end": 64.266}, {"text": "6,3 Milliarden Dollar", "start": 64.266, "end": 65.546}, {"text": "in Krypto gestohlen haben,", "start": 65.546, "end": 67.131}, {"text": "siehst du in einem ganzen", "start": 67.131, "end": 68.654}, {"text": "Video bei uns auf dem Kanal", "start": 68.654, "end": 70.223}]}]}