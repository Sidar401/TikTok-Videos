          "end": 11.302
        },
        {
          "text": "der online shoppt",
          "start": 11.302,
          "end": 12.122
        }
      ]
    },
    {
      "id": "s4",
      "start": 12.122,
      "end": 16.716,
      "captions": [
        {
          "text": "Folge HundeFinanzTv,",
          "start": 12.122,
          "end": 13.272
        },
        {
          "text": "wir erklären dir jeden Tag,",
          "start": 13.272,
          "end": 14.965
        },
        {
          "text": "wie Geld wirklich funktioniert",
          "start": 14.965,
          "end": 16.716
        }
      ]
    },
    {
      "id": "s5",
      "start": 16.716,
      "end": 19.722,
      "captions": [
        {
          "text": "Kurz vorweg: Das ist keine",
          "start": 16.716,
          "end": 18.12
        },
        {
          "text": "Anlage‑ oder Rechtsberatung",
          "start": 18.12,
          "end": 19.722
        }
      ]
    },
    {
      "id": "s6",
      "start": 19.722,
      "end": 23.538,
      "captions": [
        {
          "text": "Fangen wir an:",
          "start": 19.722,
          "end": 20.449
        },
        {
          "text": "Wie funktioniert jetzt kaufen,",
          "start": 20.449,
          "end": 22.091
        },
        {
          "text": "später zahlen eigentlich?",
          "start": 22.091,
          "end": 23.538
        }
      ]
    },
    {
      "id": "s7",
      "start": 23.538,
      "end": 28.715,
      "captions": [
        {
          "text": "Du bestellst Schuhe für 100 €,",
          "start": 23.538,
          "end": 25.539
        },
        {
          "text": "zahlst aber erst in 30 Tagen",
          "start": 25.539,
          "end": 27.525
        },
        {
          "text": "oder in vier Raten",
          "start": 27.525,
          "end": 28.715
        }
      ]
    },
    {
      "id": "s8",
      "start": 28.715,
      "end": 33.535,
      "captions": [
        {
          "text": "Für dich wirkt das kostenlos,",
          "start": 28.715,
          "end": 30.296
        },
        {
          "text": "aber das Geld bekommt",
          "start": 30.296,
          "end": 31.523
        },
        {
          "text": "der Shop sofort,",
          "start": 31.523,
          "end": 32.473
        },
        {
          "text": "vom Zahlungsanbieter",
          "start": 32.473,
          "end": 33.535
        }
      ]
    },
    {
      "id": "s9",
      "start": 33.535,
      "end": 37.646,
      "captions": [
        {
          "text": "Und der Shop zahlt",
          "start": 33.535,
          "end": 34.58
        },
        {
          "text": "dafür eine Gebühr,",
          "start": 34.58,
          "end": 35.717
        },
        {
          "text": "oft mehrere Prozent",
          "start": 35.717,
          "end": 36.949
        },
        {
          "text": "vom Kaufpreis",
          "start": 36.949,
          "end": 37.646
        }
      ]
    },
    {
      "id": "s10",
      "start": 37.646,
      "end": 42.626,
      "captions": [
        {
          "text": "Warum machen Shops das?",
          "start": 37.646,
          "end": 38.991
        },
        {
          "text": "Weil Leute mit später",
          "start": 38.991,
          "end": 40.11
        },
