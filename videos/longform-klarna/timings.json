          "end": 6.659
        }
      ]
    },
    {
      "id": "s3",
      "start": 6.659,
      "end": 12.122,
      "captions": [
        {
          "text": "Aber ab dem zwanzigsten",
          "start": 6.659,
          "end": 7.784
        },
