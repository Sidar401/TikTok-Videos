          "start": 90.195,
          "end": 91.605
        },
        {
          "text": "zum Beispiel beim Widerruf",
          "start": 91.605,
          "end": 92.947
        }
      ]
    },
    {
      "id": "s22",
      "start": 92.947,
      "end": 98.481,
      "captions": [
