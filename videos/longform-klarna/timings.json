          "start": 94.867,
          "end": 96.663
        },
        {
          "text": "wenn deine Finanzen knapp sind",
          "start": 96.663,
          "end": 98.481
        }
      ]
    },
    {
      "id": "s23",
      "start": 98.481,
      "end": 101.502,
      "captions": [
