          "start": 74.106,
          "end": 75.253
        },
        {
          "text": "für Verbraucherkredite",
          "start": 75.253,
          "end": 76.432
        }
      ]
    },
    {
      "id": "s19",
      "start": 76.432,
      "end": 83.199,
      "captions": [
        {
          "text": "Dann zählen auch jetzt kaufen,",
          "start": 76.432,
          "end": 78.562
        },
        {
          "text": "später zahlen und kleine",
          "start": 78.562,
          "end": 80.385
