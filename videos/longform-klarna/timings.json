    {
      "id": "s16",
      "start": 65.588,
      "end": 69.894,
      "captions": [
        {
          "text": "Kennst du jemanden,",
          "start": 65.588,
          "end": 66.57
        },
        {
          "text": "der ständig mit Klarna",
          "start": 66.57,
          "end": 67.98
        },
