          "text": "zahlen mehr kaufen,",
          "start": 40.11,
          "end": 41.312
        },
        {
          "text": "und zwar deutlich mehr",
          "start": 41.312,
          "end": 42.626
        }
      ]
    },
    {
      "id": "s11",
      "start": 42.626,
      "end": 47.047,
      "captions": [
        {
          "text": "Das Gehirn spürt den Schmerz",
          "start": 42.626,
          "end": 43.941
        },
        {
          "text": "des Bezahlens einfach nicht,",
          "start": 43.941,
          "end": 45.367
        },
        {
          "text": "wenn das Geld nicht",
          "start": 45.367,
          "end": 46.334
        },
        {
          "text": "sofort weggeht",
          "start": 46.334,
          "end": 47.047
        }
      ]
    },
    {
      "id": "s12",
      "start": 47.047,
      "end": 48.87,
      "captions": [
        {
          "text": "Und genau hier liegt die Falle",
          "start": 47.047,
          "end": 48.87
        }
      ]
    },
    {
      "id": "s13",
      "start": 48.87,
      "end": 53.771,
      "captions": [
        {
          "text": "Zahlst du nicht pünktlich,",
          "start": 48.87,
          "end": 50.351
        },
        {
          "text": "kommen Mahngebühren dazu,",
          "start": 50.351,
          "end": 51.856
        },
        {
          "text": "und bei Ratenkäufen",
          "start": 51.856,
          "end": 53.052
        },
        {
          "text": "oft auch Zinsen",
          "start": 53.052,
          "end": 53.771
        }
      ]
    },
    {
      "id": "s14",
      "start": 53.771,
      "end": 59.642,
      "captions": [
        {
          "text": "Viele haben gleichzeitig",
          "start": 53.771,
          "end": 54.905
        },
        {
          "text": "mehrere offene Rechnungen",
          "start": 54.905,
          "end": 56.321
        },
        {
          "text": "bei verschiedenen",
          "start": 56.321,
          "end": 57.284
        },
        {
          "text": "Anbietern und verlieren",
          "start": 57.284,
          "end": 58.587
        },
        {
          "text": "komplett den Überblick",
          "start": 58.587,
          "end": 59.642
        }
      ]
    },
    {
      "id": "s15",
      "start": 59.642,
      "end": 65.588,
      "captions": [
        {
          "text": "Gerade junge Leute rutschen",
          "start": 59.642,
          "end": 61.073
        },
