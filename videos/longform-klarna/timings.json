          "end": 69.035
        },
        {
          "text": "ihm dieses Video",
          "start": 69.035,
          "end": 69.894
        }
      ]
    },
    {
      "id": "s17",
      "start": 69.894,
      "end": 71.557,
      "captions": [
        {
          "text": "Und jetzt zur neuen Regel",
          "start": 69.894,
          "end": 71.557
        }
