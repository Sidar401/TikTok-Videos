{
  "dauer": 34.17,
  "saetze": [
    {
      "id": "s1",
      "start": 0.0,
      "end": 3.93,
      "captions": [
        {
          "text": "Du kannst dir dein Steuergeld",
          "start": 0.0,
          "end": 1.519
        },
        {
          "text": "jeden Monat holen,",
          "start": 1.519,
          "end": 2.462
        },
        {
          "text": "statt ein Jahr",
          "start": 2.462,
          "end": 3.196
        },
        {
          "text": "darauf zu warten",
          "start": 3.196,
          "end": 3.93
        }
      ]
    },
    {
      "id": "s2",
      "start": 3.93,
      "end": 9.374,
      "captions": [
        {
          "text": "Das geht",
          "start": 3.93,
          "end": 4.385
        },
        {
          "text": "mit dem Lohnsteuer‑Freibetrag,",
          "start": 4.385,
          "end": 6.47
        },
        {
          "text": "und den kannst du jetzt",
          "start": 6.47,
          "end": 8.081
        },
        {
          "text": "für 2027 beantragen",
          "start": 8.081,
          "end": 9.374
        }
      ]
    },
    {
      "id": "s3",
      "start": 9.374,
      "end": 12.262,
      "captions": [
        {
          "text": "Schick das jemandem,",
          "start": 9.374,
          "end": 10.435
        },
        {
          "text": "der jeden Tag weit",
          "start": 10.435,
          "end": 11.489
        },
        {
          "text": "zur Arbeit fährt",
          "start": 11.489,
          "end": 12.262
        }
      ]
    },
    {
      "id": "s4",
      "start": 12.262,
      "end": 17.126,
      "captions": [
        {
          "text": "Ein Beispiel: Du fährst",
          "start": 12.262,
          "end": 13.711
        },
        {
          "text": "30 Kilometer zur Arbeit,",
          "start": 13.711,
          "end": 15.616
        },
        {
          "text": "an 220 Tagen im Jahr",
          "start": 15.616,
          "end": 17.126
        }
      ]
    },
    {
      "id": "s5",
      "start": 17.126,
      "end": 22.303,
      "captions": [
        {
          "text": "Das sind rund",
          "start": 17.126,
          "end": 18.103
        },
        {
          "text": "2.500 € Fahrtkosten,",
          "start": 18.103,
          "end": 19.726
        },
        {
          "text": "über 1.000 € mehr",
          "start": 19.726,
          "end": 21.018
        },
        {
          "text": "als die Pauschale",
          "start": 21.018,
          "end": 22.303
        }
      ]
    },
    {
      "id": "s6",
      "start": 22.303,
      "end": 26.733,
      "captions": [
        {
          "text": "Trägst du",
          "start": 22.303,
          "end": 22.792
        },
        {
          "text": "das als Freibetrag ein,",
          "start": 22.792,
          "end": 24.288
        },
        {
          "text": "hast du jeden Monat",
          "start": 24.288,
          "end": 25.524
        },
        {
          "text": "rund 30 € mehr netto",
          "start": 25.524,
          "end": 26.733
        }
      ]
    },
    {
      "id": "s7",
      "start": 26.733,
      "end": 30.157,
      "captions": [
        {
          "text": "Den Antrag stellst du",
          "start": 26.733,
          "end": 27.884
        },
        {
          "text": "einfach online über",
          "start": 27.884,
          "end": 29.007
        },
        {
          "text": "Elster beim Finanzamt",
          "start": 29.007,
          "end": 30.157
        }
      ]
    },
    {
      "id": "s8",
      "start": 30.157,
      "end": 33.572,
      "captions": [
        {
          "text": "Wichtig: Dann",
          "start": 30.157,
          "end": 30.783
        },
        {
          "text": "musst du für das Jahr auch",
          "start": 30.783,
          "end": 32.086
        },
        {
          "text": "eine Steuererklärung machen",
          "start": 32.086,
          "end": 33.572
        }
      ]
    }
  ]
}