  {
   "id": "s1",
   "start": 0.0,
   "end": 3.214,
   "captions": [
    {
     "text": "Wie viel Geld brauchst du,",
     "start": 0.0,
     "end": 1.537
    },
    {
     "text": "um nie wieder",
     "start": 1.537,
     "end": 2.305
    },
    {
     "text": "arbeiten zu müssen?",
     "start": 2.305,
     "end": 3.214
    }
   ]
  },
  {
   "id": "s2",
   "start": 3.214,
   "end": 7.0,
   "captions": [
    {
     "text": "Die Antwort überrascht",
     "start": 3.214,
     "end": 4.362
    },
    {
     "text": "die meisten – und wir rechnen",
     "start": 4.362,
     "end": 5.872
    },
    {
     "text": "sie dir jetzt live vor",
     "start": 5.872,
     "end": 7.0
    }
   ]
  },
  {
   "id": "s3",
   "start": 7.0,
   "end": 11.582,
   "captions": [
    {
     "text": "Und am Ende zeigen",
     "start": 7.0,
     "end": 8.003
    },
    {
     "text": "wir dir den Trick,",
     "start": 8.003,
     "end": 9.025
    },
    {
     "text": "mit dem du dein Ziel",
     "start": 9.025,
     "end": 10.162
    },
    {
     "text": "10 Jahre früher erreichst",
     "start": 10.162,
     "end": 11.582
    }
   ]
  },
  {
   "id": "s4",
   "start": 14.582,
   "end": 17.775,
   "captions": [
    {
     "text": "Sagen wir,",
     "start": 14.582,
     "end": 15.144
    },
    {
     "text": "du willst",
     "start": 15.144,
     "end": 15.827
    },
    {
     "text": "2.000 € im Monat zum Leben",
     "start": 15.827,
     "end": 17.775
    }
   ]
  },
  {
   "id": "s5",
   "start": 17.775,
   "end": 20.023,
   "captions": [
    {
     "text": "Das sind 24.000 € im Jahr",
     "start": 17.775,
     "end": 20.023
    }
   ]
  },
  {
   "id": "s6",
   "start": 20.023,
   "end": 22.723,
   "captions": [
    {
     "text": "Profis nutzen",
     "start": 20.023,
     "end": 21.088
    },
    {
     "text": "dafür die 4‑%‑Regel",
     "start": 21.088,
     "end": 22.723
    }
   ]
  },
  {
   "id": "s7",
   "start": 22.723,
   "end": 28.315,
   "captions": [
    {
     "text": "Du nimmst jedes Jahr nur",
     "start": 22.723,
     "end": 24.285
    },
    {
     "text": "4 % von deinem Geld –",
     "start": 24.285,
     "end": 25.652
    },
    {
     "text": "der Rest bleibt angelegt",
     "start": 25.652,
     "end": 27.182
    },
    {
     "text": "und arbeitet weiter",
     "start": 27.182,
     "end": 28.315
    }
   ]
  },
  {
   "id": "s8",
   "start": 28.315,
   "end": 35.131,
   "captions": [
    {
     "text": "Eine bekannte US‑Studie",
     "start": 28.315,
     "end": 29.832
    },
    {
     "text": "hat gezeigt: So hat das Geld",
     "start": 29.832,
     "end": 31.806
    },
    {
     "text": "in fast allen Fällen",
     "start": 31.806,
     "end": 33.215
    },
    {
     "text": "mindestens 30 Jahre gereicht",
     "start": 33.215,
     "end": 35.131
    }
   ]
  },
  {
   "id": "s9",
   "start": 35.131,
   "end": 39.764,
   "captions": [
    {
     "text": "24.000 geteilt durch",
     "start": 35.131,
     "end": 37.258
    },
    {
     "text": "4 % – das sind 600.000 €",
     "start": 37.258,
     "end": 39.764
    }
   ]
  },
  {
   "id": "s10",
   "start": 39.764,
   "end": 42.229,
   "captions": [
    {
     "text": "Klingt viel? Jetzt",
     "start": 39.764,
     "end": 40.815
    },
    {
     "text": "kommt der spannende Teil",
     "start": 40.815,
     "end": 42.229
    }
   ]
  },
  {
   "id": "s11",
   "start": 42.229,
   "end": 47.462,
   "captions": [
    {
     "text": "Mit 200 € im Monat",
     "start": 42.229,
     "end": 43.8
