    {
     "text": "und 7 % Rendite brauchst",
     "start": 43.8,
     "end": 46.038
    },
    {
     "text": "du rund 42 Jahre",
     "start": 46.038,
     "end": 47.462
    }
   ]
  },
  {
   "id": "s12",
   "start": 47.462,
   "end": 50.652,
   "captions": [
    {
     "text": "Mit 500 € sind es nur",
     "start": 47.462,
     "end": 49.191
    },
    {
     "text": "noch etwa 30 Jahre",
     "start": 49.191,
     "end": 50.652
    }
   ]
  },
  {
   "id": "s13",
   "start": 50.652,
   "end": 54.926,
   "captions": [
    {
     "text": "Und mit 1.000 € im Monat",
     "start": 50.652,
     "end": 52.242
    },
    {
     "text": "bist du schon nach rund",
     "start": 52.242,
     "end": 53.843
    },
    {
     "text": "22 Jahren am Ziel",
     "start": 53.843,
     "end": 54.926
    }
   ]
  },
  {
   "id": "s14",
   "start": 54.926,
   "end": 58.482,
   "captions": [
    {
     "text": "Schreib uns",
     "start": 54.926,
     "end": 55.451
    },
    {
     "text": "in die Kommentare: Wie viel",
     "start": 55.451,
     "end": 56.984
    },
    {
     "text": "müsstest du im Monat sparen?",
     "start": 56.984,
     "end": 58.482
    }
   ]
  },
  {
   "id": "s15",
   "start": 58.482,
   "end": 65.801,
   "captions": [
    {
     "text": "Und jetzt der Aha‑Moment:",
     "start": 58.482,
     "end": 60.474
    },
    {
     "text": "Bei 500 € im Monat",
     "start": 60.474,
     "end": 61.978
    },
    {
     "text": "zahlst du in 30 Jahren",
     "start": 61.978,
     "end": 63.817
    },
    {
     "text": "nur 180.000 € selbst ein",
     "start": 63.817,
     "end": 65.801
    }
   ]
  },
  {
   "id": "s16",
   "start": 65.801,
   "end": 69.811,
   "captions": [
    {
     "text": "Die restlichen 430.000 € sind",
     "start": 65.801,
     "end": 68.345
    },
    {
     "text": "Zinsen auf Zinsen",
     "start": 68.345,
     "end": 69.811
    }
   ]
  },
  {
   "id": "s17",
   "start": 69.811,
   "end": 77.795,
   "captions": [
    {
     "text": "Deshalb ist der Startzeitpunkt",
     "start": 69.811,
     "end": 71.887
    },
    {
     "text": "der größte Trick:",
     "start": 71.887,
     "end": 73.087
    },
    {
     "text": "Wer 10 Jahre später anfängt,",
     "start": 73.087,
     "end": 75.062
    },
    {
     "text": "hat mit derselben Rate",
     "start": 75.062,
     "end": 76.614
    },
    {
     "text": "nur rund 260.000 €",
     "start": 76.614,
     "end": 77.795
    }
   ]
  },
  {
   "id": "s18",
   "start": 77.795,
   "end": 82.076,
   "captions": [
    {
     "text": "Aber Achtung: Steuern",
     "start": 77.795,
     "end": 78.979
    },
    {
     "text": "und Inflation machen dein Ziel",
     "start": 78.979,
     "end": 80.814
    },
    {
     "text": "in Wirklichkeit größer",
     "start": 80.814,
     "end": 82.076
    }
   ]
  },
  {
   "id": "s19",
   "start": 82.076,
   "end": 88.398,
   "captions": [
    {
     "text": "Bei 2 % Inflation sind",
     "start": 82.076,
     "end": 83.757
    },
    {
     "text": "2.000 € in 30 Jahren nur noch",
     "start": 83.757,
     "end": 86.084
    },
    {
     "text": "so viel wert wie heute 1.100 €",
     "start": 86.084,
     "end": 88.398
    }
   ]
  },
  {
   "id": "s20",
   "start": 88.398,
   "end": 94.304,
   "captions": [
    {
     "text": "Unser Tipp: Fang",
     "start": 88.398,
     "end": 89.267
