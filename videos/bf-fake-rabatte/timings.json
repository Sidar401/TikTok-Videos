{"dauer": 63.32, "saetze": [{"id": "s1", "start": 0.0, "end": 3.095, "captions": [{"text": "Am Black Friday sparst", "start": 0.0, "end": 1.274}, {"text": "du oft viel weniger,", "start": 1.274, "end": 2.432}, {"text": "als du denkst", "start": 2.432, "end": 3.095}]}, {"id": "s2", "start": 3.095, "end": 8.2, "captions": [{"text": "Laut einer Studie glauben", "start": 3.095, "end": 4.639}, {"text": "nur 37 % der Deutschen,", "start": 4.639, "end": 6.143}, {"text": "dass es dann", "start": 6.143, "end": 6.928}, {"text": "wirklich billiger ist", "start": 6.928, "end": 8.2}]}, {"id": "s3", "start": 8.2, "end": 11.568, "captions": [{"text": "Schick das Video jemandem,", "start": 8.2, "end": 9.858}, {"text": "der am Black Friday", "start": 9.858, "end": 11.143}, {"text": "immer zuschlägt", "start": 11.143, "end": 11.568}]}, {"id": "s4", "start": 11.568, "end": 14.431, "captions": [{"text": "Trick Nummer 1:", "start": 11.568, "end": 12.744}, {"text": "der durchgestrichene Preis", "start": 12.744, "end": 14.431}]}, {"id": "s5", "start": 14.431, "end": 19.189, "captions": [{"text": "Oft steht da", "start": 14.431, "end": 15.018}, {"text": "die Preisempfehlung", "start": 15.018, "end": 16.22}, {"text": "vom Hersteller,", "start": 16.22, "end": 17.132}, {"text": "ein Preis,", "start": 17.132, "end": 17.764}, {"text": "den fast niemand verlangt", "start": 17.764, "end": 19.189}]}, {"id": "s6", "start": 19.189, "end": 25.054, "captions": [{"text": "Beispiel: Ein Fernseher,", "start": 19.189, "end": 21.765}, {"text": "Empfehlung 450 €,", "start": 21.765, "end": 23.779}, {"text": "jetzt 299 €", "start": 23.779, "end": 25.054}]}, {"id": "s7", "start": 25.054, "end": 27.061, "captions": [{"text": "Klingt nach 34 % Rabatt", "start": 25.054, "end": 27.061}]}, {"id": "s8", "start": 27.061, "end": 30.473, "captions": [{"text": "Aber sonst kostet er", "start": 27.061, "end": 28.646}, {"text": "im Laden auch nur 320 €", "start": 28.646, "end": 30.473}]}, {"id": "s9", "start": 30.473, "end": 32.9, "captions": [{"text": "Echter Rabatt: nur rund 7 %", "start": 30.473, "end": 32.9}]}, {"id": "s10", "start": 32.9, "end": 36.405, "captions": [{"text": "Trick Nummer 2:", "start": 32.9, "end": 34.013}, {"text": "der Countdown. Nur", "start": 34.013, "end": 35.176}, {"text": "noch 10 Minuten", "start": 35.176, "end": 36.405}]}, {"id": "s11", "start": 36.405, "end": 39.229, "captions": [{"text": "Lass dich nicht hetzen,", "start": 36.405, "end": 37.64}, {"text": "Druck macht teure", "start": 37.64, "end": 38.69}, {"text": "Entscheidungen", "start": 38.69, "end": 39.229}]}, {"id": "s12", "start": 39.229, "end": 42.41, "captions": [{"text": "Trick Nummer 3: Preise", "start": 39.229, "end": 40.612}, {"text": "werden vorher hochgesetzt", "start": 40.612, "end": 42.41}]}, {"id": "s13", "start": 42.41, "end": 46.643, "captions": [{"text": "Dabei muss sich ein Rabatt", "start": 42.41, "end": 43.751}, {"text": "auf den niedrigsten Preis", "start": 43.751, "end": 45.119}, {"text": "der letzten 30 Tage beziehen", "start": 45.119, "end": 46.643}]}, {"id": "s14", "start": 46.643, "end": 50.838, "captions": [{"text": "Unser Tipp: Leg dir jetzt", "start": 46.643, "end": 47.998}, {"text": "eine Merkliste an und schau,", "start": 47.998, "end": 49.793}, {"text": "was es heute kostet", "start": 49.793, "end": 50.838}]}, {"id": "s15", "start": 50.838, "end": 55.349, "captions": [{"text": "Und vergleich auf mindestens", "start": 50.838, "end": 52.386}, {"text": "2 Preisseiten,", "start": 52.386, "end": 53.431}, {"text": "das rät auch", "start": 53.431, "end": 54.112}, {"text": "die Verbraucherzentrale", "start": 54.112, "end": 55.349}]}, {"id": "s16", "start": 55.349, "end": 58.654, "captions": [{"text": "Black Friday ist dieses", "start": 55.349, "end": 56.571}, {"text": "Jahr am 27.", "start": 56.571, "end": 58.273}, {"text": "November", "start": 58.273, "end": 58.654}]}, {"id": "s17", "start": 58.654, "end": 62.72, "captions": [{"text": "Und denk dran: Das beste", "start": 58.654, "end": 59.829}, {"text": "Schnäppchen ist das,", "start": 59.829, "end": 61.06}, {"text": "was du gar nicht erst kaufst", "start": 61.06, "end": 62.72}]}]}