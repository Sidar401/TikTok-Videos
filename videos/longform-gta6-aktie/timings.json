{"dauer": 135.81, "saetze": [{"id": "s1", "start": 0.0, "end": 6.242, "captions": [{"text": "In fünf Tagen erscheint", "start": 0.0, "end": 1.317}, {"text": "das meisterwartete", "start": 1.317, "end": 2.348}, {"text": "Videospiel aller Zeiten,", "start": 2.348, "end": 3.722}, {"text": "und die Aktie dahinter", "start": 3.722, "end": 4.982}, {"text": "könnte trotzdem fallen", "start": 4.982, "end": 6.242}]}, {"id": "s2", "start": 6.242, "end": 9.317, "captions": [{"text": "Es geht um GTA 6", "start": 6.242, "end": 7.706}, {"text": "und die Firma Take‑Two", "start": 7.706, "end": 9.317}]}, {"id": "s3", "start": 9.317, "end": 12.55, "captions": [{"text": "Markier jemanden,", "start": 9.317, "end": 10.163}, {"text": "der sich am 19.", "start": 10.163, "end": 11.307}, {"text": "November krankmelden wird", "start": 11.307, "end": 12.55}]}, {"id": "s4", "start": 12.55, "end": 16.367, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 12.55, "end": 13.966}, {"text": "keine Anlageberatung,", "start": 13.966, "end": 15.259}, {"text": "nur eine Erklärung", "start": 15.259, "end": 16.367}]}, {"id": "s5", "start": 16.367, "end": 19.084, "captions": [{"text": "Teil eins:", "start": 16.367, "end": 17.273}, {"text": "Die Firma hinter GTA", "start": 17.273, "end": 19.084}]}, {"id": "s6", "start": 19.084, "end": 23.395, "captions": [{"text": "GTA wird vom Studio", "start": 19.084, "end": 20.289}, {"text": "Rockstar Games gemacht,", "start": 20.289, "end": 21.747}, {"text": "und das gehört zu Take‑Two", "start": 21.747, "end": 23.395}]}, {"id": "s7", "start": 23.395, "end": 26.97, "captions": [{"text": "Die Firma ist an der Börse", "start": 23.395, "end": 25.055}, {"text": "rund 43 Milliarden Dollar wert", "start": 25.055, "end": 26.97}]}, {"id": "s8", "start": 26.97, "end": 32.85, "captions": [{"text": "Und jetzt kommt der Haken:", "start": 26.97, "end": 28.454}, {"text": "Im letzten Geschäftsjahr hat", "start": 28.454, "end": 30.053}, {"text": "Take‑Two fast 300 Millionen", "start": 30.053, "end": 31.594}, {"text": "Dollar Verlust gemacht", "start": 31.594, "end": 32.85}]}, {"id": "s9", "start": 32.85, "end": 36.508, "captions": [{"text": "Der ganze Wert hängt also", "start": 32.85, "end": 34.575}, {"text": "an einer Hoffnung: GTA 6", "start": 34.575, "end": 36.508}]}, {"id": "s10", "start": 36.508, "end": 38.092, "captions": [{"text": "Teil zwei: Die Rechnung", "start": 36.508, "end": 38.092}]}, {"id": "s11", "start": 38.092, "end": 43.919, "captions": [{"text": "Analysten erwarten", "start": 38.092, "end": 39.326}, {"text": "im ersten Geschäftsjahr", "start": 39.326, "end": 40.903}, {"text": "zwischen 35 und 55 Millionen", "start": 40.903, "end": 42.822}, {"text": "verkaufte Spiele", "start": 42.822, "end": 43.919}]}, {"id": "s12", "start": 43.919, "end": 49.796, "captions": [{"text": "Bei 50 Millionen Kopien", "start": 43.919, "end": 45.567}, {"text": "zu rund 90 Dollar wären", "start": 45.567, "end": 47.216}, {"text": "das etwa 4,5 Milliarden", "start": 47.216, "end": 48.864}, {"text": "Dollar Umsatz", "start": 48.864, "end": 49.796}]}, {"id": "s13", "start": 49.796, "end": 53.083, "captions": [{"text": "Das klingt riesig,", "start": 49.796, "end": 50.853}, {"text": "ist aber nur ein Zehntel", "start": 50.853, "end": 52.261}, {"text": "vom Börsenwert", "start": 52.261, "end": 53.083}]}, {"id": "s14", "start": 53.083, "end": 57.88, "captions": [{"text": "Die Anleger rechnen", "start": 53.083, "end": 54.168}, {"text": "also schon jetzt damit,", "start": 54.168, "end": 55.482}, {"text": "dass GTA 6 über", "start": 55.482, "end": 56.567}, {"text": "viele Jahre Geld bringt", "start": 56.567, "end": 57.88}]}, {"id": "s15", "start": 57.88, "end": 60.112, "captions": [{"text": "Teil drei: Was", "start": 57.88, "end": 58.799}, {"text": "die Geschichte zeigt", "start": 58.799, "end": 60.112}]}, {"id": "s16", "start": 60.112, "end": 64.25, "captions": [{"text": "GTA 5 hat am ersten", "start": 60.112, "end": 61.58}, {"text": "Tag über 800 Millionen", "start": 61.58, "end": 63.049}, {"text": "Dollar eingespielt", "start": 63.049, "end": 64.25}]}, {"id": "s17", "start": 64.25, "end": 69.295, "captions": [{"text": "Und die Aktie? Sie", "start": 64.25, "end": 65.547}, {"text": "stieg am Tag danach", "start": 65.547, "end": 66.917}, {"text": "nur um gut 1 %,", "start": 66.917, "end": 67.998}, {"text": "auf rund 17 Dollar", "start": 67.998, "end": 69.295}]}, {"id": "s18", "start": 69.295, "end": 75.978, "captions": [{"text": "Das große Geld", "start": 69.295, "end": 70.436}, {"text": "kam erst später: über", "start": 70.436, "end": 72.148}, {"text": "225 Millionen Exemplare", "start": 72.148, "end": 74.022}, {"text": "und jahrelang GTA Online", "start": 74.022, "end": 75.978}]}, {"id": "s19", "start": 75.978, "end": 79.36, "captions": [{"text": "Aus 17 Dollar wurden über", "start": 75.978, "end": 77.777}, {"text": "die Jahre mehr als 200", "start": 77.777, "end": 79.36}]}, {"id": "s20", "start": 79.36, "end": 87.275, "captions": [{"text": "Aber es geht auch", "start": 79.36, "end": 80.328}, {"text": "anders: Nach dem Rekordstart", "start": 80.328, "end": 81.922}, {"text": "von Red Dead Redemption", "start": 81.922, "end": 83.232}, {"text": "2 lag die Aktie", "start": 83.232, "end": 84.257}, {"text": "wenige Wochen später rund", "start": 84.257, "end": 85.681}, {"text": "ein Viertel unter ihrem Hoch", "start": 85.681, "end": 87.275}]}, {"id": "s21", "start": 87.275, "end": 93.79, "captions": [{"text": "Und bei Cyberpunk", "start": 87.275, "end": 88.222}, {"text": "verlor die Firma CD", "start": 88.222, "end": 89.28}, {"text": "Projekt nach dem verbuggten", "start": 89.28, "end": 90.783}, {"text": "Start im ersten Monat rund", "start": 90.783, "end": 92.231}, {"text": "die Hälfte ihres Börsenwerts", "start": 92.231, "end": 93.79}]}, {"id": "s22", "start": 93.79, "end": 97.442, "captions": [{"text": "Schreib uns", "start": 93.79, "end": 94.428}, {"text": "in die Kommentare: Kaufst", "start": 94.428, "end": 95.877}, {"text": "du GTA 6 am ersten Tag?", "start": 95.877, "end": 97.442}]}, {"id": "s23", "start": 97.442, "end": 99.841, "captions": [{"text": "Teil vier: Wo steht", "start": 97.442, "end": 98.744}, {"text": "die Aktie jetzt?", "start": 98.744, "end": 99.841}]}, {"id": "s24", "start": 99.841, "end": 106.019, "captions": [{"text": "Im Sommer lag Take‑Two", "start": 99.841, "end": 101.755}, {"text": "bei rund 266 Dollar,", "start": 101.755, "end": 103.496}, {"text": "Ende Oktober nur noch bei 190", "start": 103.496, "end": 106.019}]}, {"id": "s25", "start": 106.019, "end": 110.03, "captions": [{"text": "Vor ein paar Tagen", "start": 106.019, "end": 107.308}, {"text": "ging es wieder auf rund", "start": 107.308, "end": 108.956}, {"text": "231 Dollar hoch", "start": 108.956, "end": 110.03}]}, {"id": "s26", "start": 110.03, "end": 116.606, "captions": [{"text": "Laut Bank", "start": 110.03, "end": 110.568}, {"text": "of America muss GTA 6", "start": 110.568, "end": 112.063}, {"text": "mindestens 1,9 Milliarden", "start": 112.063, "end": 113.557}, {"text": "Dollar einspielen,", "start": 113.557, "end": 114.633}, {"text": "nur um die Erwartungen", "start": 114.633, "end": 115.948}, {"text": "zu erfüllen", "start": 115.948, "end": 116.606}]}, {"id": "s27", "start": 116.606, "end": 121.623, "captions": [{"text": "An der Börse gibt es", "start": 116.606, "end": 117.801}, {"text": "dazu einen alten Spruch:", "start": 117.801, "end": 119.234}, {"text": "Kaufe das Gerücht,", "start": 119.234, "end": 120.309}, {"text": "verkaufe die Nachricht", "start": 120.309, "end": 121.623}]}, {"id": "s28", "start": 121.623, "end": 126.618, "captions": [{"text": "Heißt: Viele haben", "start": 121.623, "end": 122.656}, {"text": "schon vorher gekauft", "start": 122.656, "end": 123.805}, {"text": "und verkaufen genau dann,", "start": 123.805, "end": 125.24}, {"text": "wenn das Spiel erscheint", "start": 125.24, "end": 126.618}]}, {"id": "s29", "start": 126.618, "end": 130.88, "captions": [{"text": "Wer jetzt kauft,", "start": 126.618, "end": 127.571}, {"text": "wettet also nicht nur darauf,", "start": 127.571, "end": 129.299}, {"text": "dass GTA 6 ein Hit wird", "start": 129.299, "end": 130.88}]}, {"id": "s30", "start": 130.88, "end": 135.218, "captions": [{"text": "Sondern darauf,", "start": 130.88, "end": 131.788}, {"text": "dass es noch größer wird,", "start": 131.788, "end": 133.347}, {"text": "als alle ohnehin", "start": 133.347, "end": 134.345}, {"text": "schon erwarten", "start": 134.345, "end": 135.218}]}]}