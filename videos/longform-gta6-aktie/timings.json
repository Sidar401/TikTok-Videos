{"dauer": 140.36, "saetze": [{"id": "s1", "start": 0.0, "end": 6.276, "captions": [{"text": "In fünf Tagen erscheint", "start": 0.0, "end": 1.414}, {"text": "das meisterwartete", "start": 1.414, "end": 2.521}, {"text": "Videospiel aller Zeiten,", "start": 2.521, "end": 3.892}, {"text": "und die Aktie dahinter", "start": 3.892, "end": 5.12}, {"text": "könnte trotzdem fallen", "start": 5.12, "end": 6.276}]}, {"id": "s2", "start": 6.276, "end": 9.469, "captions": [{"text": "Es geht um GTA 6", "start": 6.276, "end": 7.772}, {"text": "und die Firma Take‑Two", "start": 7.772, "end": 9.469}]}, {"id": "s3", "start": 9.469, "end": 13.993, "captions": [{"text": "Folge HundeFinanzTv,", "start": 9.469, "end": 10.69}, {"text": "wir erklären dir jeden Tag", "start": 10.69, "end": 12.399}, {"text": "die wichtigsten Geld‑News", "start": 12.399, "end": 13.993}]}, {"id": "s4", "start": 13.993, "end": 17.802, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 13.993, "end": 15.364}, {"text": "keine Anlageberatung,", "start": 15.364, "end": 16.79}, {"text": "nur eine Erklärung", "start": 16.79, "end": 17.802}]}, {"id": "s5", "start": 17.802, "end": 20.53, "captions": [{"text": "Teil eins:", "start": 17.802, "end": 18.634}, {"text": "Die Firma hinter GTA", "start": 18.634, "end": 20.53}]}, {"id": "s6", "start": 20.53, "end": 25.074, "captions": [{"text": "GTA wird vom Studio", "start": 20.53, "end": 21.738}, {"text": "Rockstar Games gemacht,", "start": 21.738, "end": 23.371}, {"text": "und das gehört zu Take‑Two", "start": 23.371, "end": 25.074}]}, {"id": "s7", "start": 25.074, "end": 28.649, "captions": [{"text": "Die Firma ist an der Börse", "start": 25.074, "end": 26.71}, {"text": "rund 43 Milliarden Dollar wert", "start": 26.71, "end": 28.649}]}, {"id": "s8", "start": 28.649, "end": 34.532, "captions": [{"text": "Und jetzt kommt der Haken:", "start": 28.649, "end": 29.96}, {"text": "Im letzten Geschäftsjahr hat", "start": 29.96, "end": 31.662}, {"text": "Take‑Two fast 300 Millionen", "start": 31.662, "end": 33.32}, {"text": "Dollar Verlust gemacht", "start": 33.32, "end": 34.532}]}, {"id": "s9", "start": 34.532, "end": 38.359, "captions": [{"text": "Der ganze Wert hängt also", "start": 34.532, "end": 36.438}, {"text": "an einer Hoffnung: GTA 6", "start": 36.438, "end": 38.359}]}, {"id": "s10", "start": 38.359, "end": 39.93, "captions": [{"text": "Teil zwei: Die Rechnung", "start": 38.359, "end": 39.93}]}, {"id": "s11", "start": 39.93, "end": 45.769, "captions": [{"text": "Analysten erwarten", "start": 39.93, "end": 41.072}, {"text": "im ersten Geschäftsjahr", "start": 41.072, "end": 42.724}, {"text": "zwischen 35 und 55 Millionen", "start": 42.724, "end": 44.736}, {"text": "verkaufte Spiele", "start": 44.736, "end": 45.769}]}, {"id": "s12", "start": 45.769, "end": 51.65, "captions": [{"text": "Bei 50 Millionen Kopien", "start": 45.769, "end": 47.334}, {"text": "zu rund 90 Dollar wären", "start": 47.334, "end": 49.017}, {"text": "das etwa 4,5 Milliarden", "start": 49.017, "end": 50.699}, {"text": "Dollar Umsatz", "start": 50.699, "end": 51.65}]}, {"id": "s13", "start": 51.65, "end": 54.933, "captions": [{"text": "Das klingt riesig,", "start": 51.65, "end": 52.739}, {"text": "ist aber nur ein Zehntel", "start": 52.739, "end": 54.19}, {"text": "vom Börsenwert", "start": 54.19, "end": 54.933}]}, {"id": "s14", "start": 54.933, "end": 60.089, "captions": [{"text": "Die Anleger rechnen", "start": 54.933, "end": 56.083}, {"text": "also schon jetzt damit,", "start": 56.083, "end": 57.602}, {"text": "dass GTA 6 über", "start": 57.602, "end": 58.857}, {"text": "viele Jahre Geld bringt", "start": 58.857, "end": 60.089}]}, {"id": "s15", "start": 60.089, "end": 62.323, "captions": [{"text": "Teil drei: Was", "start": 60.089, "end": 60.884}, {"text": "die Geschichte zeigt", "start": 60.884, "end": 62.323}]}, {"id": "s16", "start": 62.323, "end": 66.718, "captions": [{"text": "GTA 5 hat am ersten", "start": 62.323, "end": 63.774}, {"text": "Tag über 800 Millionen", "start": 63.774, "end": 65.44}, {"text": "Dollar eingespielt", "start": 65.44, "end": 66.718}]}, {"id": "s17", "start": 66.718, "end": 71.76, "captions": [{"text": "Und die Aktie? Sie", "start": 66.718, "end": 67.836}, {"text": "stieg am Tag danach", "start": 67.836, "end": 69.311}, {"text": "nur um gut 1 %,", "start": 69.311, "end": 70.476}, {"text": "auf rund 17 Dollar", "start": 70.476, "end": 71.76}]}, {"id": "s18", "start": 71.76, "end": 78.912, "captions": [{"text": "Das große Geld", "start": 71.76, "end": 72.926}, {"text": "kam erst später: über", "start": 72.926, "end": 74.739}, {"text": "225 Millionen Exemplare", "start": 74.739, "end": 76.839}, {"text": "und jahrelang GTA Online", "start": 76.839, "end": 78.912}]}, {"id": "s19", "start": 78.912, "end": 82.323, "captions": [{"text": "Aus 17 Dollar wurden über", "start": 78.912, "end": 80.734}, {"text": "die Jahre mehr als 200", "start": 80.734, "end": 82.323}]}, {"id": "s20", "start": 82.323, "end": 90.236, "captions": [{"text": "Aber es geht auch", "start": 82.323, "end": 83.209}, {"text": "anders: Nach dem Rekordstart", "start": 83.209, "end": 84.75}, {"text": "von Red Dead Redemption", "start": 84.75, "end": 86.111}, {"text": "2 lag die Aktie", "start": 86.111, "end": 87.176}, {"text": "wenige Wochen später rund", "start": 87.176, "end": 88.655}, {"text": "ein Viertel unter ihrem Hoch", "start": 88.655, "end": 90.236}]}, {"id": "s21", "start": 90.236, "end": 96.707, "captions": [{"text": "Und bei Cyberpunk", "start": 90.236, "end": 91.112}, {"text": "verlor die Firma CD", "start": 91.112, "end": 92.175}, {"text": "Projekt nach dem verbuggten", "start": 92.175, "end": 93.685}, {"text": "Start im ersten Monat rund", "start": 93.685, "end": 95.14}, {"text": "die Hälfte ihres Börsenwerts", "start": 95.14, "end": 96.707}]}, {"id": "s22", "start": 96.707, "end": 100.856, "captions": [{"text": "Schreib uns", "start": 96.707, "end": 97.282}, {"text": "in die Kommentare: Kaufst", "start": 97.282, "end": 99.05}, {"text": "du GTA 6 am ersten Tag?", "start": 99.05, "end": 100.856}]}, {"id": "s23", "start": 100.856, "end": 103.258, "captions": [{"text": "Teil vier: Wo steht", "start": 100.856, "end": 102.107}, {"text": "die Aktie jetzt?", "start": 102.107, "end": 103.258}]}, {"id": "s24", "start": 103.258, "end": 109.235, "captions": [{"text": "Im Sommer lag Take‑Two", "start": 103.258, "end": 105.044}, {"text": "bei rund 266 Dollar,", "start": 105.044, "end": 106.85}, {"text": "Ende Oktober nur noch bei 190", "start": 106.85, "end": 109.235}]}, {"id": "s25", "start": 109.235, "end": 113.058, "captions": [{"text": "Vor ein paar Tagen", "start": 109.235, "end": 110.132}, {"text": "ging es wieder auf rund", "start": 110.132, "end": 111.903}, {"text": "231 Dollar hoch", "start": 111.903, "end": 113.058}]}, {"id": "s26", "start": 113.058, "end": 120.979, "captions": [{"text": "Laut Bank", "start": 113.058, "end": 113.466}, {"text": "of America muss GTA 6", "start": 113.466, "end": 115.137}, {"text": "mindestens 1,9 Milliarden", "start": 115.137, "end": 117.165}, {"text": "Dollar einspielen,", "start": 117.165, "end": 118.626}, {"text": "nur um die Erwartungen", "start": 118.626, "end": 120.411}, {"text": "zu erfüllen", "start": 120.411, "end": 120.979}]}, {"id": "s27", "start": 120.979, "end": 125.999, "captions": [{"text": "An der Börse gibt es", "start": 120.979, "end": 122.07}, {"text": "dazu einen alten Spruch:", "start": 122.07, "end": 123.454}, {"text": "Kaufe das Gerücht,", "start": 123.454, "end": 124.641}, {"text": "verkaufe die Nachricht", "start": 124.641, "end": 125.999}]}, {"id": "s28", "start": 125.999, "end": 130.995, "captions": [{"text": "Heißt: Viele haben", "start": 125.999, "end": 126.711}, {"text": "schon vorher gekauft", "start": 126.711, "end": 128.043}, {"text": "und verkaufen genau dann,", "start": 128.043, "end": 129.709}, {"text": "wenn das Spiel erscheint", "start": 129.709, "end": 130.995}]}, {"id": "s29", "start": 130.995, "end": 135.448, "captions": [{"text": "Wer jetzt kauft,", "start": 130.995, "end": 131.771}, {"text": "wettet also nicht nur darauf,", "start": 131.771, "end": 133.747}, {"text": "dass GTA 6 ein Hit wird", "start": 133.747, "end": 135.448}]}, {"id": "s30", "start": 135.448, "end": 139.762, "captions": [{"text": "Sondern darauf,", "start": 135.448, "end": 136.264}, {"text": "dass es noch größer wird,", "start": 136.264, "end": 137.854}, {"text": "als alle ohnehin", "start": 137.854, "end": 138.872}, {"text": "schon erwarten", "start": 138.872, "end": 139.762}]}]}