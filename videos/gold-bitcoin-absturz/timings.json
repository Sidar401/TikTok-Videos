{"dauer": 71.67, "saetze": [{"id": "s1", "start": 0.0, "end": 2.647, "captions": [{"text": "Gold und Bitcoin stürzen", "start": 0.0, "end": 1.381}, {"text": "gerade gleichzeitig ab", "start": 1.381, "end": 2.647}]}, {"id": "s2", "start": 2.647, "end": 8.806, "captions": [{"text": "Gold ist unter", "start": 2.647, "end": 3.544}, {"text": "3.900 Dollar gefallen,", "start": 3.544, "end": 5.318}, {"text": "Bitcoin war in der Nacht", "start": 5.318, "end": 7.14}, {"text": "kurz bei 62.000 Dollar", "start": 7.14, "end": 8.806}]}, {"id": "s3", "start": 8.806, "end": 13.057, "captions": [{"text": "Schreib uns in die Kommentare,", "start": 8.806, "end": 10.402}, {"text": "ob du jetzt eher Gold", "start": 10.402, "end": 11.595}, {"text": "oder Bitcoin kaufen würdest", "start": 11.595, "end": 13.057}]}, {"id": "s4", "start": 13.057, "end": 17.275, "captions": [{"text": "Folge HundeFinanzTv,", "start": 13.057, "end": 14.309}, {"text": "wir bringen dir jeden Tag", "start": 14.309, "end": 15.881}, {"text": "die wichtigsten Geld‑News", "start": 15.881, "end": 17.275}]}, {"id": "s5", "start": 17.275, "end": 21.563, "captions": [{"text": "Erst Gold: Im Januar", "start": 17.275, "end": 18.416}, {"text": "lag der Preis noch", "start": 18.416, "end": 19.893}, {"text": "bei fast 5.600 Dollar", "start": 19.893, "end": 21.563}]}, {"id": "s6", "start": 21.563, "end": 26.504, "captions": [{"text": "Jetzt sind es", "start": 21.563, "end": 22.748}, {"text": "rund 3.890 Dollar,", "start": 22.748, "end": 24.443}, {"text": "ein Minus von über 30 %", "start": 24.443, "end": 26.504}]}, {"id": "s7", "start": 26.504, "end": 30.391, "captions": [{"text": "Und Bitcoin: Der Rekord", "start": 26.504, "end": 28.132}, {"text": "lag bei rund 126.000 Dollar", "start": 28.132, "end": 30.391}]}, {"id": "s8", "start": 30.391, "end": 32.574, "captions": [{"text": "Jetzt ist er nur noch", "start": 30.391, "end": 31.473}, {"text": "etwa halb so viel wert", "start": 31.473, "end": 32.574}]}, {"id": "s9", "start": 32.574, "end": 35.884, "captions": [{"text": "Dabei gelten beide", "start": 32.574, "end": 33.43}, {"text": "für viele als Schutz,", "start": 33.43, "end": 34.539}, {"text": "wenn es an der Börse kracht", "start": 34.539, "end": 35.884}]}, {"id": "s10", "start": 35.884, "end": 37.765, "captions": [{"text": "Warum fallen sie", "start": 35.884, "end": 36.73}, {"text": "also gerade zusammen?", "start": 36.73, "end": 37.765}]}, {"id": "s11", "start": 37.765, "end": 42.369, "captions": [{"text": "Grund 1: In Amerika könnte", "start": 37.765, "end": 39.227}, {"text": "die Notenbank am 9.", "start": 39.227, "end": 40.734}, {"text": "Dezember die Zinsen erhöhen", "start": 40.734, "end": 42.369}]}, {"id": "s12", "start": 42.369, "end": 47.473, "captions": [{"text": "Dann bringen Sparbuch", "start": 42.369, "end": 43.669}, {"text": "und Anleihen wieder mehr,", "start": 43.669, "end": 45.139}, {"text": "Gold und Bitcoin", "start": 45.139, "end": 46.175}, {"text": "bringen gar keine Zinsen", "start": 46.175, "end": 47.473}]}, {"id": "s13", "start": 47.473, "end": 54.819, "captions": [{"text": "Grund 2: Große", "start": 47.473, "end": 48.403}, {"text": "Anleger ziehen Geld ab,", "start": 48.403, "end": 50.328}, {"text": "aus Bitcoin‑ETFs", "start": 50.328, "end": 51.552}, {"text": "fast 1,3 Milliarden", "start": 51.552, "end": 53.161}, {"text": "Dollar in einer Woche", "start": 53.161, "end": 54.819}]}, {"id": "s14", "start": 54.819, "end": 60.445, "captions": [{"text": "Manche", "start": 54.819, "end": 55.08}, {"text": "Experten vermuten sogar:", "start": 55.08, "end": 56.611}, {"text": "Anleger machen Geld frei", "start": 56.611, "end": 58.0}, {"text": "für den Anthropic‑Börsengang", "start": 58.0, "end": 59.786}, {"text": "am Donnerstag", "start": 59.786, "end": 60.445}]}, {"id": "s15", "start": 60.445, "end": 63.633, "captions": [{"text": "Merk dir: Auch ein sicherer", "start": 60.445, "end": 61.937}, {"text": "Hafen kann stark schwanken", "start": 61.937, "end": 63.633}]}, {"id": "s16", "start": 63.633, "end": 66.908, "captions": [{"text": "Wer lange denkt,", "start": 63.633, "end": 64.523}, {"text": "verteilt sein Geld", "start": 64.523, "end": 65.634}, {"text": "lieber auf mehrere Dinge", "start": 65.634, "end": 66.908}]}, {"id": "s17", "start": 66.908, "end": 71.067, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 66.908, "end": 68.277}, {"text": "keine Anlageberatung,", "start": 68.277, "end": 69.847}, {"text": "nur eine Erklärung", "start": 69.847, "end": 71.067}]}]}