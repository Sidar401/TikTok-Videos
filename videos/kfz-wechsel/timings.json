{
 "dauer": 48.646,
 "saetze": [
  {
   "id": "s1",
   "start": 0.0,
   "end": 3.055,
   "captions": [
    {
     "text": "Hast du deine Autoversicherung",
     "start": 0.0,
     "end": 1.629
    },
    {
     "text": "dieses Jahr schon verglichen?",
     "start": 1.629,
     "end": 3.055
    }
   ]
  },
  {
   "id": "s2",
   "start": 3.055,
   "end": 6.158,
   "captions": [
    {
     "text": "Dann solltest du dir",
     "start": 3.055,
     "end": 4.067
    },
    {
     "text": "jetzt den dreißigsten",
     "start": 4.067,
     "end": 5.287
    },
    {
     "text": "November merken",
     "start": 5.287,
     "end": 6.158
    }
   ]
  },
  {
   "id": "s3",
   "start": 6.158,
   "end": 9.843,
   "captions": [
    {
     "text": "Bei den meisten Verträgen ist",
     "start": 6.158,
     "end": 7.651
    },
    {
     "text": "das der Stichtag zum Kündigen",
     "start": 7.651,
     "end": 9.843
    }
   ]
  },
  {
   "id": "s4",
   "start": 9.843,
   "end": 14.933,
   "captions": [
    {
     "text": "Wer bis dahin kündigt,",
     "start": 9.843,
     "end": 11.23
    },
    {
     "text": "kann zum ersten Januar",
     "start": 11.23,
     "end": 12.646
    },
    {
     "text": "in einen günstigeren",
     "start": 12.646,
     "end": 13.997
    },
    {
     "text": "Tarif wechseln",
     "start": 13.997,
     "end": 14.933
    }
   ]
  },
  {
   "id": "s5",
   "start": 14.933,
   "end": 16.883,
   "captions": [
    {
     "text": "Und das lohnt sich oft richtig",
     "start": 14.933,
     "end": 16.883
    }
   ]
  },
  {
   "id": "s6",
   "start": 16.883,
   "end": 21.229,
   "captions": [
    {
     "text": "Ein Beispiel:",
     "start": 16.883,
     "end": 17.822
    },
    {
     "text": "Tom zahlt für sein",
     "start": 17.822,
     "end": 19.562
    },
    {
     "text": "Auto 780 € im Jahr",
     "start": 19.562,
     "end": 21.229
    }
   ]
  },
  {
   "id": "s7",
   "start": 21.229,
   "end": 25.21,
   "captions": [
    {
     "text": "Nach einem Vergleich findet er",
     "start": 21.229,
     "end": 23.244
    },
    {
     "text": "die gleiche Leistung für 520 €",
     "start": 23.244,
     "end": 25.21
    }
   ]
  },
  {
   "id": "s8",
   "start": 25.21,
   "end": 29.786,
   "captions": [
    {
     "text": "Das sind 260 € gespart,",
     "start": 25.21,
     "end": 27.239
    },
    {
     "text": "für eine halbe Stunde Arbeit",
     "start": 27.239,
     "end": 29.786
    }
   ]
  },
  {
   "id": "s9",
   "start": 29.786,
   "end": 34.013,
   "captions": [
    {
     "text": "Wichtig:",
     "start": 29.786,
     "end": 30.317
    },
    {
     "text": "Deinen Schadenfreiheitsrabatt",
     "start": 30.317,
     "end": 32.552
    },
    {
     "text": "nimmst du einfach mit",
     "start": 32.552,
     "end": 34.013
    }
   ]
  },
  {
   "id": "s10",
   "start": 34.013,
   "end": 38.66,
   "captions": [
    {
     "text": "Achte beim Vergleich",
     "start": 34.013,
     "end": 35.109
    },
    {
     "text": "auf die gleiche Leistung",
     "start": 35.109,
     "end": 36.684
    },
    {
     "text": "und gib deine Kilometer",
     "start": 36.684,
     "end": 38.194
    },
    {
     "text": "ehrlich an",
     "start": 38.194,
     "end": 38.66
    }
   ]
  },
  {
   "id": "s12",
   "start": 38.66,
   "end": 43.232,
   "captions": [
    {
     "text": "Wie viel zahlst du",
     "start": 38.66,
     "end": 39.643
    },
    {
     "text": "für deine Autoversicherung?",
     "start": 39.643,
     "end": 41.324
    },
    {
     "text": "Schreib es in die Kommentare",
     "start": 41.324,
     "end": 43.082
    }
   ]
  },
  {
