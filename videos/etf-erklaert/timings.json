{
  "dauer": 48.81,
  "saetze": [
    {
      "id": "s1",
      "start": 0.0,
      "end": 3.441,
      "captions": [
        {
          "text": "alle reden von ETFs,",
          "start": 0.0,
          "end": 1.434
        },
        {
          "text": "aber was ist das eigentlich?",
          "start": 1.434,
          "end": 3.441
        }
      ]
    },
    {
      "id": "s2",
      "start": 3.441,
      "end": 5.344,
      "captions": [
        {
          "text": "stell dir",
          "start": 3.441,
          "end": 3.993
        },
        {
          "text": "einen Einkaufskorb vor",
          "start": 3.993,
          "end": 5.344
        }
      ]
    },
    {
      "id": "s3",
      "start": 5.344,
      "end": 9.661,
      "captions": [
        {
          "text": "statt einzelne",
          "start": 5.344,
          "end": 6.269
        },
        {
          "text": "Aktien zu kaufen,",
          "start": 6.269,
          "end": 7.392
        },
        {
          "text": "kaufst du den ganzen",
          "start": 7.392,
          "end": 8.713
        },
        {
          "text": "Korb auf einmal",
          "start": 8.713,
          "end": 9.661
        }
      ]
    },
    {
      "id": "s4",
      "start": 9.661,
      "end": 15.274,
      "captions": [
        {
          "text": "mit einem weltweiten",
          "start": 9.661,
          "end": 10.992
        },
        {
          "text": "ETF steckst du dein Geld",
          "start": 10.992,
          "end": 12.64
        },
        {
          "text": "in über tausend",
          "start": 12.64,
          "end": 13.67
        },
        {
          "text": "Unternehmen gleichzeitig",
          "start": 13.67,
          "end": 15.274
        }
      ]
    },
    {
      "id": "s5",
      "start": 15.274,
      "end": 18.818,
      "captions": [
        {
          "text": "darunter Firmen wie Apple,",
          "start": 15.274,
          "end": 17.313
        },
        {
          "text": "Microsoft oder Nestlé",
          "start": 17.313,
          "end": 18.818
        }
      ]
    },
    {
      "id": "s6",
      "start": 18.818,
      "end": 22.059,
      "captions": [
        {
          "text": "geht es einer Firma schlecht,",
          "start": 18.818,
          "end": 20.467
        },
        {
          "text": "fällt das kaum ins Gewicht",
          "start": 20.467,
          "end": 22.059
        }
      ]
    },
    {
      "id": "s7",
      "start": 22.059,
      "end": 26.316,
      "captions": [
        {
          "text": "das nennt man Streuung,",
          "start": 22.059,
          "end": 23.771
        },
        {
          "text": "und genau das macht",
          "start": 23.771,
          "end": 25.223
        },
        {
          "text": "ETFs so beliebt",
          "start": 25.223,
          "end": 26.316
        }
      ]
    },
    {
      "id": "s8",
      "start": 26.316,
      "end": 30.938,
      "captions": [
        {
          "text": "dazu sind sie günstig,",
          "start": 26.316,
          "end": 27.732
        },
        {
          "text": "viele kosten nur ein paar",
          "start": 27.732,
          "end": 29.401
        },
        {
          "text": "Zehntel Prozent im Jahr",
          "start": 29.401,
          "end": 30.938
        }
      ]
    },
    {
      "id": "s9",
      "start": 30.938,
      "end": 34.823,
      "captions": [
        {
          "text": "und du kannst schon",
          "start": 30.938,
          "end": 32.093
        },
        {
          "text": "mit wenigen Euro im Monat",
          "start": 32.093,
          "end": 33.613
        },
        {
          "text": "per Sparplan starten",
          "start": 33.613,
          "end": 34.823
        }
      ]
    },
    {
      "id": "s10",
      "start": 34.823,
      "end": 39.008,
      "captions": [
        {
          "text": "aber Achtung, Kurse schwanken,",
          "start": 34.823,
          "end": 36.694
        },
        {
          "text": "deshalb solltest du",
          "start": 36.694,
          "end": 37.882
        },
        {
          "text": "langfristig denken",
          "start": 37.882,
          "end": 39.008
        }
      ]
    },
    {
      "id": "s11",
      "start": 39.008,
      "end": 41.157,
      "captions": [
        {
          "text": "hast du schon einen ETF?",
          "start": 39.008,
          "end": 41.157
        }
      ]
    },
    {
      "id": "s12",
      "start": 41.157,
      "end": 43.715,
      "captions": [
        {
          "text": "schreib uns ja oder nein",
          "start": 41.157,
          "end": 42.609
        },
        {
          "text": "in die Kommentare!",
          "start": 42.609,
          "end": 43.715
        }
      ]
    },
    {
      "id": "s13",
      "start": 43.715,
      "end": 48.204,
      "captions": [
        {
          "text": "folge HundeFinanzTV,",
          "start": 43.715,
          "end": 45.263
        },
        {
          "text": "wir erklären dir",
          "start": 45.263,
          "end": 46.501
        },
        {
          "text": "Finanzen ganz einfach!",
          "start": 46.501,
          "end": 48.204
        }
      ]
    }
  ]
}