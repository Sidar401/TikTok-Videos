          "text": "will an die Nasdaq",
          "start": 6.925,
          "end": 7.949
        }
      ]
    },
    {
      "id": "s3",
      "start": 7.949,
      "end": 11.447,
      "captions": [
        {
          "text": "Kurzer Hinweis: Das ist",
          "start": 7.949,
          "end": 9.243
        },
        {
          "text": "keine Anlageberatung,",
          "start": 9.243,
          "end": 10.43
        },
        {
          "text": "nur eine Erklärung",
          "start": 10.43,
