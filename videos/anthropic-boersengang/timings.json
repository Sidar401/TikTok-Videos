      "start": 58.807,
      "end": 62.45,
      "captions": [
        {
          "text": "Im echten Geschäft",
          "start": 58.807,
          "end": 59.9
        },
        {
          "text": "lag der Verlust nur",
          "start": 59.9,
          "end": 61.054
        },
        {
          "text": "bei rund 1,3 Milliarden",
          "start": 61.054,
          "end": 62.45
        }
      ]
    },
