      "end": 4.359,
      "captions": [
        {
          "text": "Der größte Börsengang aller",
          "start": 0.0,
          "end": 1.731
        },
        {
          "text": "Zeiten steht kurz bevor,",
          "start": 1.731,
          "end": 3.269
        },
        {
          "text": "und es geht um KI",
          "start": 3.269,
          "end": 4.359
        }
      ]
    },
    {
      "id": "s2",
      "start": 4.359,
      "end": 7.949,
      "captions": [
        {
          "text": "Anthropic,",
          "start": 4.359,
          "end": 4.929
        },
        {
          "text": "die Firma hinter",
          "start": 4.929,
          "end": 5.842
        },
        {
          "text": "dem Chatbot Claude,",
          "start": 5.842,
          "end": 6.925
        },
