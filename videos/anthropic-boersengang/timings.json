          "text": "2025 hat Anthropic",
          "start": 36.411,
          "end": 37.601
        },
        {
          "text": "rund 2,5 Milliarden",
          "start": 37.601,
          "end": 38.857
        },
        {
          "text": "Dollar umgesetzt",
          "start": 38.857,
          "end": 39.914
        }
      ]
    },
    {
      "id": "s10",
      "start": 39.914,
      "end": 44.932,
      "captions": [
        {
          "text": "Im gleichen Zeitraum",
          "start": 39.914,
          "end": 41.123
        },
        {
          "text": "dieses Jahr waren es",
          "start": 41.123,
          "end": 42.332
        },
        {
          "text": "über 33 Milliarden,",
          "start": 42.332,
          "end": 43.481
        },
        {
          "text": "also rund 13‑mal so viel",
          "start": 43.481,
          "end": 44.932
        }
      ]
    },
    {
      "id": "s11",
      "start": 44.932,
      "end": 48.379,
      "captions": [
        {
          "text": "Aber unterm",
          "start": 44.932,
          "end": 45.564
        },
        {
          "text": "Strich steht ein Verlust",
          "start": 45.564,
          "end": 46.943
        },
        {
          "text": "von 104 Milliarden Dollar",
          "start": 46.943,
          "end": 48.379
        }
      ]
    },
    {
      "id": "s12",
      "start": 48.379,
      "end": 53.415,
      "captions": [
        {
          "text": "Der Großteil davon,",
          "start": 48.379,
          "end": 49.546
        },
        {
          "text": "über 94 Milliarden,",
          "start": 49.546,
          "end": 50.713
        },
        {
          "text": "ist allerdings nur",
          "start": 50.713,
          "end": 51.818
        },
        {
          "text": "ein Verlust auf dem Papier",
          "start": 51.818,
          "end": 53.415
        }
      ]
    },
    {
      "id": "s13",
      "start": 53.415,
      "end": 58.815,
      "captions": [
        {
          "text": "Denn Anleihen,",
          "start": 53.415,
          "end": 54.142
        },
        {
          "text": "die später in Aktien",
          "start": 54.142,
          "end": 55.18
        },
        {
          "text": "getauscht werden,",
          "start": 55.18,
          "end": 56.063
        },
        {
          "text": "sind durch den hohen",
          "start": 56.063,
          "end": 57.102
        },
        {
          "text": "Firmenwert viel",
          "start": 57.102,
          "end": 57.88
        },
        {
          "text": "mehr wert geworden",
          "start": 57.88,
          "end": 58.815
        }
      ]
    },
    {
      "id": "s14",
      "start": 58.815,
      "end": 62.454,
      "captions": [
        {
          "text": "Im echten Geschäft",
          "start": 58.815,
          "end": 59.907
        },
        {
          "text": "lag der Verlust nur",
          "start": 59.907,
          "end": 61.059
        },
        {
          "text": "bei rund 1,3 Milliarden",
          "start": 61.059,
          "end": 62.454
        }
      ]
    },
    {
      "id": "s15",
      "start": 62.454,
      "end": 68.271,
      "captions": [
        {
          "text": "Und das Geld fließt",
          "start": 62.454,
          "end": 63.487
        },
        {
          "text": "weiter: Fast 900 Milliarden",
          "start": 63.487,
          "end": 64.955
        },
        {
          "text": "Dollar hat Anthropic",
          "start": 64.955,
          "end": 66.042
        },
        {
          "text": "schon für Rechenzentren",
          "start": 66.042,
          "end": 67.292
        },
        {
          "text": "und Chips zugesagt",
          "start": 67.292,
          "end": 68.271
        }
      ]
    },
    {
      "id": "s16",
      "start": 68.271,
      "end": 74.094,
      "captions": [
        {
          "text": "Warum dieses Geld im Kreis",
          "start": 68.271,
          "end": 69.611
        },
        {
          "text": "zwischen den KI‑Firmen fließt,",
          "start": 69.611,
          "end": 71.157
        },
        {
          "text": "zeigen wir dir in einem ganzen",
          "start": 71.157,
          "end": 72.703
        },
        {
          "text": "Video bei uns auf dem Kanal",
          "start": 72.703,
          "end": 74.094
        }
      ]
    }
  ]
