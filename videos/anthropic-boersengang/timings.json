{
  "dauer": 74.69,
  "saetze": [
    {
      "id": "s1",
      "start": 0.0,
      "end": 4.364,
      "captions": [
        {
          "text": "Der größte Börsengang aller",
          "start": 0.0,
          "end": 1.733
        },
        {
          "text": "Zeiten steht kurz bevor,",
          "start": 1.733,
          "end": 3.273
        },
        {
          "text": "und es geht um KI",
          "start": 3.273,
          "end": 4.364
        }
      ]
    },
    {
      "id": "s2",
      "start": 4.364,
      "end": 7.62,
      "captions": [
        {
          "text": "Anthropic,",
          "start": 4.364,
          "end": 4.881
        },
        {
          "text": "die Firma hinter",
          "start": 4.881,
          "end": 5.708
        },
        {
          "text": "dem Chatbot Claude,",
          "start": 5.708,
          "end": 6.69
        },
        {
          "text": "will an die Nasdaq",
          "start": 6.69,
          "end": 7.62
        }
      ]
    },
    {
      "id": "s3",
      "start": 7.62,
      "end": 11.448,
      "captions": [
        {
          "text": "Kurzer Hinweis: Das ist",
          "start": 7.62,
          "end": 9.04
        },
        {
          "text": "keine Anlageberatung,",
          "start": 9.04,
          "end": 10.337
        },
        {
          "text": "nur eine Erklärung",
          "start": 10.337,
          "end": 11.448
        }
      ]
    },
    {
      "id": "s4",
      "start": 11.448,
      "end": 14.477,
      "captions": [
        {
          "text": "Eine Aktie soll zwischen",
          "start": 11.448,
          "end": 12.995
        },
        {
          "text": "70 und 78 Dollar kosten",
          "start": 12.995,
          "end": 14.477
        }
      ]
    },
    {
      "id": "s5",
      "start": 14.477,
      "end": 19.025,
      "captions": [
        {
          "text": "Verkauft werden",
          "start": 14.477,
          "end": 15.653
        },
        {
          "text": "825 Millionen Aktien,",
          "start": 15.653,
          "end": 17.3
        },
        {
          "text": "unter dem Kürzel „ANT“",
          "start": 17.3,
          "end": 19.025
        }
      ]
    },
    {
      "id": "s6",
      "start": 19.025,
      "end": 27.586,
      "captions": [
        {
          "text": "Dazu kaufen Google,",
          "start": 19.025,
          "end": 20.574
        },
        {
          "text": "Nvidia, Microsoft, AMD,",
          "start": 20.574,
          "end": 22.449
        },
        {
          "text": "Broadcom,",
          "start": 22.449,
          "end": 23.183
        },
        {
          "text": "Micron",
          "start": 23.183,
          "end": 23.672
        },
        {
          "text": "und TSMC zusammen Aktien",
          "start": 23.672,
          "end": 25.629
        },
        {
          "text": "für 26 Milliarden Dollar",
          "start": 25.629,
          "end": 27.586
        }
      ]
    },
    {
      "id": "s7",
      "start": 27.586,
      "end": 30.81,
      "captions": [
        {
          "text": "Damit wäre Anthropic bis",
          "start": 27.586,
          "end": 29.074
        },
        {
          "text": "zu 1,4 Billionen Dollar wert",
          "start": 29.074,
          "end": 30.81
        }
      ]
    },
    {
      "id": "s8",
      "start": 30.81,
      "end": 33.371,
      "captions": [
        {
          "text": "Schick das jemandem,",
          "start": 30.81,
          "end": 31.923
        },
        {
          "text": "der gerade KI‑Aktien kauft",
          "start": 31.923,
          "end": 33.371
        }
      ]
    },
    {
      "id": "s9",
      "start": 33.371,
      "end": 39.914,
      "captions": [
        {
          "text": "Jetzt wird es spannend:",
          "start": 33.371,
          "end": 34.891
        },
        {
          "text": "In den ersten 9 Monaten",
          "start": 34.891,
          "end": 36.411
        },
