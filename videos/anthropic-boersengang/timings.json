      "start": 53.408,
      "end": 58.807,
      "captions": [
        {
          "text": "Denn Anleihen,",
          "start": 53.408,
          "end": 54.133
        },
        {
          "text": "die später in Aktien",
          "start": 54.133,
          "end": 55.172
        },
        {
          "text": "getauscht werden,",
          "start": 55.172,
          "end": 56.055
        },
        {
          "text": "sind durch den hohen",
          "start": 56.055,
          "end": 57.094
        },
        {
          "text": "Firmenwert viel",
          "start": 57.094,
          "end": 57.873
        },
        {
          "text": "mehr wert geworden",
          "start": 57.873,
          "end": 58.807
        }
      ]
    },
    {
