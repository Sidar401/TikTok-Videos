{"dauer": 156.82, "saetze": [{"id": "s1", "start": 0.0, "end": 6.013, "captions": [{"text": "Die Inflation ist", "start": 0.0, "end": 1.273}, {"text": "auf 2,8 % gefallen,", "start": 1.273, "end": 2.696}, {"text": "aber im Supermarkt", "start": 2.696, "end": 3.969}, {"text": "merkst du davon nichts,", "start": 3.969, "end": 5.692}, {"text": "oder?", "start": 5.692, "end": 6.013}]}, {"id": "s2", "start": 6.013, "end": 10.192, "captions": [{"text": "Und das hat einen Grund,", "start": 6.013, "end": 7.57}, {"text": "der dich ab Januar", "start": 7.57, "end": 8.778}, {"text": "richtig treffen könnte", "start": 8.778, "end": 10.192}]}, {"id": "s3", "start": 10.192, "end": 14.17, "captions": [{"text": "Schreib uns in die Kommentare,", "start": 10.192, "end": 12.05}, {"text": "ob bei dir gerade", "start": 12.05, "end": 13.14}, {"text": "alles teurer wird", "start": 13.14, "end": 14.17}]}, {"id": "s4", "start": 14.17, "end": 18.532, "captions": [{"text": "Folge HundeFinanzTv,", "start": 14.17, "end": 15.375}, {"text": "wir bringen dir jeden Tag", "start": 15.375, "end": 16.953}, {"text": "die wichtigsten Geld‑News", "start": 16.953, "end": 18.532}]}, {"id": "s5", "start": 18.532, "end": 26.512, "captions": [{"text": "Erst die Zahl: Laut", "start": 18.532, "end": 19.568}, {"text": "Statistischem Bundesamt waren", "start": 19.568, "end": 21.903}, {"text": "die Preise im Oktober 2,8 %", "start": 21.903, "end": 24.353}, {"text": "höher als vor einem Jahr", "start": 24.353, "end": 26.512}]}, {"id": "s6", "start": 26.512, "end": 29.718, "captions": [{"text": "Im September waren", "start": 26.512, "end": 28.42}, {"text": "es noch 3,3 %", "start": 28.42, "end": 29.718}]}, {"id": "s7", "start": 29.718, "end": 32.269, "captions": [{"text": "Klingt also erst mal", "start": 29.718, "end": 30.821}, {"text": "nach einer guten Nachricht", "start": 30.821, "end": 32.269}]}, {"id": "s8", "start": 32.269, "end": 36.764, "captions": [{"text": "Aber: Die Preise", "start": 32.269, "end": 33.365}, {"text": "steigen trotzdem weiter,", "start": 33.365, "end": 35.312}, {"text": "nur etwas langsamer", "start": 35.312, "end": 36.764}]}, {"id": "s9", "start": 36.764, "end": 39.704, "captions": [{"text": "Inflation heißt nie,", "start": 36.764, "end": 38.088}, {"text": "dass etwas billiger wird", "start": 38.088, "end": 39.704}]}, {"id": "s10", "start": 39.704, "end": 46.027, "captions": [{"text": "Und der größte Preistreiber", "start": 39.704, "end": 41.917}, {"text": "bleibt Energie: plus 12,2 %", "start": 41.917, "end": 44.045}, {"text": "im Vergleich zum Vorjahr", "start": 44.045, "end": 46.027}]}, {"id": "s11", "start": 46.027, "end": 50.51, "captions": [{"text": "Der Grund ist der Iran‑Krieg,", "start": 46.027, "end": 47.938}, {"text": "der seit Februar Öl", "start": 47.938, "end": 49.224}, {"text": "und Gas teuer macht", "start": 49.224, "end": 50.51}]}, {"id": "s12", "start": 50.51, "end": 53.804, "captions": [{"text": "Warum ist die Inflation", "start": 50.51, "end": 52.063}, {"text": "dann trotzdem gefallen?", "start": 52.063, "end": 53.804}]}, {"id": "s13", "start": 53.804, "end": 55.385, "captions": [{"text": "Wegen des neuen Tankrabatts", "start": 53.804, "end": 55.385}]}, {"id": "s14", "start": 55.385, "end": 63.631, "captions": [{"text": "Seit dem 1. Oktober", "start": 55.385, "end": 57.125}, {"text": "ist die Steuer auf Benzin", "start": 57.125, "end": 59.017}, {"text": "und Diesel gesenkt,", "start": 59.017, "end": 60.387}, {"text": "mit Mehrwertsteuer um", "start": 60.387, "end": 61.976}, {"text": "rund 16,7 Cent pro Liter", "start": 61.976, "end": 63.631}]}, {"id": "s15", "start": 63.631, "end": 68.37, "captions": [{"text": "Das drückt die Inflation,", "start": 63.631, "end": 65.172}, {"text": "sagt sogar die Chefin", "start": 65.172, "end": 66.6}, {"text": "des Statistischen Bundesamts", "start": 66.6, "end": 68.37}]}, {"id": "s16", "start": 68.37, "end": 72.818, "captions": [{"text": "Aber: Der Tankrabatt gilt", "start": 68.37, "end": 69.985}, {"text": "nur bis zum 31.", "start": 69.985, "end": 72.296}, {"text": "Dezember", "start": 72.296, "end": 72.818}]}, {"id": "s17", "start": 72.818, "end": 75.365, "captions": [{"text": "Eine Verlängerung ist", "start": 72.818, "end": 74.009}, {"text": "bisher nicht beschlossen", "start": 74.009, "end": 75.365}]}, {"id": "s18", "start": 75.365, "end": 81.211, "captions": [{"text": "Ab Januar könnte", "start": 75.365, "end": 76.311}, {"text": "der Liter also wieder", "start": 76.311, "end": 77.73}, {"text": "deutlich teurer werden,", "start": 77.73, "end": 79.263}, {"text": "und die Inflation", "start": 79.263, "end": 80.411}, {"text": "wieder steigen", "start": 80.411, "end": 81.211}]}, {"id": "s19", "start": 81.211, "end": 88.655, "captions": [{"text": "Ein Beispiel: Wer", "start": 81.211, "end": 82.48}, {"text": "50 Liter im Monat tankt,", "start": 82.48, "end": 84.78}, {"text": "zahlt dann rund 8 € mehr,", "start": 84.78, "end": 87.081}, {"text": "im Jahr rund 100 €", "start": 87.081, "end": 88.655}]}, {"id": "s20", "start": 88.655, "end": 91.168, "captions": [{"text": "Und es gibt noch", "start": 88.655, "end": 89.648}, {"text": "einen Trick in der Zahl", "start": 89.648, "end": 91.168}]}, {"id": "s21", "start": 91.168, "end": 95.027, "captions": [{"text": "Die 2,8 % sind", "start": 91.168, "end": 92.435}, {"text": "ein Durchschnitt über alles", "start": 92.435, "end": 95.027}]}, {"id": "s22", "start": 95.027, "end": 100.882, "captions": [{"text": "Manche Dinge werden", "start": 95.027, "end": 96.272}, {"text": "sogar billiger,", "start": 96.272, "end": 97.231}, {"text": "Butter zum Beispiel fast", "start": 97.231, "end": 98.928}, {"text": "19 % im Vergleich zum Vorjahr", "start": 98.928, "end": 100.882}]}, {"id": "s23", "start": 100.882, "end": 105.579, "captions": [{"text": "Dafür ist Energie viel teurer,", "start": 100.882, "end": 103.293}, {"text": "und die bezahlst du jeden Tag", "start": 103.293, "end": 105.579}]}, {"id": "s24", "start": 105.579, "end": 109.752, "captions": [{"text": "Deshalb fühlt", "start": 105.579, "end": 106.415}, {"text": "sich deine persönliche", "start": 106.415, "end": 107.993}, {"text": "Inflation oft viel höher an", "start": 107.993, "end": 109.752}]}, {"id": "s25", "start": 109.752, "end": 111.416, "captions": [{"text": "Was heißt das für dein Geld?", "start": 109.752, "end": 111.416}]}, {"id": "s26", "start": 111.416, "end": 116.88, "captions": [{"text": "Liegt dein Erspartes ohne", "start": 111.416, "end": 113.031}, {"text": "Zinsen auf dem Girokonto,", "start": 113.031, "end": 114.843}, {"text": "verliert es jedes Jahr an Wert", "start": 114.843, "end": 116.88}]}, {"id": "s27", "start": 116.88, "end": 124.216, "captions": [{"text": "Bei 10.000 €", "start": 116.88, "end": 118.204}, {"text": "sind das bei 2,8 % rund", "start": 118.204, "end": 121.007}, {"text": "280 € Kaufkraft in einem Jahr", "start": 121.007, "end": 124.216}]}, {"id": "s28", "start": 124.216, "end": 130.688, "captions": [{"text": "3 Tipps: Erstens,", "start": 124.216, "end": 125.309}, {"text": "schau,", "start": 125.309, "end": 125.819}, {"text": "ob dein Tagesgeld", "start": 125.819, "end": 127.052}, {"text": "wenigstens einen Teil", "start": 127.052, "end": 128.834}, {"text": "der Inflation ausgleicht", "start": 128.834, "end": 130.688}]}, {"id": "s29", "start": 130.688, "end": 136.073, "captions": [{"text": "Zweitens,", "start": 130.688, "end": 131.125}, {"text": "tank im Dezember lieber", "start": 131.125, "end": 132.55}, {"text": "noch einmal voll,", "start": 132.55, "end": 133.722}, {"text": "falls der Rabatt", "start": 133.722, "end": 134.824}, {"text": "nicht verlängert wird", "start": 134.824, "end": 136.073}]}, {"id": "s30", "start": 136.073, "end": 142.187, "captions": [{"text": "Drittens,", "start": 136.073, "end": 136.526}, {"text": "vergleich deinen Strom‑", "start": 136.526, "end": 138.071}, {"text": "und Gastarif,", "start": 138.071, "end": 139.013}, {"text": "denn genau dort steigen", "start": 139.013, "end": 140.678}, {"text": "die Preise am stärksten", "start": 140.678, "end": 142.187}]}, {"id": "s31", "start": 142.187, "end": 147.332, "captions": [{"text": "Und für Geld,", "start": 142.187, "end": 142.892}, {"text": "das du lange nicht brauchst,", "start": 142.892, "end": 144.748}, {"text": "nutzen viele einen breit", "start": 144.748, "end": 146.339}, {"text": "gestreuten Sparplan", "start": 146.339, "end": 147.332}]}, {"id": "s32", "start": 147.332, "end": 151.506, "captions": [{"text": "Merk dir: Sinkende Inflation", "start": 147.332, "end": 149.236}, {"text": "heißt nicht sinkende Preise", "start": 149.236, "end": 151.506}]}, {"id": "s33", "start": 151.506, "end": 156.228, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 151.506, "end": 152.846}, {"text": "keine Anlageberatung,", "start": 152.846, "end": 154.633}, {"text": "nur eine Erklärung", "start": 154.633, "end": 156.228}]}]}