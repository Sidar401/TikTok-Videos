   "start": 36.729,
   "end": 42.474,
   "captions": [
    {
     "text": "Im Juni 2020 dann der Knall:",
     "start": 36.729,
     "end": 39.191
    },
    {
     "text": "Die 1,9 Milliarden",
     "start": 39.191,
     "end": 40.724
    },
