     "text": "Und ein Bonus für alle,",
     "start": 119.825,
     "end": 121.03
    },
    {
     "text": "die im Rentenalter",
     "start": 121.03,
     "end": 122.091
    },
    {
     "text": "noch arbeiten wollen:",
     "start": 122.091,
     "end": 123.13
    },
    {
     "text": "Mit der Aktivrente bleiben bis",
     "start": 123.13,
     "end": 124.897
    },
    {
     "text": "zu 2.000 € im Monat steuerfrei",
     "start": 124.897,
     "end": 126.651
    }
   ]
  },
  {
   "id": "s35",
   "start": 126.651,
   "end": 131.962,
   "captions": [
    {
     "text": "Unterm Strich: Wer",
     "start": 126.651,
     "end": 127.597
    },
    {
     "text": "wenig verdient,",
     "start": 127.597,
     "end": 128.54
    },
    {
     "text": "Kinder hat oder in Rente ist,",
     "start": 128.54,
     "end": 130.363
    },
    {
     "text": "gehört eher zu den Gewinnern",
     "start": 130.363,
     "end": 131.962
    }
   ]
  },
  {
   "id": "s36",
   "start": 131.962,
   "end": 134.336,
   "captions": [
    {
     "text": "Pendler und Gutverdiener",
     "start": 131.962,
     "end": 133.344
    },
    {
     "text": "zahlen eher drauf",
     "start": 133.344,
     "end": 134.336
    }
   ]
  },
  {
   "id": "s37",
   "start": 134.336,
   "end": 141.266,
   "captions": [
    {
     "text": "Und egal,",
     "start": 134.336,
     "end": 134.802
    },
    {
     "text": "wo du stehst: Wer",
     "start": 134.802,
     "end": 135.812
    },
    {
     "text": "die Änderungen kennt,",
     "start": 135.812,
     "end": 136.909
    },
    {
     "text": "kann früh reagieren,",
     "start": 136.909,
     "end": 138.097
    },
    {
     "text": "zum Beispiel",
     "start": 138.097,
     "end": 138.712
    },
    {
     "text": "mit einem Kassenwechsel",
     "start": 138.712,
     "end": 140.078
    },
    {
     "text": "oder einem Jobticket",
     "start": 140.078,
     "end": 141.266
    }
   ]
  }
 ]
