{"dauer": 62.98, "saetze": [{"id": "s1", "start": 0.0, "end": 4.793, "captions": [{"text": "Ab Freitag können", "start": 0.0, "end": 1.131}, {"text": "Klarna und PayPal", "start": 1.131, "end": 2.261}, {"text": "beim „Später bezahlen“", "start": 2.261, "end": 3.592}, {"text": "plötzlich Nein sagen", "start": 3.592, "end": 4.793}]}, {"id": "s2", "start": 4.793, "end": 10.238, "captions": [{"text": "Am 20. November", "start": 4.793, "end": 6.137}, {"text": "gelten in Deutschland", "start": 6.137, "end": 7.481}, {"text": "neue Regeln für Ratenkauf", "start": 7.481, "end": 9.081}, {"text": "und Kauf auf Rechnung", "start": 9.081, "end": 10.238}]}, {"id": "s3", "start": 10.238, "end": 14.693, "captions": [{"text": "Folge HundeFinanzTv,", "start": 10.238, "end": 11.447}, {"text": "wir bringen dir jeden Tag", "start": 11.447, "end": 13.134}, {"text": "die wichtigsten Geld‑News", "start": 13.134, "end": 14.693}]}, {"id": "s4", "start": 14.693, "end": 18.819, "captions": [{"text": "Bisher reichte oft ein Klick,", "start": 14.693, "end": 16.204}, {"text": "und schon war die Zahlung", "start": 16.204, "end": 17.667}, {"text": "auf später verschoben", "start": 17.667, "end": 18.819}]}, {"id": "s5", "start": 18.819, "end": 22.848, "captions": [{"text": "Jetzt muss der Anbieter", "start": 18.819, "end": 20.03}, {"text": "vorher prüfen,", "start": 20.03, "end": 20.814}, {"text": "ob du dir das überhaupt", "start": 20.814, "end": 22.101}, {"text": "leisten kannst", "start": 22.101, "end": 22.848}]}, {"id": "s6", "start": 22.848, "end": 27.838, "captions": [{"text": "Das gilt auch für kleine", "start": 22.848, "end": 24.617}, {"text": "Beträge unter 200 €", "start": 24.617, "end": 26.046}, {"text": "und für zinslose Angebote", "start": 26.046, "end": 27.838}]}, {"id": "s7", "start": 27.838, "end": 31.407, "captions": [{"text": "Der Grund ist", "start": 27.838, "end": 28.65}, {"text": "eine neue EU-Regel", "start": 28.65, "end": 29.966}, {"text": "für Verbraucherkredite", "start": 29.966, "end": 31.407}]}, {"id": "s8", "start": 31.407, "end": 35.423, "captions": [{"text": "Denn später bezahlen ist", "start": 31.407, "end": 32.782}, {"text": "am Ende nichts anderes", "start": 32.782, "end": 34.12}, {"text": "als ein kleiner Kredit", "start": 34.12, "end": 35.423}]}, {"id": "s9", "start": 35.423, "end": 39.097, "captions": [{"text": "Viele verlieren", "start": 35.423, "end": 36.309}, {"text": "damit den Überblick,", "start": 36.309, "end": 37.535}, {"text": "und dann kommen Mahngebühren", "start": 37.535, "end": 39.097}]}, {"id": "s10", "start": 39.097, "end": 41.714, "captions": [{"text": "Die gute Nachricht: Du", "start": 39.097, "end": 40.399}, {"text": "bekommst mehr Rechte", "start": 40.399, "end": 41.714}]}, {"id": "s11", "start": 41.714, "end": 45.406, "captions": [{"text": "Du kannst so einen Kauf", "start": 41.714, "end": 43.227}, {"text": "auf später", "start": 43.227, "end": 43.902}, {"text": "14 Tage lang widerrufen", "start": 43.902, "end": 45.406}]}, {"id": "s12", "start": 45.406, "end": 49.209, "captions": [{"text": "Und wirst du abgelehnt,", "start": 45.406, "end": 46.644}, {"text": "muss der Anbieter", "start": 46.644, "end": 47.593}, {"text": "das nachvollziehbar begründen", "start": 47.593, "end": 49.209}]}, {"id": "s13", "start": 49.209, "end": 52.351, "captions": [{"text": "Wichtig: Eine Woche später", "start": 49.209, "end": 50.848}, {"text": "ist schon Black Friday", "start": 50.848, "end": 52.351}]}, {"id": "s14", "start": 52.351, "end": 55.348, "captions": [{"text": "Wer dann auf Rechnung", "start": 52.351, "end": 53.521}, {"text": "kaufen will,", "start": 53.521, "end": 54.248}, {"text": "kann abgelehnt werden", "start": 54.248, "end": 55.348}]}, {"id": "s15", "start": 55.348, "end": 58.89, "captions": [{"text": "Unser Tipp: Kauf nur,", "start": 55.348, "end": 56.485}, {"text": "was du heute schon", "start": 56.485, "end": 57.797}, {"text": "bezahlen könntest", "start": 57.797, "end": 58.89}]}, {"id": "s16", "start": 58.89, "end": 62.373, "captions": [{"text": "Ein ganzes Video", "start": 58.89, "end": 59.786}, {"text": "zu Klarna findest du", "start": 59.786, "end": 61.09}, {"text": "bei uns auf dem Kanal", "start": 61.09, "end": 62.373}]}]}