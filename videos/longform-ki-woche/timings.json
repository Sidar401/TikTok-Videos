{"dauer": 152.95, "saetze": [{"id": "s1", "start": 0.0, "end": 5.185, "captions": [{"text": "Diese Woche entscheidet sich,", "start": 0.0, "end": 2.253}, {"text": "ob die KI‑Börse weiter", "start": 2.253, "end": 3.963}, {"text": "boomt oder platzt", "start": 3.963, "end": 5.185}]}, {"id": "s2", "start": 5.185, "end": 13.463, "captions": [{"text": "Gestern ist Tech", "start": 5.185, "end": 6.26}, {"text": "weltweit abgestürzt,", "start": 6.26, "end": 7.728}, {"text": "heute Nacht kommen", "start": 7.728, "end": 9.048}, {"text": "die Nvidia‑Zahlen,", "start": 9.048, "end": 10.369}, {"text": "und am Donnerstag geht", "start": 10.369, "end": 11.983}, {"text": "Anthropic an die Börse", "start": 11.983, "end": 13.463}]}, {"id": "s3", "start": 13.463, "end": 17.029, "captions": [{"text": "Teile das Video", "start": 13.463, "end": 14.244}, {"text": "mit deinen Freunden,", "start": 14.244, "end": 15.463}, {"text": "damit sie auch Bescheid wissen", "start": 15.463, "end": 17.029}]}, {"id": "s4", "start": 17.029, "end": 18.633, "captions": [{"text": "Fangen wir mit gestern an", "start": 17.029, "end": 18.633}]}, {"id": "s5", "start": 18.633, "end": 26.327, "captions": [{"text": "Die großen", "start": 18.633, "end": 19.568}, {"text": "Tech‑Werte in Amerika", "start": 19.568, "end": 21.801}, {"text": "haben 2,7 % verloren,", "start": 21.801, "end": 24.004}, {"text": "in Südkorea sogar 3,6 %", "start": 24.004, "end": 26.327}]}, {"id": "s6", "start": 26.327, "end": 31.443, "captions": [{"text": "Der Chip‑Hersteller SK Hynix", "start": 26.327, "end": 29.108}, {"text": "ist um 7,9 % abgestürzt", "start": 29.108, "end": 31.443}]}, {"id": "s7", "start": 31.443, "end": 37.949, "captions": [{"text": "Der Grund: Anleger", "start": 31.443, "end": 32.663}, {"text": "haben Angst,", "start": 32.663, "end": 33.598}, {"text": "dass zu viel Geld", "start": 33.598, "end": 34.923}, {"text": "in KI gesteckt wurde,", "start": 34.923, "end": 36.56}, {"text": "das nie zurückkommt", "start": 36.56, "end": 37.949}]}, {"id": "s8", "start": 37.949, "end": 41.661, "captions": [{"text": "Und das trifft vor", "start": 37.949, "end": 39.613}, {"text": "allem eine Firma: Nvidia", "start": 39.613, "end": 41.661}]}, {"id": "s9", "start": 41.661, "end": 46.4, "captions": [{"text": "Die Aktie liegt schon", "start": 41.661, "end": 43.266}, {"text": "rund 32 % unter ihrem", "start": 43.266, "end": 45.01}, {"text": "Rekord vom Oktober", "start": 45.01, "end": 46.4}]}, {"id": "s10", "start": 46.4, "end": 52.801, "captions": [{"text": "Dazu kommt der Rücktritt", "start": 46.4, "end": 48.044}, {"text": "von Gründer Jensen Huang.", "start": 48.044, "end": 49.65}, {"text": "Jetzt führt Finanzchefin", "start": 49.65, "end": 51.399}, {"text": "Colette Kress die Firma", "start": 51.399, "end": 52.801}]}, {"id": "s11", "start": 52.801, "end": 57.433, "captions": [{"text": "Heute Nacht um", "start": 52.801, "end": 53.874}, {"text": "22:20 Uhr legt Nvidia", "start": 53.874, "end": 55.894}, {"text": "seine Zahlen vor", "start": 55.894, "end": 57.433}]}, {"id": "s12", "start": 57.433, "end": 65.044, "captions": [{"text": "Erwartet werden", "start": 57.433, "end": 58.541}, {"text": "rund 109 Milliarden Dollar", "start": 58.541, "end": 60.461}, {"text": "Umsatz in nur 3 Monaten,", "start": 60.461, "end": 62.456}, {"text": "fast doppelt so viel", "start": 62.456, "end": 63.887}, {"text": "wie vor einem Jahr", "start": 63.887, "end": 65.044}]}, {"id": "s13", "start": 65.044, "end": 69.368, "captions": [{"text": "16 Mal hintereinander hat", "start": 65.044, "end": 66.909}, {"text": "Nvidia die Erwartungen", "start": 66.909, "end": 68.704}, {"text": "geschlagen", "start": 68.704, "end": 69.368}]}, {"id": "s14", "start": 69.368, "end": 73.154, "captions": [{"text": "Aber diesmal zählt etwas", "start": 69.368, "end": 71.459}, {"text": "anderes: der Ausblick", "start": 71.459, "end": 73.154}]}, {"id": "s15", "start": 73.154, "end": 79.038, "captions": [{"text": "Sagt Nvidia,", "start": 73.154, "end": 73.936}, {"text": "dass die Nachfrage", "start": 73.936, "end": 75.337}, {"text": "weiter wächst,", "start": 75.337, "end": 76.427}, {"text": "könnte die ganze", "start": 76.427, "end": 77.673}, {"text": "Tech‑Börse aufatmen", "start": 77.673, "end": 79.038}]}, {"id": "s16", "start": 79.038, "end": 82.801, "captions": [{"text": "Wird der Ausblick vorsichtig,", "start": 79.038, "end": 80.889}, {"text": "könnte der Absturz weitergehen", "start": 80.889, "end": 82.801}]}, {"id": "s17", "start": 82.801, "end": 88.429, "captions": [{"text": "Folge HundeFinanzTv,", "start": 82.801, "end": 84.407}, {"text": "wir bringen dir jeden Tag", "start": 84.407, "end": 86.563}, {"text": "die wichtigsten Geld‑News", "start": 86.563, "end": 88.429}]}, {"id": "s18", "start": 88.429, "end": 90.53, "captions": [{"text": "Und dann kommt Donnerstag", "start": 88.429, "end": 90.53}]}, {"id": "s19", "start": 90.53, "end": 95.057, "captions": [{"text": "Anthropic,", "start": 90.53, "end": 91.266}, {"text": "die Firma hinter", "start": 91.266, "end": 92.595}, {"text": "der KI Claude,", "start": 92.595, "end": 93.757}, {"text": "geht an die Börse", "start": 93.757, "end": 95.057}]}, {"id": "s20", "start": 95.057, "end": 98.538, "captions": [{"text": "Es wäre einer der größten", "start": 95.057, "end": 96.831}, {"text": "Börsengänge aller Zeiten", "start": 96.831, "end": 98.538}]}, {"id": "s21", "start": 98.538, "end": 104.124, "captions": [{"text": "Für viele ist das der Test:", "start": 98.538, "end": 100.621}, {"text": "Wollen Anleger überhaupt", "start": 100.621, "end": 102.437}, {"text": "noch KI‑Aktien kaufen?", "start": 102.437, "end": 104.124}]}, {"id": "s22", "start": 104.124, "end": 107.719, "captions": [{"text": "Läuft der Börsengang gut,", "start": 104.124, "end": 105.861}, {"text": "ist das ein starkes Signal", "start": 105.861, "end": 107.719}]}, {"id": "s23", "start": 107.719, "end": 111.697, "captions": [{"text": "Läuft er schlecht,", "start": 107.719, "end": 108.879}, {"text": "wäre das ein Warnzeichen", "start": 108.879, "end": 110.506}, {"text": "für die ganze Branche", "start": 110.506, "end": 111.697}]}, {"id": "s24", "start": 111.697, "end": 113.192, "captions": [{"text": "Warum geht dich das an?", "start": 111.697, "end": 113.192}]}, {"id": "s25", "start": 113.192, "end": 117.474, "captions": [{"text": "Nvidia gehört zu den größten", "start": 113.192, "end": 115.33}, {"text": "Werten in vielen Welt‑ETFs", "start": 115.33, "end": 117.474}]}, {"id": "s26", "start": 117.474, "end": 122.199, "captions": [{"text": "Und auch Microsoft,", "start": 117.474, "end": 119.006}, {"text": "Amazon und Google", "start": 119.006, "end": 120.376}, {"text": "stecken Milliarden in KI", "start": 120.376, "end": 122.199}]}, {"id": "s27", "start": 122.199, "end": 126.37, "captions": [{"text": "Wenn die KI‑Börse wackelt,", "start": 122.199, "end": 124.009}, {"text": "wackelt also auch", "start": 124.009, "end": 125.265}, {"text": "dein Sparplan mit", "start": 125.265, "end": 126.37}]}, {"id": "s28", "start": 126.37, "end": 127.669, "captions": [{"text": "Was kannst du tun?", "start": 126.37, "end": 127.669}]}, {"id": "s29", "start": 127.669, "end": 132.218, "captions": [{"text": "Erstens: nicht", "start": 127.669, "end": 128.608}, {"text": "in Panik verkaufen,", "start": 128.608, "end": 130.165}, {"text": "nur weil es gerade rot ist", "start": 130.165, "end": 132.218}]}, {"id": "s30", "start": 132.218, "end": 136.895, "captions": [{"text": "Zweitens: prüfen,", "start": 132.218, "end": 133.393}, {"text": "wie viel KI wirklich", "start": 133.393, "end": 135.217}, {"text": "in deinem Depot steckt", "start": 135.217, "end": 136.895}]}, {"id": "s31", "start": 136.895, "end": 142.952, "captions": [{"text": "Drittens: Wer", "start": 136.895, "end": 137.656}, {"text": "regelmäßig spart,", "start": 137.656, "end": 138.954}, {"text": "kauft bei fallenden Kursen", "start": 138.954, "end": 141.135}, {"text": "automatisch günstiger ein", "start": 141.135, "end": 142.952}]}, {"id": "s32", "start": 142.952, "end": 147.706, "captions": [{"text": "Merk dir: Eine Woche", "start": 142.952, "end": 144.486}, {"text": "entscheidet nicht", "start": 144.486, "end": 146.232}, {"text": "über 20 Jahre Sparplan", "start": 146.232, "end": 147.706}]}, {"id": "s33", "start": 147.706, "end": 152.36, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 147.706, "end": 149.326}, {"text": "keine Anlageberatung,", "start": 149.326, "end": 150.959}, {"text": "nur eine Erklärung", "start": 150.959, "end": 152.36}]}]}