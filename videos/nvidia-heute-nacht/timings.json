{"dauer": 68.41, "saetze": [{"id": "s1", "start": 0.0, "end": 2.981, "captions": [{"text": "Heute Nacht entscheidet sich,", "start": 0.0, "end": 1.507}, {"text": "wie es an der Börse weitergeht", "start": 1.507, "end": 2.981}]}, {"id": "s2", "start": 2.981, "end": 8.18, "captions": [{"text": "Um 22:20 Uhr legt", "start": 2.981, "end": 4.108}, {"text": "Nvidia seine Zahlen vor,", "start": 4.108, "end": 5.818}, {"text": "der wichtigste", "start": 5.818, "end": 6.783}, {"text": "Chip‑Konzern der Welt", "start": 6.783, "end": 8.18}]}, {"id": "s3", "start": 8.18, "end": 12.578, "captions": [{"text": "Schreib uns in die Kommentare,", "start": 8.18, "end": 9.765}, {"text": "ob die Aktie morgen deiner", "start": 9.765, "end": 11.223}, {"text": "Meinung nach steigt oder fällt", "start": 11.223, "end": 12.578}]}, {"id": "s4", "start": 12.578, "end": 14.727, "captions": [{"text": "Schon gestern hat", "start": 12.578, "end": 13.418}, {"text": "es weltweit gekracht", "start": 13.418, "end": 14.727}]}, {"id": "s5", "start": 14.727, "end": 20.881, "captions": [{"text": "Die großen Tech‑Werte", "start": 14.727, "end": 16.267}, {"text": "in Amerika haben", "start": 16.267, "end": 17.489}, {"text": "fast 3 % verloren,", "start": 17.489, "end": 18.811}, {"text": "in Südkorea sogar über 3,5 %", "start": 18.811, "end": 20.881}]}, {"id": "s6", "start": 20.881, "end": 24.747, "captions": [{"text": "Der Chip‑Hersteller SK Hynix", "start": 20.881, "end": 22.882}, {"text": "ist um fast 8 % abgestürzt", "start": 22.882, "end": 24.747}]}, {"id": "s7", "start": 24.747, "end": 27.934, "captions": [{"text": "Alle warten auf eine Antwort:", "start": 24.747, "end": 26.356}, {"text": "Läuft das KI‑Geschäft noch?", "start": 26.356, "end": 27.934}]}, {"id": "s8", "start": 27.934, "end": 32.235, "captions": [{"text": "Folge HundeFinanzTv,", "start": 27.934, "end": 29.162}, {"text": "wir bringen dir jeden Tag", "start": 29.162, "end": 30.771}, {"text": "die wichtigsten Geld‑News", "start": 30.771, "end": 32.235}]}, {"id": "s9", "start": 32.235, "end": 36.459, "captions": [{"text": "Die Erwartung:", "start": 32.235, "end": 33.064}, {"text": "rund 109 Milliarden Dollar", "start": 33.064, "end": 34.712}, {"text": "Umsatz in nur 3 Monaten", "start": 34.712, "end": 36.459}]}, {"id": "s10", "start": 36.459, "end": 38.747, "captions": [{"text": "Das wäre fast doppelt", "start": 36.459, "end": 37.477}, {"text": "so viel wie vor einem Jahr", "start": 37.477, "end": 38.747}]}, {"id": "s11", "start": 38.747, "end": 42.108, "captions": [{"text": "16 Mal hintereinander hat", "start": 38.747, "end": 40.21}, {"text": "Nvidia die Erwartungen", "start": 40.21, "end": 41.558}, {"text": "geschlagen", "start": 41.558, "end": 42.108}]}, {"id": "s12", "start": 42.108, "end": 47.37, "captions": [{"text": "Aber diesmal ist alles", "start": 42.108, "end": 43.322}, {"text": "anders: Es ist der erste", "start": 43.322, "end": 44.671}, {"text": "Bericht seit dem Rücktritt", "start": 44.671, "end": 46.179}, {"text": "von Chef Jensen Huang", "start": 46.179, "end": 47.37}]}, {"id": "s13", "start": 47.37, "end": 51.159, "captions": [{"text": "Und die Aktie liegt schon", "start": 47.37, "end": 49.222}, {"text": "rund 32 % unter ihrem Rekord", "start": 49.222, "end": 51.159}]}, {"id": "s14", "start": 51.159, "end": 55.95, "captions": [{"text": "Warum betrifft dich das?", "start": 51.159, "end": 52.444}, {"text": "Nvidia ist einer der größten", "start": 52.444, "end": 54.307}, {"text": "Werte in vielen Welt‑ETFs", "start": 54.307, "end": 55.95}]}, {"id": "s15", "start": 55.95, "end": 59.563, "captions": [{"text": "Wenn Nvidia wackelt,", "start": 55.95, "end": 56.956}, {"text": "wackelt also auch", "start": 56.956, "end": 57.899}, {"text": "dein Sparplan ein bisschen mit", "start": 57.899, "end": 59.563}]}, {"id": "s16", "start": 59.563, "end": 63.619, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 59.563, "end": 60.697}, {"text": "keine Anlageberatung,", "start": 60.697, "end": 62.349}, {"text": "nur eine Erklärung", "start": 62.349, "end": 63.619}]}, {"id": "s17", "start": 63.619, "end": 67.804, "captions": [{"text": "Ein ganzes Video zum Rücktritt", "start": 63.619, "end": 65.138}, {"text": "von Jensen Huang findest", "start": 65.138, "end": 66.474}, {"text": "du bei uns auf dem Kanal", "start": 66.474, "end": 67.804}]}]}