{"dauer": 152.04, "saetze": [{"id": "s1", "start": 0.0, "end": 5.174, "captions": [{"text": "Am Donnerstag geht", "start": 0.0, "end": 1.096}, {"text": "eine Firma an die Börse,", "start": 1.096, "end": 2.558}, {"text": "die bis zu 1,4 Billionen", "start": 2.558, "end": 4.019}, {"text": "Dollar wert sein soll", "start": 4.019, "end": 5.174}]}, {"id": "s2", "start": 5.174, "end": 9.063, "captions": [{"text": "Es ist Anthropic,", "start": 5.174, "end": 6.112}, {"text": "die Firma hinter", "start": 6.112, "end": 7.113}, {"text": "der künstlichen", "start": 7.113, "end": 8.051}, {"text": "Intelligenz Claude", "start": 8.051, "end": 9.063}]}, {"id": "s3", "start": 9.063, "end": 12.928, "captions": [{"text": "Schreib uns in die Kommentare,", "start": 9.063, "end": 10.603}, {"text": "ob du die Aktie am ersten", "start": 10.603, "end": 11.981}, {"text": "Tag kaufen würdest", "start": 11.981, "end": 12.928}]}, {"id": "s4", "start": 12.928, "end": 17.138, "captions": [{"text": "Folge HundeFinanzTv,", "start": 12.928, "end": 14.166}, {"text": "wir bringen dir jeden Tag", "start": 14.166, "end": 15.698}, {"text": "die wichtigsten Geld‑News", "start": 15.698, "end": 17.138}]}, {"id": "s5", "start": 17.138, "end": 21.347, "captions": [{"text": "Die Eckdaten:", "start": 17.138, "end": 18.006}, {"text": "Eine Aktie soll zwischen", "start": 18.006, "end": 19.602}, {"text": "70 und 78 Dollar kosten", "start": 19.602, "end": 21.347}]}, {"id": "s6", "start": 21.347, "end": 24.569, "captions": [{"text": "Angeboten werden", "start": 21.347, "end": 22.769}, {"text": "825 Millionen Aktien", "start": 22.769, "end": 24.569}]}, {"id": "s7", "start": 24.569, "end": 28.982, "captions": [{"text": "Am oberen Ende würde Anthropic", "start": 24.569, "end": 26.423}, {"text": "damit rund 64 Milliarden", "start": 26.423, "end": 27.974}, {"text": "Dollar einsammeln", "start": 27.974, "end": 28.982}]}, {"id": "s8", "start": 28.982, "end": 35.45, "captions": [{"text": "Das wäre der zweitgrößte", "start": 28.982, "end": 30.526}, {"text": "Börsengang aller Zeiten,", "start": 30.526, "end": 32.063}, {"text": "nur SpaceX hat im Juni", "start": 32.063, "end": 33.561}, {"text": "mit 75 Milliarden mehr geholt", "start": 33.561, "end": 35.45}]}, {"id": "s9", "start": 35.45, "end": 40.366, "captions": [{"text": "Zum Vergleich: Saudi Aramco,", "start": 35.45, "end": 37.138}, {"text": "lange der Rekordhalter,", "start": 37.138, "end": 38.65}, {"text": "kam auf knapp 30 Milliarden", "start": 38.65, "end": 40.366}]}, {"id": "s10", "start": 40.366, "end": 43.615, "captions": [{"text": "Gehandelt", "start": 40.366, "end": 40.79}, {"text": "werden soll die Aktie", "start": 40.79, "end": 42.019}, {"text": "an der Technologiebörse Nasdaq", "start": 42.019, "end": 43.615}]}, {"id": "s11", "start": 43.615, "end": 46.01, "captions": [{"text": "Aber warum ist", "start": 43.615, "end": 44.473}, {"text": "Anthropic so viel wert?", "start": 44.473, "end": 46.01}]}, {"id": "s12", "start": 46.01, "end": 47.998, "captions": [{"text": "Die Firma wächst", "start": 46.01, "end": 46.847}, {"text": "unglaublich schnell", "start": 46.847, "end": 47.998}]}, {"id": "s13", "start": 47.998, "end": 51.765, "captions": [{"text": "Zu den großen Geldgebern", "start": 47.998, "end": 49.512}, {"text": "gehören unter anderem", "start": 49.512, "end": 50.837}, {"text": "Google und Amazon", "start": 50.837, "end": 51.765}]}, {"id": "s14", "start": 51.765, "end": 56.105, "captions": [{"text": "Allein im dritten Quartal hat", "start": 51.765, "end": 53.436}, {"text": "Anthropic rund 17 Milliarden", "start": 53.436, "end": 55.188}, {"text": "Dollar umgesetzt", "start": 55.188, "end": 56.105}]}, {"id": "s15", "start": 56.105, "end": 60.914, "captions": [{"text": "Hochgerechnet aufs Jahr", "start": 56.105, "end": 57.549}, {"text": "sind das laut Börsenprospekt", "start": 57.549, "end": 59.41}, {"text": "rund 81 Milliarden Dollar", "start": 59.41, "end": 60.914}]}, {"id": "s16", "start": 60.914, "end": 64.165, "captions": [{"text": "Vor allem Firmen", "start": 60.914, "end": 61.704}, {"text": "nutzen Claude,", "start": 61.704, "end": 62.534}, {"text": "zum Beispiel zum Programmieren", "start": 62.534, "end": 64.165}]}, {"id": "s17", "start": 64.165, "end": 67.241, "captions": [{"text": "Claude ist", "start": 64.165, "end": 64.584}, {"text": "damit einer der größten", "start": 64.584, "end": 65.885}, {"text": "Konkurrenten von ChatGPT", "start": 65.885, "end": 67.241}]}, {"id": "s18", "start": 67.241, "end": 73.376, "captions": [{"text": "Aber: Unterm Strich schreibt", "start": 67.241, "end": 68.638}, {"text": "Anthropic noch Verluste,", "start": 68.638, "end": 70.336}, {"text": "weil Rechenzentren", "start": 70.336, "end": 71.61}, {"text": "und Chips Milliarden kosten", "start": 71.61, "end": 73.376}]}, {"id": "s19", "start": 73.376, "end": 75.049, "captions": [{"text": "Und der Preis ist", "start": 73.376, "end": 74.279}, {"text": "schon gesunken", "start": 74.279, "end": 75.049}]}, {"id": "s20", "start": 75.049, "end": 81.208, "captions": [{"text": "Anfang Oktober hatten", "start": 75.049, "end": 76.322}, {"text": "Analysten noch von zwei", "start": 76.322, "end": 77.817}, {"text": "Billionen Dollar gesprochen,", "start": 77.817, "end": 79.604}, {"text": "jetzt sind es höchstens 1,4", "start": 79.604, "end": 81.208}]}, {"id": "s21", "start": 81.208, "end": 84.511, "captions": [{"text": "Die große Frage:", "start": 81.208, "end": 82.196}, {"text": "Lohnt es sich,", "start": 82.196, "end": 82.976}, {"text": "am ersten Tag zu kaufen?", "start": 82.976, "end": 84.511}]}, {"id": "s22", "start": 84.511, "end": 87.389, "captions": [{"text": "Die Geschichte zeigt: Es kann", "start": 84.511, "end": 86.014}, {"text": "in beide Richtungen gehen", "start": 86.014, "end": 87.389}]}, {"id": "s23", "start": 87.389, "end": 91.102, "captions": [{"text": "SpaceX stieg im Juni", "start": 87.389, "end": 89.157}, {"text": "am ersten Tag um 19 %", "start": 89.157, "end": 91.102}]}, {"id": "s24", "start": 91.102, "end": 99.144, "captions": [{"text": "Facebook dagegen ging", "start": 91.102, "end": 92.579}, {"text": "2012 für 38 Dollar", "start": 92.579, "end": 93.845}, {"text": "an die Börse,", "start": 93.845, "end": 94.759}, {"text": "und wenige Monate später", "start": 94.759, "end": 96.341}, {"text": "war die Aktie nur noch", "start": 96.341, "end": 97.888}, {"text": "rund die Hälfte wert", "start": 97.888, "end": 99.144}]}, {"id": "s25", "start": 99.144, "end": 102.584, "captions": [{"text": "Wer damals durchgehalten hat,", "start": 99.144, "end": 100.809}, {"text": "wurde später", "start": 100.809, "end": 101.562}, {"text": "aber reich belohnt", "start": 101.562, "end": 102.584}]}, {"id": "s26", "start": 102.584, "end": 107.56, "captions": [{"text": "Heute gehört Meta,", "start": 102.584, "end": 103.661}, {"text": "wie Facebook inzwischen heißt,", "start": 103.661, "end": 105.635}, {"text": "zu den wertvollsten", "start": 105.635, "end": 106.885}, {"text": "Firmen der Welt", "start": 106.885, "end": 107.56}]}, {"id": "s27", "start": 107.56, "end": 113.893, "captions": [{"text": "Für dich als Privatanleger", "start": 107.56, "end": 108.757}, {"text": "in Deutschland gilt meistens:", "start": 108.757, "end": 110.439}, {"text": "Du kannst erst kaufen,", "start": 110.439, "end": 111.612}, {"text": "wenn die Aktie", "start": 111.612, "end": 112.424}, {"text": "an der Börse gehandelt wird", "start": 112.424, "end": 113.893}]}, {"id": "s28", "start": 113.893, "end": 119.47, "captions": [{"text": "Und gerade die ersten", "start": 113.893, "end": 115.243}, {"text": "Stunden sind oft extrem wild,", "start": 115.243, "end": 117.192}, {"text": "mit großen Sprüngen", "start": 117.192, "end": 118.501}, {"text": "nach oben und unten", "start": 118.501, "end": 119.47}]}, {"id": "s29", "start": 119.47, "end": 121.976, "captions": [{"text": "Drei Dinge,", "start": 119.47, "end": 119.967}, {"text": "auf die viele Anleger achten:", "start": 119.967, "end": 121.976}]}, {"id": "s30", "start": 121.976, "end": 127.063, "captions": [{"text": "Erstens: nicht", "start": 121.976, "end": 122.69}, {"text": "in der ersten Minute kaufen,", "start": 122.69, "end": 124.363}, {"text": "sondern warten,", "start": 124.363, "end": 125.317}, {"text": "bis sich der Kurs beruhigt hat", "start": 125.317, "end": 127.063}]}, {"id": "s31", "start": 127.063, "end": 131.275, "captions": [{"text": "Zweitens: ein Limit setzen,", "start": 127.063, "end": 128.546}, {"text": "damit man nicht viel", "start": 128.546, "end": 129.863}, {"text": "teurer kauft als geplant", "start": 129.863, "end": 131.275}]}, {"id": "s32", "start": 131.275, "end": 135.354, "captions": [{"text": "Und drittens: nur", "start": 131.275, "end": 132.271}, {"text": "Geld einsetzen,", "start": 132.271, "end": 133.211}, {"text": "das man einige", "start": 133.211, "end": 134.171}, {"text": "Jahre nicht braucht", "start": 134.171, "end": 135.354}]}, {"id": "s33", "start": 135.354, "end": 138.755, "captions": [{"text": "Denn ein bekannter Name allein", "start": 135.354, "end": 137.04}, {"text": "ist noch kein Grund zu kaufen", "start": 137.04, "end": 138.755}]}, {"id": "s34", "start": 138.755, "end": 143.957, "captions": [{"text": "Übrigens: In große Welt‑ETFs", "start": 138.755, "end": 140.533}, {"text": "kommt Anthropic ohnehin erst", "start": 140.533, "end": 142.463}, {"text": "nach einiger Zeit hinein", "start": 142.463, "end": 143.957}]}, {"id": "s35", "start": 143.957, "end": 147.339, "captions": [{"text": "Am Donnerstag wissen wir mehr,", "start": 143.957, "end": 145.5}, {"text": "und wir halten dich", "start": 145.5, "end": 146.563}, {"text": "auf dem Laufenden", "start": 146.563, "end": 147.339}]}, {"id": "s36", "start": 147.339, "end": 151.423, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 147.339, "end": 148.601}, {"text": "keine Anlageberatung,", "start": 148.601, "end": 150.124}, {"text": "nur eine Erklärung", "start": 150.124, "end": 151.423}]}]}