{"dauer": 124.41, "saetze": [{"id": "s1", "start": 0.0, "end": 3.805, "captions": [{"text": "6,3", "start": 0.0, "end": 1.052}, {"text": "Milliarden Dollar,", "start": 1.052, "end": 2.153}, {"text": "gestohlen in nur 20 Minuten", "start": 2.153, "end": 3.805}]}, {"id": "s2", "start": 3.805, "end": 8.69, "captions": [{"text": "Es ist der größte", "start": 3.805, "end": 4.707}, {"text": "Krypto‑Raub der Geschichte,", "start": 4.707, "end": 6.218}, {"text": "und er begann", "start": 6.218, "end": 7.001}, {"text": "mit einem harmlosen Jobangebot", "start": 7.001, "end": 8.69}]}, {"id": "s3", "start": 8.69, "end": 12.764, "captions": [{"text": "Schick das Video jemandem,", "start": 8.69, "end": 10.028}, {"text": "der gerade", "start": 10.028, "end": 10.589}, {"text": "einen neuen Job sucht,", "start": 10.589, "end": 11.823}, {"text": "es könnte ihn schützen", "start": 11.823, "end": 12.764}]}, {"id": "s4", "start": 12.764, "end": 14.371, "captions": [{"text": "Teil eins: Die Falle", "start": 12.764, "end": 14.371}]}, {"id": "s5", "start": 14.371, "end": 20.351, "captions": [{"text": "Im Juni bekommt", "start": 14.371, "end": 14.98}, {"text": "ein Programmierer", "start": 14.98, "end": 15.983}, {"text": "der Kryptobörse", "start": 15.983, "end": 16.868}, {"text": "Binance eine Nachricht", "start": 16.868, "end": 18.166}, {"text": "von einem angeblichen", "start": 18.166, "end": 19.405}, {"text": "Personalvermittler", "start": 19.405, "end": 20.351}]}, {"id": "s6", "start": 20.351, "end": 23.009, "captions": [{"text": "Er sucht gerade", "start": 20.351, "end": 21.149}, {"text": "einen neuen Job,", "start": 21.149, "end": 22.089}, {"text": "also macht er mit", "start": 22.089, "end": 23.009}]}, {"id": "s7", "start": 23.009, "end": 28.182, "captions": [{"text": "Es folgt ein zweites Gespräch,", "start": 23.009, "end": 24.592}, {"text": "diesmal mit dem angeblichen", "start": 24.592, "end": 26.122}, {"text": "Chef einer Firma,", "start": 26.122, "end": 27.085}, {"text": "die es gar nicht gibt", "start": 27.085, "end": 28.182}]}, {"id": "s8", "start": 28.182, "end": 30.786, "captions": [{"text": "Am Ende soll er", "start": 28.182, "end": 29.022}, {"text": "eine Probeaufgabe", "start": 29.022, "end": 30.078}, {"text": "herunterladen", "start": 30.078, "end": 30.786}]}, {"id": "s9", "start": 30.786, "end": 35.684, "captions": [{"text": "Doch in dieser Datei", "start": 30.786, "end": 31.81}, {"text": "steckt eine Schadsoftware,", "start": 31.81, "end": 33.266}, {"text": "und der Virenschutz", "start": 33.266, "end": 34.285}, {"text": "von Binance bemerkt sie nicht", "start": 34.285, "end": 35.684}]}, {"id": "s10", "start": 35.684, "end": 37.23, "captions": [{"text": "Teil zwei: Der Raub", "start": 35.684, "end": 37.23}]}, {"id": "s11", "start": 37.23, "end": 40.393, "captions": [{"text": "Monatelang bewegen sich", "start": 37.23, "end": 38.352}, {"text": "die Hacker unbemerkt", "start": 38.352, "end": 39.57}, {"text": "durch die Firma", "start": 39.57, "end": 40.393}]}, {"id": "s12", "start": 40.393, "end": 42.827, "captions": [{"text": "Am 29.", "start": 40.393, "end": 41.508}, {"text": "Oktober schlagen sie zu", "start": 41.508, "end": 42.827}]}, {"id": "s13", "start": 42.827, "end": 48.766, "captions": [{"text": "In nur 20 Minuten fließen über", "start": 42.827, "end": 44.675}, {"text": "6 Milliarden Dollar ab,", "start": 44.675, "end": 46.339}, {"text": "verteilt über 10", "start": 46.339, "end": 47.421}, {"text": "verschiedene Blockchains", "start": 47.421, "end": 48.766}]}, {"id": "s14", "start": 48.766, "end": 56.074, "captions": [{"text": "Zum Vergleich:", "start": 48.766, "end": 49.647}, {"text": "Der bisherige Rekord lag", "start": 49.647, "end": 51.568}, {"text": "bei 1,5 Milliarden Dollar,", "start": 51.568, "end": 53.684}, {"text": "bei der Börse", "start": 53.684, "end": 54.743}, {"text": "Bybit im Jahr 2025", "start": 54.743, "end": 56.074}]}, {"id": "s15", "start": 56.074, "end": 59.071, "captions": [{"text": "Dieser Raub ist also", "start": 56.074, "end": 57.846}, {"text": "rund viermal so groß", "start": 57.846, "end": 59.071}]}, {"id": "s16", "start": 59.071, "end": 61.575, "captions": [{"text": "Teil drei: Die Spur", "start": 59.071, "end": 60.242}, {"text": "führt nach Nordkorea", "start": 60.242, "end": 61.575}]}, {"id": "s17", "start": 61.575, "end": 68.28, "captions": [{"text": "Die amerikanische", "start": 61.575, "end": 62.328}, {"text": "Bundespolizei", "start": 62.328, "end": 63.051}, {"text": "macht eine nordkoreanische", "start": 63.051, "end": 64.496}, {"text": "Hackergruppe verantwortlich,", "start": 64.496, "end": 66.053}, {"text": "die auch hinter", "start": 66.053, "end": 66.886}, {"text": "dem Bybit‑Raub stecken soll", "start": 66.886, "end": 68.28}]}, {"id": "s18", "start": 68.28, "end": 70.02, "captions": [{"text": "Nordkorea bestreitet das", "start": 68.28, "end": 70.02}]}, {"id": "s19", "start": 70.02, "end": 77.944, "captions": [{"text": "Die amerikanische Justiz hat", "start": 70.02, "end": 71.587}, {"text": "inzwischen über 1,2 Milliarden", "start": 71.587, "end": 73.444}, {"text": "Dollar beschlagnahmen lassen,", "start": 73.444, "end": 75.24}, {"text": "insgesamt sind rund 3", "start": 75.24, "end": 76.725}, {"text": "Milliarden eingefroren", "start": 76.725, "end": 77.944}]}, {"id": "s20", "start": 77.944, "end": 81.824, "captions": [{"text": "Schreib uns in die Kommentare:", "start": 77.944, "end": 79.453}, {"text": "Hättest du die Probeaufgabe", "start": 79.453, "end": 81.028}, {"text": "heruntergeladen?", "start": 81.028, "end": 81.824}]}, {"id": "s21", "start": 81.824, "end": 84.007, "captions": [{"text": "Teil vier: Was ist", "start": 81.824, "end": 82.915}, {"text": "mit den Kunden?", "start": 82.915, "end": 84.007}]}, {"id": "s22", "start": 84.007, "end": 88.468, "captions": [{"text": "Binance hat", "start": 84.007, "end": 84.607}, {"text": "alle 6,3 Milliarden Dollar", "start": 84.607, "end": 86.498}, {"text": "aus eigenen Reserven ersetzt", "start": 86.498, "end": 88.468}]}, {"id": "s23", "start": 88.468, "end": 90.361, "captions": [{"text": "Kein Kunde hat", "start": 88.468, "end": 89.323}, {"text": "also Geld verloren", "start": 89.323, "end": 90.361}]}, {"id": "s24", "start": 90.361, "end": 95.102, "captions": [{"text": "Aber jetzt kommt", "start": 90.361, "end": 91.195}, {"text": "die zweite Welle: Betrüger", "start": 91.195, "end": 92.577}, {"text": "verschicken gefälschte", "start": 92.577, "end": 93.923}, {"text": "Entschädigungs‑Formulare", "start": 93.923, "end": 95.102}]}, {"id": "s25", "start": 95.102, "end": 97.259, "captions": [{"text": "Teil fünf: So schützt du dich", "start": 95.102, "end": 97.259}]}, {"id": "s26", "start": 97.259, "end": 103.265, "captions": [{"text": "Erstens: Öffne die App", "start": 97.259, "end": 98.274}, {"text": "oder Webseite immer selbst,", "start": 98.274, "end": 100.014}, {"text": "und klick nie auf Links", "start": 100.014, "end": 101.487}, {"text": "in Nachrichten,", "start": 101.487, "end": 102.453}, {"text": "die Druck machen", "start": 102.453, "end": 103.265}]}, {"id": "s27", "start": 103.265, "end": 108.705, "captions": [{"text": "Zweitens: Gib", "start": 103.265, "end": 103.908}, {"text": "niemals deine Wiederherstellungs‑Wörter", "start": 103.908, "end": 106.388}, {"text": "oder Passwörter heraus,", "start": 106.388, "end": 107.899}, {"text": "egal wer fragt", "start": 107.899, "end": 108.705}]}, {"id": "s28", "start": 108.705, "end": 113.642, "captions": [{"text": "Und drittens: Lade nie", "start": 108.705, "end": 109.734}, {"text": "Dateien von Fremden herunter,", "start": 109.734, "end": 111.566}, {"text": "auch nicht", "start": 111.566, "end": 112.192}, {"text": "für ein Bewerbungsgespräch", "start": 112.192, "end": 113.642}]}, {"id": "s29", "start": 113.642, "end": 119.837, "captions": [{"text": "Denn der größte", "start": 113.642, "end": 114.244}, {"text": "Krypto‑Raub der Geschichte", "start": 114.244, "end": 115.621}, {"text": "begann nicht mit Technik,", "start": 115.621, "end": 116.936}, {"text": "sondern mit einem Menschen,", "start": 116.936, "end": 118.356}, {"text": "der einem Jobangebot", "start": 118.356, "end": 119.415}, {"text": "vertraut hat", "start": 119.415, "end": 119.837}]}, {"id": "s30", "start": 119.837, "end": 123.805, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 119.837, "end": 121.243}, {"text": "keine Anlageberatung,", "start": 121.243, "end": 122.885}, {"text": "nur eine Erklärung", "start": 122.885, "end": 123.805}]}]}