{
  "dauer": 37.51,
  "saetze": [
    {
      "id": "s1",
      "start": 0.0,
      "end": 3.831,
      "captions": [
        {
          "text": "wenn dein Hund ständig bellt,",
          "start": 0.0,
          "end": 1.668
        },
        {
          "text": "hat das meistens einen",
          "start": 1.668,
          "end": 2.999
        },
        {
          "text": "dieser 5 Gründe",
          "start": 2.999,
          "end": 3.831
        }
      ]
    },
    {
      "id": "s2",
      "start": 3.831,
      "end": 8.834,
      "captions": [
        {
          "text": "Grund Nr. 1",
          "start": 3.831,
          "end": 4.529
        },
        {
          "text": "ist territoriales Verhalten,",
          "start": 4.529,
          "end": 6.472
        },
        {
          "text": "weil jemand seine",
          "start": 6.472,
          "end": 7.599
        },
        {
          "text": "Grenze überschreitet",
          "start": 7.599,
          "end": 8.834
        }
      ]
    },
    {
      "id": "s3",
      "start": 8.834,
      "end": 13.112,
      "captions": [
        {
          "text": "Grund Nr. 2 ist",
          "start": 8.834,
          "end": 9.748
        },
        {
          "text": "Angst oder Unsicherheit,",
          "start": 9.748,
          "end": 11.376
        },
        {
          "text": "er bellt, um sich zu schützen",
          "start": 11.376,
          "end": 13.112
        }
      ]
    },
    {
      "id": "s4",
      "start": 13.112,
      "end": 17.56,
      "captions": [
        {
          "text": "Grund Nr. 3 ist Aufmerksamkeit,",
          "start": 13.112,
          "end": 15.068
        },
        {
          "text": "weil Bellen früher",
          "start": 15.068,
          "end": 16.247
        },
        {
          "text": "schon funktioniert hat",
          "start": 16.247,
          "end": 17.56
        }
      ]
    },
    {
      "id": "s5",
      "start": 17.56,
      "end": 21.47,
      "captions": [
        {
          "text": "Grund Nr. 4 ist Langeweile,",
          "start": 17.56,
          "end": 19.185
        },
        {
          "text": "und zwar genau wie",
          "start": 19.185,
          "end": 20.455
        },
        {
          "text": "bei uns Menschen",
          "start": 20.455,
          "end": 21.47
        }
      ]
    },
    {
      "id": "s6",
      "start": 21.47,
      "end": 24.523,
      "captions": [
        {
          "text": "ihm fehlt einfach geistige",
          "start": 21.47,
          "end": 23.082
        },
        {
          "text": "und körperliche Auslastung",
          "start": 23.082,
          "end": 24.523
        }
      ]
    },
    {
      "id": "s7",
      "start": 24.523,
      "end": 28.672,
      "captions": [
        {
          "text": "Grund Nr. 5 ist Frustration,",
          "start": 24.523,
          "end": 26.239
        },
        {
          "text": "auch das kennen wir",
          "start": 26.239,
          "end": 27.417
        },
        {
          "text": "Menschen nur zu gut",
          "start": 27.417,
          "end": 28.672
        }
      ]
    },
    {
      "id": "s8",
      "start": 28.672,
      "end": 32.349,
      "captions": [
        {
          "text": "zum Beispiel an der Leine,",
          "start": 28.672,
          "end": 30.008
        },
        {
          "text": "wenn er andere Hunde sieht",
          "start": 30.008,
          "end": 31.445
        },
        {
          "text": "und nicht hin darf",
          "start": 31.445,
          "end": 32.349
        }
      ]
    },
    {
      "id": "s9",
      "start": 32.349,
      "end": 36.895,
      "captions": [
        {
          "text": "hol dir jetzt",
          "start": 32.349,
          "end": 33.136
        },
        {
          "text": "meinen kostenlosen Anti‑Bell‑Plan,",
          "start": 33.136,
          "end": 35.258
        },
        {
          "text": "der Link ist in meiner Bio",
          "start": 35.258,
          "end": 36.895
        }
      ]
    }
  ]
}