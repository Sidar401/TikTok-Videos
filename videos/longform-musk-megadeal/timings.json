{"dauer": 162.8, "saetze": [{"id": "s1", "start": 0.0, "end": 3.007, "captions": [{"text": "Elon Musk plant den größten", "start": 0.0, "end": 1.58}, {"text": "Firmen‑Deal der Geschichte", "start": 1.58, "end": 3.007}]}, {"id": "s2", "start": 3.007, "end": 9.316, "captions": [{"text": "Er will Tesla und SpaceX", "start": 3.007, "end": 4.518}, {"text": "zu einem einzigen", "start": 4.518, "end": 5.655}, {"text": "Konzern machen,", "start": 5.655, "end": 6.578}, {"text": "zusammen wären das rund", "start": 6.578, "end": 8.117}, {"text": "3,5 Billionen Dollar", "start": 8.117, "end": 9.316}]}, {"id": "s3", "start": 9.316, "end": 13.533, "captions": [{"text": "Schreib uns in die Kommentare,", "start": 9.316, "end": 10.736}, {"text": "ob du dann Aktionär von dieser", "start": 10.736, "end": 12.296}, {"text": "Musk‑Firma werden würdest", "start": 12.296, "end": 13.533}]}, {"id": "s4", "start": 13.533, "end": 18.059, "captions": [{"text": "Folge HundeFinanzTv,", "start": 13.533, "end": 14.968}, {"text": "wir bringen dir jeden Tag", "start": 14.968, "end": 16.772}, {"text": "die wichtigsten Geld‑News", "start": 16.772, "end": 18.059}]}, {"id": "s5", "start": 18.059, "end": 21.238, "captions": [{"text": "Laut der Nachrichtenagentur", "start": 18.059, "end": 19.399}, {"text": "Bloomberg kommen", "start": 19.399, "end": 20.192}, {"text": "die Gespräche gut voran", "start": 20.192, "end": 21.238}]}, {"id": "s6", "start": 21.238, "end": 26.268, "captions": [{"text": "Eine Ankündigung könnte", "start": 21.238, "end": 22.866}, {"text": "schon im Dezember kommen,", "start": 22.866, "end": 24.701}, {"text": "spätestens Anfang 2027", "start": 24.701, "end": 26.268}]}, {"id": "s7", "start": 26.268, "end": 33.489, "captions": [{"text": "Zum Vergleich: Den bisherigen", "start": 26.268, "end": 27.897}, {"text": "Rekord hält Vodafone,", "start": 27.897, "end": 29.188}, {"text": "das im Jahr 2000 Mannesmann", "start": 29.188, "end": 30.848}, {"text": "für rund 180 Milliarden", "start": 30.848, "end": 32.263}, {"text": "Dollar übernommen hat", "start": 32.263, "end": 33.489}]}, {"id": "s8", "start": 33.489, "end": 36.574, "captions": [{"text": "Tesla allein ist heute mehr", "start": 33.489, "end": 35.176}, {"text": "als 8-mal so viel wert", "start": 35.176, "end": 36.574}]}, {"id": "s9", "start": 36.574, "end": 38.565, "captions": [{"text": "Aber warum will", "start": 36.574, "end": 37.363}, {"text": "Musk das überhaupt?", "start": 37.363, "end": 38.565}]}, {"id": "s10", "start": 38.565, "end": 43.947, "captions": [{"text": "SpaceX ist seit", "start": 38.565, "end": 39.047}, {"text": "Juni an der Börse,", "start": 39.047, "end": 40.29}, {"text": "mit dem größten Börsengang,", "start": 40.29, "end": 42.153}, {"text": "den Amerika je gesehen hat", "start": 42.153, "end": 43.947}]}, {"id": "s11", "start": 43.947, "end": 49.642, "captions": [{"text": "Heute ist die Firma rund", "start": 43.947, "end": 45.508}, {"text": "2 Billionen Dollar wert,", "start": 45.508, "end": 47.211}, {"text": "also mehr als Tesla", "start": 47.211, "end": 48.447}, {"text": "mit rund 1,5 Billionen", "start": 48.447, "end": 49.642}]}, {"id": "s12", "start": 49.642, "end": 54.157, "captions": [{"text": "Im Februar hat SpaceX außerdem", "start": 49.642, "end": 51.91}, {"text": "Musks KI‑Firma xAI geschluckt", "start": 51.91, "end": 54.157}]}, {"id": "s13", "start": 54.157, "end": 58.194, "captions": [{"text": "Das Herz von SpaceX", "start": 54.157, "end": 55.352}, {"text": "ist aber Starlink,", "start": 55.352, "end": 56.65}, {"text": "das Internet aus dem All", "start": 56.65, "end": 58.194}]}, {"id": "s14", "start": 58.194, "end": 64.243, "captions": [{"text": "Starlink hat letztes", "start": 58.194, "end": 59.356}, {"text": "Jahr über 11 Milliarden", "start": 59.356, "end": 60.976}, {"text": "Dollar umgesetzt,", "start": 60.976, "end": 62.062}, {"text": "das sind rund 60 %", "start": 62.062, "end": 63.277}, {"text": "vom ganzen Umsatz", "start": 63.277, "end": 64.243}]}, {"id": "s15", "start": 64.243, "end": 65.102, "captions": [{"text": "Und Tesla?", "start": 64.243, "end": 65.102}]}, {"id": "s16", "start": 65.102, "end": 70.577, "captions": [{"text": "Tesla steckt im Umbau:", "start": 65.102, "end": 66.574}, {"text": "Der Cybertruck wird Mitte", "start": 66.574, "end": 68.623}, {"text": "2027 in Texas eingestellt", "start": 68.623, "end": 70.577}]}, {"id": "s17", "start": 70.577, "end": 76.39, "captions": [{"text": "Stattdessen setzt Musk", "start": 70.577, "end": 71.96}, {"text": "auf das Robotaxi Cybercab,", "start": 71.96, "end": 73.711}, {"text": "auf Roboter", "start": 73.711, "end": 74.478}, {"text": "und auf künstliche Intelligenz", "start": 74.478, "end": 76.39}]}, {"id": "s18", "start": 76.39, "end": 81.395, "captions": [{"text": "Musks Idee: Raketen,", "start": 76.39, "end": 77.886}, {"text": "Satelliten,", "start": 77.886, "end": 78.899}, {"text": "KI und Autos unter einem Dach", "start": 78.899, "end": 81.395}]}, {"id": "s19", "start": 81.395, "end": 83.606, "captions": [{"text": "Er ist schon heute", "start": 81.395, "end": 82.366}, {"text": "Chef von beiden Firmen", "start": 82.366, "end": 83.606}]}, {"id": "s20", "start": 83.606, "end": 86.048, "captions": [{"text": "Er selbst nennt", "start": 83.606, "end": 84.491}, {"text": "die Fusion eine gute Idee", "start": 84.491, "end": 86.048}]}, {"id": "s21", "start": 86.048, "end": 88.009, "captions": [{"text": "Doch es gibt drei große Hürden", "start": 86.048, "end": 88.009}]}, {"id": "s22", "start": 88.009, "end": 94.884, "captions": [{"text": "Erstens: China. Tesla baut", "start": 88.009, "end": 89.434}, {"text": "viele Autos in Shanghai,", "start": 89.434, "end": 90.987}, {"text": "SpaceX arbeitet eng", "start": 90.987, "end": 92.259}, {"text": "mit dem amerikanischen", "start": 92.259, "end": 93.832}, {"text": "Militär zusammen", "start": 93.832, "end": 94.884}]}, {"id": "s23", "start": 94.884, "end": 96.509, "captions": [{"text": "Das passt nur schwer zusammen", "start": 94.884, "end": 96.509}]}, {"id": "s24", "start": 96.509, "end": 103.221, "captions": [{"text": "Zweitens: die Abstimmung.", "start": 96.509, "end": 97.849}, {"text": "Mehr als die Hälfte aller", "start": 97.849, "end": 99.154}, {"text": "Tesla‑Aktien muss zustimmen,", "start": 99.154, "end": 100.996}, {"text": "nicht nur die Hälfte derer,", "start": 100.996, "end": 102.584}, {"text": "die abstimmen", "start": 102.584, "end": 103.221}]}, {"id": "s25", "start": 103.221, "end": 106.0, "captions": [{"text": "Musk selbst nennt", "start": 103.221, "end": 104.215}, {"text": "das eine ziemlich hohe Hürde", "start": 104.215, "end": 106.0}]}, {"id": "s26", "start": 106.0, "end": 107.514, "captions": [{"text": "Drittens: die Macht", "start": 106.0, "end": 107.514}]}, {"id": "s27", "start": 107.514, "end": 111.007, "captions": [{"text": "Normalerweise gilt", "start": 107.514, "end": 108.7}, {"text": "an der Börse: eine Aktie,", "start": 108.7, "end": 110.411}, {"text": "eine Stimme", "start": 110.411, "end": 111.007}]}, {"id": "s28", "start": 111.007, "end": 116.175, "captions": [{"text": "Laut der Bank Barclays", "start": 111.007, "end": 112.394}, {"text": "würde Musk nach der Fusion", "start": 112.394, "end": 114.294}, {"text": "rund 37 % der Firma besitzen", "start": 114.294, "end": 116.175}]}, {"id": "s29", "start": 116.175, "end": 121.936, "captions": [{"text": "Weil seine SpaceX‑Aktien", "start": 116.175, "end": 117.722}, {"text": "aber 10-faches", "start": 117.722, "end": 118.792}, {"text": "Stimmrecht haben,", "start": 118.792, "end": 120.005}, {"text": "hätte er rund", "start": 120.005, "end": 120.932}, {"text": "56 % der Stimmen", "start": 120.932, "end": 121.936}]}, {"id": "s30", "start": 121.936, "end": 124.347, "captions": [{"text": "Er könnte also fast", "start": 121.936, "end": 123.0}, {"text": "alles allein entscheiden", "start": 123.0, "end": 124.347}]}, {"id": "s31", "start": 124.347, "end": 126.378, "captions": [{"text": "Was heißt", "start": 124.347, "end": 124.836}, {"text": "das für Tesla‑Aktionäre?", "start": 124.836, "end": 126.378}]}, {"id": "s32", "start": 126.378, "end": 129.723, "captions": [{"text": "Sie würden ihre Tesla‑Aktien", "start": 126.378, "end": 128.039}, {"text": "gegen SpaceX‑Aktien tauschen", "start": 128.039, "end": 129.723}]}, {"id": "s33", "start": 129.723, "end": 135.453, "captions": [{"text": "Analysten erwarten,", "start": 129.723, "end": 130.742}, {"text": "dass SpaceX dafür", "start": 130.742, "end": 131.827}, {"text": "einen Aufschlag zahlen muss,", "start": 131.827, "end": 133.497}, {"text": "sonst stimmen", "start": 133.497, "end": 134.328}, {"text": "die Aktionäre kaum zu", "start": 134.328, "end": 135.453}]}, {"id": "s34", "start": 135.453, "end": 140.216, "captions": [{"text": "Und auch in Deutschland", "start": 135.453, "end": 136.645}, {"text": "hängt viel dran: Tesla", "start": 136.645, "end": 137.691}, {"text": "baut seine Autos auch", "start": 137.691, "end": 138.976}, {"text": "in Grünheide bei Berlin", "start": 138.976, "end": 140.216}]}, {"id": "s35", "start": 140.216, "end": 146.831, "captions": [{"text": "Wer also Tesla hat", "start": 140.216, "end": 141.327}, {"text": "oder einen Welt‑ETF besitzt,", "start": 141.327, "end": 143.315}, {"text": "der Tesla enthält,", "start": 143.315, "end": 144.593}, {"text": "ist von diesem Deal", "start": 144.593, "end": 145.931}, {"text": "direkt betroffen", "start": 145.931, "end": 146.831}]}, {"id": "s36", "start": 146.831, "end": 151.289, "captions": [{"text": "Noch ist aber nichts", "start": 146.831, "end": 147.731}, {"text": "unterschrieben,", "start": 147.731, "end": 148.582}, {"text": "und beide Firmen haben", "start": 148.582, "end": 149.773}, {"text": "die Berichte nicht kommentiert", "start": 149.773, "end": 151.289}]}, {"id": "s37", "start": 151.289, "end": 157.634, "captions": [{"text": "Eins ist klar:", "start": 151.289, "end": 151.922}, {"text": "Wenn dieser Deal kommt,", "start": 151.922, "end": 153.013}, {"text": "sitzt ein einziger", "start": 153.013, "end": 154.066}, {"text": "Mann an der Spitze", "start": 154.066, "end": 155.119}, {"text": "von einem der wertvollsten", "start": 155.119, "end": 156.64}, {"text": "Konzerne der Welt", "start": 156.64, "end": 157.634}]}, {"id": "s38", "start": 157.634, "end": 162.197, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 157.634, "end": 158.993}, {"text": "keine Anlageberatung,", "start": 158.993, "end": 160.667}, {"text": "nur eine Erklärung", "start": 160.667, "end": 162.197}]}]}