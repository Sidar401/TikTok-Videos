{"dauer": 196.62, "saetze": [{"id": "s1", "start": 0.0, "end": 5.147, "captions": [{"text": "Ab Juli 2027 darfst", "start": 0.0, "end": 1.541}, {"text": "du in Deutschland nicht", "start": 1.541, "end": 3.407}, {"text": "mehr alles bar bezahlen", "start": 3.407, "end": 5.147}]}, {"id": "s2", "start": 5.147, "end": 9.277, "captions": [{"text": "Eine neue EU-Regel setzt", "start": 5.147, "end": 7.261}, {"text": "eine Grenze von 10.000 €", "start": 7.261, "end": 9.277}]}, {"id": "s3", "start": 9.277, "end": 16.033, "captions": [{"text": "Schreib uns in die Kommentare,", "start": 9.277, "end": 11.184}, {"text": "ob du selbst noch oft", "start": 11.184, "end": 12.613}, {"text": "mit Bargeld bezahlst,", "start": 12.613, "end": 14.018}, {"text": "oder kommentier", "start": 14.018, "end": 15.039}, {"text": "einfach mit „Bargeld“", "start": 15.039, "end": 16.033}]}, {"id": "s4", "start": 16.033, "end": 20.601, "captions": [{"text": "Viele lesen jetzt: Das Bargeld wird", "start": 16.033, "end": 18.489}, {"text": "abgeschafft. Das stimmt nicht", "start": 18.489, "end": 20.601}]}, {"id": "s5", "start": 20.601, "end": 25.469, "captions": [{"text": "Aber es ändert sich", "start": 20.601, "end": 21.887}, {"text": "trotzdem einiges,", "start": 21.887, "end": 23.07}, {"text": "und das schauen wir", "start": 23.07, "end": 24.393}, {"text": "uns jetzt genau an", "start": 24.393, "end": 25.469}]}, {"id": "s6", "start": 25.469, "end": 29.418, "captions": [{"text": "Die Regel steht", "start": 25.469, "end": 26.345}, {"text": "in einer neuen EU-Verordnung", "start": 26.345, "end": 28.38}, {"text": "gegen Geldwäsche", "start": 28.38, "end": 29.418}]}, {"id": "s7", "start": 29.418, "end": 36.562, "captions": [{"text": "Sie gilt ab", "start": 29.418, "end": 30.465}, {"text": "dem 10. Juli 2027,", "start": 30.465, "end": 32.731}, {"text": "und zwar direkt", "start": 32.731, "end": 34.271}, {"text": "in allen 27 EU-Ländern", "start": 34.271, "end": 36.562}]}, {"id": "s8", "start": 36.562, "end": 39.62, "captions": [{"text": "Deutschland muss dafür kein", "start": 36.562, "end": 38.226}, {"text": "eigenes Gesetz mehr machen", "start": 38.226, "end": 39.62}]}, {"id": "s9", "start": 39.62, "end": 41.317, "captions": [{"text": "Was genau wird verboten?", "start": 39.62, "end": 41.317}]}, {"id": "s10", "start": 41.317, "end": 48.661, "captions": [{"text": "Barzahlungen über 10.000 €", "start": 41.317, "end": 43.063}, {"text": "an Händler und Firmen,", "start": 43.063, "end": 44.695}, {"text": "also wenn du Waren kaufst", "start": 44.695, "end": 46.437}, {"text": "oder Dienstleistungen bezahlst", "start": 46.437, "end": 48.661}]}, {"id": "s11", "start": 48.661, "end": 56.251, "captions": [{"text": "Ein Beispiel:", "start": 48.661, "end": 49.623}, {"text": "Du willst beim Autohändler", "start": 49.623, "end": 51.279}, {"text": "einen Gebrauchtwagen", "start": 51.279, "end": 52.791}, {"text": "für 15.000 € bar bezahlen.", "start": 52.791, "end": 54.757}, {"text": "Das geht dann nicht mehr", "start": 54.757, "end": 56.251}]}, {"id": "s12", "start": 56.251, "end": 62.434, "captions": [{"text": "Und schon ab 3.000 €", "start": 56.251, "end": 57.604}, {"text": "müssen bestimmte Händler", "start": 57.604, "end": 59.381}, {"text": "deinen Ausweis prüfen,", "start": 59.381, "end": 60.95}, {"text": "zum Beispiel Autohäuser", "start": 60.95, "end": 62.434}]}, {"id": "s13", "start": 62.434, "end": 63.881, "captions": [{"text": "Was bleibt erlaubt?", "start": 62.434, "end": 63.881}]}, {"id": "s14", "start": 63.881, "end": 67.503, "captions": [{"text": "Bargeld zu Hause", "start": 63.881, "end": 64.959}, {"text": "haben bleibt erlaubt,", "start": 64.959, "end": 66.639}, {"text": "egal wie viel", "start": 66.639, "end": 67.503}]}, {"id": "s15", "start": 67.503, "end": 69.756, "captions": [{"text": "Bargeld sparen bleibt erlaubt", "start": 67.503, "end": 69.756}]}, {"id": "s16", "start": 69.756, "end": 73.381, "captions": [{"text": "Und Geschäfte von privat", "start": 69.756, "end": 71.344}, {"text": "zu privat sind nicht betroffen", "start": 71.344, "end": 73.381}]}, {"id": "s17", "start": 73.381, "end": 77.509, "captions": [{"text": "Kaufst du also", "start": 73.381, "end": 74.199}, {"text": "das Auto vom Nachbarn,", "start": 74.199, "end": 75.646}, {"text": "darfst du weiterhin", "start": 75.646, "end": 76.895}, {"text": "bar bezahlen", "start": 76.895, "end": 77.509}]}, {"id": "s18", "start": 77.509, "end": 82.655, "captions": [{"text": "Folge HundeFinanzTv,", "start": 77.509, "end": 78.911}, {"text": "wir bringen dir jeden Tag", "start": 78.911, "end": 80.862}, {"text": "die wichtigsten Geld‑News", "start": 80.862, "end": 82.655}]}, {"id": "s19", "start": 82.655, "end": 84.595, "captions": [{"text": "Warum macht die EU", "start": 82.655, "end": 83.697}, {"text": "das überhaupt?", "start": 83.697, "end": 84.595}]}, {"id": "s20", "start": 84.595, "end": 88.007, "captions": [{"text": "Große Summen in bar sind", "start": 84.595, "end": 86.274}, {"text": "schwer nachzuverfolgen", "start": 86.274, "end": 88.007}]}, {"id": "s21", "start": 88.007, "end": 93.498, "captions": [{"text": "Genau das nutzen Kriminelle,", "start": 88.007, "end": 89.875}, {"text": "um Geld aus Drogenhandel", "start": 89.875, "end": 91.546}, {"text": "oder Betrug sauber zu waschen", "start": 91.546, "end": 93.498}]}, {"id": "s22", "start": 93.498, "end": 99.303, "captions": [{"text": "Und Deutschland", "start": 93.498, "end": 94.369}, {"text": "gilt dafür seit Jahren", "start": 94.369, "end": 95.743}, {"text": "als besonders beliebt,", "start": 95.743, "end": 97.117}, {"text": "weil es hier bisher", "start": 97.117, "end": 98.304}, {"text": "keine Grenze gab", "start": 98.304, "end": 99.303}]}, {"id": "s23", "start": 99.303, "end": 102.443, "captions": [{"text": "In anderen Ländern ist", "start": 99.303, "end": 100.811}, {"text": "es längst viel strenger", "start": 100.811, "end": 102.443}]}, {"id": "s24", "start": 102.443, "end": 108.8, "captions": [{"text": "In Frankreich und Spanien", "start": 102.443, "end": 104.366}, {"text": "liegt die Grenze bei 1.000 €,", "start": 104.366, "end": 106.615}, {"text": "in Griechenland", "start": 106.615, "end": 107.809}, {"text": "sogar bei 500 €", "start": 107.809, "end": 108.8}]}, {"id": "s25", "start": 108.8, "end": 113.148, "captions": [{"text": "Im Vergleich dazu sind", "start": 108.8, "end": 110.682}, {"text": "10.000 € also eher großzügig", "start": 110.682, "end": 113.148}]}, {"id": "s26", "start": 113.148, "end": 115.399, "captions": [{"text": "Und manches gibt es", "start": 113.148, "end": 114.276}, {"text": "bei uns schon heute", "start": 114.276, "end": 115.399}]}, {"id": "s27", "start": 115.399, "end": 120.344, "captions": [{"text": "Immobilien darfst", "start": 115.399, "end": 116.56}, {"text": "du in Deutschland seit", "start": 116.56, "end": 118.316}, {"text": "2023 nicht mehr bar bezahlen", "start": 118.316, "end": 120.344}]}, {"id": "s28", "start": 120.344, "end": 124.337, "captions": [{"text": "Gold kannst du ohne Ausweis", "start": 120.344, "end": 122.357}, {"text": "nur bis knapp 2.000 € kaufen", "start": 122.357, "end": 124.337}]}, {"id": "s29", "start": 124.337, "end": 131.158, "captions": [{"text": "Und wer mit 10.000 €", "start": 124.337, "end": 125.666}, {"text": "oder mehr in bar die EU", "start": 125.666, "end": 127.551}, {"text": "verlässt oder einreist,", "start": 127.551, "end": 129.358}, {"text": "muss das beim Zoll anmelden", "start": 129.358, "end": 131.158}]}, {"id": "s30", "start": 131.158, "end": 133.949, "captions": [{"text": "Wie wichtig ist", "start": 131.158, "end": 132.293}, {"text": "Bargeld überhaupt noch?", "start": 132.293, "end": 133.949}]}, {"id": "s31", "start": 133.949, "end": 140.135, "captions": [{"text": "Laut Bundesbank wurden", "start": 133.949, "end": 136.067}, {"text": "2025 nur noch 45 % aller", "start": 136.067, "end": 138.379}, {"text": "Einkäufe bar bezahlt", "start": 138.379, "end": 140.135}]}, {"id": "s32", "start": 140.135, "end": 143.021, "captions": [{"text": "Das ist das erste Mal", "start": 140.135, "end": 141.562}, {"text": "weniger als die Hälfte", "start": 141.562, "end": 143.021}]}, {"id": "s33", "start": 143.021, "end": 148.185, "captions": [{"text": "Gleichzeitig sagen 80 %:", "start": 143.021, "end": 144.753}, {"text": "Es ist ihnen wichtig,", "start": 144.753, "end": 146.235}, {"text": "weiter bar zahlen zu können", "start": 146.235, "end": 148.185}]}, {"id": "s34", "start": 148.185, "end": 155.231, "captions": [{"text": "Und es gibt immer", "start": 148.185, "end": 149.491}, {"text": "weniger Geldautomaten,", "start": 149.491, "end": 151.492}, {"text": "von 57.000 auf rund", "start": 151.492, "end": 153.221}, {"text": "50.000 in nur 4 Jahren", "start": 153.221, "end": 155.231}]}, {"id": "s35", "start": 155.231, "end": 156.604, "captions": [{"text": "Was heißt das für dich?", "start": 155.231, "end": 156.604}]}, {"id": "s36", "start": 156.604, "end": 162.588, "captions": [{"text": "Für fast alle ändert sich", "start": 156.604, "end": 158.298}, {"text": "im Alltag nichts. Wer", "start": 158.298, "end": 159.793}, {"text": "zahlt schon im Supermarkt", "start": 159.793, "end": 161.739}, {"text": "10.000 € bar?", "start": 161.739, "end": 162.588}]}, {"id": "s37", "start": 162.588, "end": 164.796, "captions": [{"text": "Aber 3 Dinge", "start": 162.588, "end": 163.576}, {"text": "solltest du wissen", "start": 163.576, "end": 164.796}]}, {"id": "s38", "start": 164.796, "end": 171.253, "captions": [{"text": "Erstens: Planst", "start": 164.796, "end": 165.65}, {"text": "du einen großen", "start": 165.65, "end": 166.663}, {"text": "Kauf beim Händler,", "start": 166.663, "end": 167.982}, {"text": "zum Beispiel ein Auto,", "start": 167.982, "end": 169.558}, {"text": "plane eine Überweisung ein", "start": 169.558, "end": 171.253}]}, {"id": "s39", "start": 171.253, "end": 180.21, "captions": [{"text": "Zweitens: Zahlst du viel", "start": 171.253, "end": 172.577}, {"text": "Bargeld bei der Bank ein,", "start": 172.577, "end": 174.349}, {"text": "kann die Bank", "start": 174.349, "end": 175.27}, {"text": "nach der Herkunft fragen.", "start": 175.27, "end": 176.874}, {"text": "Heb also Belege auf,", "start": 176.874, "end": 178.291}, {"text": "zum Beispiel einen Kaufvertrag", "start": 178.291, "end": 180.21}]}, {"id": "s40", "start": 180.21, "end": 185.169, "captions": [{"text": "Drittens: Ein kleiner", "start": 180.21, "end": 181.451}, {"text": "Notvorrat in bar zu Hause", "start": 181.451, "end": 183.383}, {"text": "ist weiterhin völlig okay", "start": 183.383, "end": 185.169}]}, {"id": "s41", "start": 185.169, "end": 191.446, "captions": [{"text": "Merk dir: Bargeld wird", "start": 185.169, "end": 186.426}, {"text": "nicht abgeschafft,", "start": 186.426, "end": 187.773}, {"text": "nur große Barzahlungen", "start": 187.773, "end": 189.419}, {"text": "an Händler", "start": 189.419, "end": 190.167}, {"text": "bekommen eine Grenze", "start": 190.167, "end": 191.446}]}, {"id": "s42", "start": 191.446, "end": 196.026, "captions": [{"text": "Kurzer Hinweis: Das ist", "start": 191.446, "end": 192.929}, {"text": "keine Anlageberatung,", "start": 192.929, "end": 194.596}, {"text": "nur eine Erklärung", "start": 194.596, "end": 196.026}]}]}