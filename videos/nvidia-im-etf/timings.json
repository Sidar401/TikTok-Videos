{
  "dauer": 70.37,
  "saetze": [
    {
      "id": "s1",
      "start": 0.0,
      "end": 4.036,
      "captions": [
        {
          "text": "Du hast einen ETF‑Sparplan",
          "start": 0.0,
          "end": 1.649
        },
        {
          "text": "und denkst,",
          "start": 1.649,
          "end": 2.347
        },
        {
          "text": "dein Geld ist schön verteilt?",
          "start": 2.347,
          "end": 4.036
        }
      ]
    },
    {
      "id": "s2",
      "start": 4.036,
      "end": 7.162,
      "captions": [
        {
          "text": "Dann schau mal,",
          "start": 4.036,
          "end": 4.761
        },
        {
          "text": "wie viel davon",
          "start": 4.761,
          "end": 5.578
        },
        {
          "text": "an einer einzigen Firma hängt",
          "start": 5.578,
          "end": 7.162
        }
      ]
    },
    {
      "id": "s3",
      "start": 7.162,
      "end": 9.793,
      "captions": [
        {
          "text": "Kurzer Hinweis: Das ist",
          "start": 7.162,
          "end": 8.567
        },
        {
          "text": "keine Anlageberatung",
          "start": 8.567,
          "end": 9.793
        }
      ]
    },
    {
      "id": "s4",
      "start": 9.793,
      "end": 17.007,
      "captions": [
        {
          "text": "Im MSCI World,",
          "start": 9.793,
          "end": 10.824
        },
        {
          "text": "dem beliebtesten",
          "start": 10.824,
          "end": 12.189
        },
        {
          "text": "ETF in Deutschland,",
          "start": 12.189,
          "end": 13.811
        },
        {
          "text": "stecken über 1.300 Firmen",
          "start": 13.811,
          "end": 15.944
        },
        {
          "text": "aus 23 Ländern",
          "start": 15.944,
          "end": 17.007
        }
      ]
    },
    {
      "id": "s5",
      "start": 17.007,
      "end": 20.779,
      "captions": [
        {
          "text": "Aber die größte Firma",
          "start": 17.007,
          "end": 18.532
        },
        {
          "text": "darin ist Nvidia,",
          "start": 18.532,
          "end": 19.873
        },
        {
          "text": "mit knapp 6 %",
          "start": 19.873,
          "end": 20.779
        }
      ]
    },
    {
      "id": "s6",
      "start": 20.779,
      "end": 25.737,
      "captions": [
        {
          "text": "Von 100 € in deinem Sparplan",
          "start": 20.779,
          "end": 22.651
        },
        {
          "text": "gehen also knapp 6 €",
          "start": 22.651,
          "end": 24.074
        },
        {
          "text": "an eine einzige Chipfirma",
          "start": 24.074,
          "end": 25.737
        }
      ]
    },
    {
      "id": "s7",
      "start": 25.737,
      "end": 32.869,
      "captions": [
        {
          "text": "Und die zehn größten",
          "start": 25.737,
          "end": 27.094
        },
        {
          "text": "Firmen zusammen,",
          "start": 27.094,
          "end": 28.27
        },
        {
          "text": "fast nur USA‑Technik",
          "start": 28.27,
          "end": 29.741
        },
        {
          "text": "wie Apple und Microsoft,",
          "start": 29.741,
          "end": 31.506
        },
        {
          "text": "machen fast 28 % aus",
          "start": 31.506,
          "end": 32.869
        }
      ]
    },
    {
      "id": "s8",
      "start": 32.869,
      "end": 35.598,
      "captions": [
        {
          "text": "Schick das jemandem,",
          "start": 32.869,
          "end": 34.078
        },
        {
          "text": "der einen ETF‑Sparplan hat",
          "start": 34.078,
          "end": 35.598
        }
      ]
    },
    {
      "id": "s9",
      "start": 35.598,
      "end": 41.79,
      "captions": [
        {
          "text": "Jetzt rechnen wir:",
          "start": 35.598,
          "end": 36.629
        },
        {
          "text": "Fällt Nvidia um 10 %,",
          "start": 36.629,
          "end": 37.983
        },
        {
          "text": "verliert dein ETF",
          "start": 37.983,
          "end": 39.217
        },
        {
          "text": "allein dadurch rund",
          "start": 39.217,
          "end": 40.596
        },
        {
          "text": "ein halbes Prozent",
          "start": 40.596,
          "end": 41.79
        }
      ]
    },
    {
      "id": "s10",
      "start": 41.79,
      "end": 46.144,
      "captions": [
        {
          "text": "Bei 10.000 € sind",
          "start": 41.79,
          "end": 42.989
        },
        {
          "text": "das schon fast 60 €,",
          "start": 42.989,
          "end": 44.533
        },
        {
          "text": "nur wegen einer Aktie",
          "start": 44.533,
          "end": 46.144
        }
      ]
    },
    {
      "id": "s11",
      "start": 46.144,
      "end": 51.784,
      "captions": [
        {
          "text": "Und genau das ist",
          "start": 46.144,
          "end": 47.379
        },
        {
          "text": "gerade passiert: Nvidia",
          "start": 47.379,
          "end": 48.847
        },
        {
          "text": "ist in nur zwei Tagen",
          "start": 48.847,
          "end": 50.372
        },
        {
          "text": "um rund 10 % gefallen",
          "start": 50.372,
          "end": 51.784
        }
      ]
    },
    {
      "id": "s12",
      "start": 51.784,
      "end": 55.15,
      "captions": [
        {
          "text": "Seit dem Rekord im Oktober",
          "start": 51.784,
          "end": 53.602
        },
        {
          "text": "sind es sogar rund 30 %",
          "start": 53.602,
          "end": 55.15
        }
      ]
    },
    {
      "id": "s13",
      "start": 55.15,
      "end": 60.819,
      "captions": [
        {
          "text": "Ist dein ETF deshalb",
          "start": 55.15,
          "end": 56.365
        },
        {
          "text": "schlecht? Nein,",
          "start": 56.365,
          "end": 57.169
        },
        {
          "text": "er ist trotzdem viel breiter",
          "start": 57.169,
          "end": 59.001
        },
        {
          "text": "gestreut als einzelne Aktien",
          "start": 59.001,
          "end": 60.819
        }
      ]
    },
    {
      "id": "s14",
      "start": 60.819,
      "end": 64.557,
      "captions": [
        {
          "text": "Aber du solltest wissen,",
          "start": 60.819,
          "end": 62.235
        },
        {
          "text": "wie stark er an wenigen",
          "start": 62.235,
          "end": 63.695
        },
        {
          "text": "KI‑Firmen hängt",
          "start": 63.695,
          "end": 64.557
        }
      ]
    },
    {
      "id": "s15",
      "start": 64.557,
      "end": 69.767,
      "captions": [
        {
          "text": "Warum Nvidia",
          "start": 64.557,
          "end": 65.196
        },
        {
          "text": "gerade so abstürzt,",
          "start": 65.196,
          "end": 66.349
        },
        {
          "text": "zeigen wir dir in einem ganzen",
          "start": 66.349,
          "end": 68.17
        },
        {
          "text": "Video bei uns auf dem Kanal",
          "start": 68.17,
          "end": 69.767
        }
      ]
    }
  ]
}