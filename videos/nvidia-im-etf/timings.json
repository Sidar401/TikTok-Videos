{
  "dauer": 69.1,
  "saetze": [
    {
      "id": "s1",
      "start": 0.0,
      "end": 3.722,
      "captions": [
        {
          "text": "Du hast einen ETF‑Sparplan",
          "start": 0.0,
          "end": 1.466
        },
        {
          "text": "und denkst,",
          "start": 1.466,
          "end": 2.087
        },
        {
          "text": "dein Geld ist schön verteilt?",
          "start": 2.087,
          "end": 3.722
        }
      ]
    },
    {
      "id": "s2",
      "start": 3.722,
      "end": 6.837,
      "captions": [
        {
          "text": "Dann schau mal,",
          "start": 3.722,
          "end": 4.528
        },
        {
          "text": "wie viel davon",
          "start": 4.528,
          "end": 5.279
        },
        {
          "text": "an einer einzigen Firma hängt",
          "start": 5.279,
          "end": 6.837
        }
      ]
    },
    {
      "id": "s3",
      "start": 6.837,
      "end": 9.476,
      "captions": [
        {
          "text": "Kurzer Hinweis: Das ist",
          "start": 6.837,
          "end": 8.249
        },
        {
          "text": "keine Anlageberatung",
          "start": 8.249,
          "end": 9.476
        }
      ]
    },
    {
      "id": "s4",
      "start": 9.476,
      "end": 16.048,
      "captions": [
        {
          "text": "Im MSCI World,",
          "start": 9.476,
          "end": 10.522
        },
        {
          "text": "dem beliebtesten",
          "start": 10.522,
          "end": 11.716
        },
        {
          "text": "ETF in Deutschland,",
          "start": 11.716,
          "end": 13.135
        },
        {
          "text": "stecken über 1.300 Firmen",
          "start": 13.135,
          "end": 15.002
        },
        {
          "text": "aus 23 Ländern",
          "start": 15.002,
          "end": 16.048
        }
      ]
    },
    {
      "id": "s5",
      "start": 16.048,
      "end": 19.815,
      "captions": [
        {
          "text": "Aber die größte Firma",
          "start": 16.048,
          "end": 17.599
        },
        {
          "text": "darin ist Nvidia,",
          "start": 17.599,
          "end": 18.855
        },
        {
          "text": "mit knapp 6 %",
          "start": 18.855,
          "end": 19.815
        }
      ]
    },
    {
      "id": "s6",
      "start": 19.815,
      "end": 24.762,
      "captions": [
        {
          "text": "Von 100 € in deinem Sparplan",
          "start": 19.815,
          "end": 21.712
        },
        {
          "text": "gehen also knapp 6 €",
          "start": 21.712,
          "end": 23.068
        },
        {
          "text": "an eine einzige Chipfirma",
          "start": 23.068,
          "end": 24.762
        }
      ]
    },
    {
      "id": "s7",
      "start": 24.762,
      "end": 31.974,
      "captions": [
        {
          "text": "Und die zehn größten",
          "start": 24.762,
          "end": 26.073
        },
        {
          "text": "Firmen zusammen,",
          "start": 26.073,
          "end": 27.122
        },
        {
          "text": "fast nur amerikanische Technik",
          "start": 27.122,
          "end": 29.089
        },
        {
          "text": "wie Apple und Microsoft,",
          "start": 29.089,
          "end": 30.663
        },
        {
          "text": "machen fast 28 % aus",
          "start": 30.663,
          "end": 31.974
        }
      ]
    },
    {
      "id": "s8",
      "start": 31.974,
      "end": 34.755,
      "captions": [
        {
          "text": "Schick das jemandem,",
          "start": 31.974,
          "end": 33.183
        },
        {
          "text": "der einen ETF‑Sparplan hat",
          "start": 33.183,
          "end": 34.755
        }
      ]
    },
    {
      "id": "s9",
      "start": 34.755,
      "end": 40.846,
      "captions": [
        {
          "text": "Jetzt rechnen wir:",
          "start": 34.755,
          "end": 35.934
        },
        {
          "text": "Fällt Nvidia um 10 %,",
          "start": 35.934,
          "end": 37.309
        },
        {
          "text": "verliert dein ETF",
          "start": 37.309,
          "end": 38.423
        },
        {
          "text": "allein dadurch rund",
          "start": 38.423,
          "end": 39.667
        },
        {
          "text": "ein halbes Prozent",
          "start": 39.667,
          "end": 40.846
        }
      ]
    },
    {
      "id": "s10",
      "start": 40.846,
      "end": 45.209,
      "captions": [
        {
          "text": "Bei 10.000 € sind",
          "start": 40.846,
          "end": 42.125
        },
        {
          "text": "das schon fast 60 €,",
          "start": 42.125,
          "end": 43.629
        },
        {
          "text": "nur wegen einer Aktie",
          "start": 43.629,
          "end": 45.209
        }
      ]
    },
    {
      "id": "s11",
      "start": 45.209,
      "end": 50.851,
      "captions": [
        {
          "text": "Und genau das ist",
          "start": 45.209,
          "end": 46.379
        },
        {
          "text": "gerade passiert: Nvidia",
          "start": 46.379,
          "end": 47.961
        },
        {
          "text": "ist in nur zwei Tagen",
          "start": 47.961,
          "end": 49.406
        },
        {
          "text": "um rund 10 % gefallen",
          "start": 49.406,
          "end": 50.851
        }
      ]
    },
    {
      "id": "s12",
      "start": 50.851,
      "end": 54.204,
      "captions": [
        {
          "text": "Seit dem Rekord im Oktober",
          "start": 50.851,
          "end": 52.63
        },
        {
          "text": "sind es sogar rund 30 %",
          "start": 52.63,
          "end": 54.204
        }
      ]
    },
    {
      "id": "s13",
      "start": 54.204,
      "end": 59.534,
      "captions": [
        {
          "text": "Ist dein ETF deshalb",
          "start": 54.204,
          "end": 55.379
        },
        {
          "text": "schlecht? Nein,",
          "start": 55.379,
          "end": 56.261
        },
        {
          "text": "er ist trotzdem viel breiter",
          "start": 56.261,
          "end": 57.906
        },
        {
          "text": "gestreut als einzelne Aktien",
          "start": 57.906,
          "end": 59.534
        }
      ]
    },
    {
      "id": "s14",
      "start": 59.534,
      "end": 63.298,
      "captions": [
        {
          "text": "Aber du solltest wissen,",
          "start": 59.534,
          "end": 60.98
        },
        {
          "text": "wie stark er an wenigen",
          "start": 60.98,
          "end": 62.383
        },
        {
          "text": "KI‑Firmen hängt",
          "start": 62.383,
          "end": 63.298
        }
      ]
    },
    {
      "id": "s15",
      "start": 63.298,
      "end": 68.504,
      "captions": [
        {
          "text": "Warum Nvidia",
          "start": 63.298,
          "end": 64.008
        },
        {
          "text": "gerade so abstürzt,",
          "start": 64.008,
          "end": 65.132
        },
        {
          "text": "zeigen wir dir in einem ganzen",
          "start": 65.132,
          "end": 66.907
        },
        {
          "text": "Video bei uns auf dem Kanal",
          "start": 66.907,
          "end": 68.504
        }
      ]
    }
  ]
}