{
  "dauer": 174.9,
  "saetze": [
    {
      "id": "s1",
      "start": 0.0,
      "end": 4.957,
      "captions": [
        {
          "text": "Ein Spionage‑Verdacht",
          "start": 0.0,
          "end": 1.144
        },
        {
          "text": "hat an nur zwei Tagen",
          "start": 1.144,
          "end": 2.288
        },
        {
          "text": "hunderte Milliarden Dollar",
          "start": 2.288,
          "end": 3.704
        },
        {
          "text": "an der Börse vernichtet",
          "start": 3.704,
          "end": 4.957
        }
      ]
    },
    {
      "id": "s2",
      "start": 4.957,
      "end": 10.753,
      "captions": [
        {
          "text": "Im Mittelpunkt steht",
          "start": 4.957,
          "end": 6.128
        },
        {
          "text": "ausgerechnet der Chef",
          "start": 6.128,
          "end": 7.357
        },
        {
          "text": "der wertvollsten",
          "start": 7.357,
          "end": 8.294
        },
        {
          "text": "Chipfirma der Welt:",
          "start": 8.294,
          "end": 9.406
        },
        {
          "text": "Jensen Huang von Nvidia",
          "start": 9.406,
          "end": 10.753
        }
      ]
    },
    {
      "id": "s3",
      "start": 10.753,
      "end": 15.74,
      "captions": [
        {
          "text": "Und auch wenn du nie",
          "start": 10.753,
          "end": 11.731
        },
        {
          "text": "eine Nvidia‑Aktie",
          "start": 11.731,
          "end": 12.562
        },
        {
          "text": "gekauft hast,",
          "start": 12.562,
          "end": 13.198
        },
        {
          "text": "steckt diese Firma sehr",
          "start": 13.198,
          "end": 14.322
        },
        {
          "text": "wahrscheinlich in deinem Geld",
          "start": 14.322,
          "end": 15.74
        }
      ]
    },
    {
      "id": "s4",
      "start": 15.74,
      "end": 21.955,
      "captions": [
        {
          "text": "Heute schauen wir uns an,",
          "start": 15.74,
          "end": 17.278
        },
        {
          "text": "was passiert ist,",
          "start": 17.278,
          "end": 18.324
        },
        {
          "text": "warum die Aktie abstürzt,",
          "start": 18.324,
          "end": 19.863
        },
        {
          "text": "und was das für deinen ETF",
          "start": 19.863,
          "end": 21.463
        },
        {
          "text": "bedeutet",
          "start": 21.463,
          "end": 21.955
        }
      ]
    },
    {
      "id": "s5",
      "start": 21.955,
      "end": 28.842,
      "captions": [
        {
          "text": "Wichtig vorweg: Das ist",
          "start": 21.955,
          "end": 23.253
        },
        {
          "text": "keine Anlageberatung,",
          "start": 23.253,
          "end": 24.439
        },
        {
          "text": "und alles, was wir zeigen,",
          "start": 24.439,
          "end": 25.907
        },
        {
          "text": "sind Berichte und Vorwürfe,",
          "start": 25.907,
          "end": 27.431
        },
        {
          "text": "nichts davon ist bewiesen",
          "start": 27.431,
          "end": 28.842
        }
      ]
    },
    {
      "id": "s6",
      "start": 28.842,
      "end": 30.567,
      "captions": [
        {
          "text": "Teil eins: der Verdacht",
          "start": 28.842,
          "end": 30.567
        }
      ]
    },
    {
      "id": "s7",
      "start": 30.567,
      "end": 37.579,
      "captions": [
        {
          "text": "Laut Berichten großer",
          "start": 30.567,
          "end": 31.804
        },
        {
          "text": "amerikanischer Medien hatte",
          "start": 31.804,
          "end": 33.395
        },
        {
          "text": "Jensen Huang eine enge private",
          "start": 33.395,
          "end": 35.163
        },
        {
          "text": "Beziehung zu einer Frau",
          "start": 35.163,
          "end": 36.518
        },
        {
          "text": "namens Alice Huang",
          "start": 36.518,
          "end": 37.579
        }
      ]
    },
    {
      "id": "s8",
      "start": 37.579,
      "end": 40.542,
      "captions": [
        {
          "text": "Die beiden sind",
          "start": 37.579,
          "end": 38.263
        },
        {
          "text": "nicht verwandt,",
          "start": 38.263,
          "end": 38.947
        },
        {
          "text": "sie haben nur",
          "start": 38.947,
          "end": 39.539
        },
        {
          "text": "den gleichen Nachnamen",
          "start": 39.539,
          "end": 40.542
        }
      ]
    },
    {
      "id": "s9",
      "start": 40.542,
      "end": 46.578,
      "captions": [
        {
          "text": "Alice Huang war",
          "start": 40.542,
          "end": 41.516
        },
        {
          "text": "Managerin bei Megaspeed,",
          "start": 41.516,
          "end": 43.073
        },
        {
          "text": "einer Firma aus Singapur,",
          "start": 43.073,
          "end": 44.696
        },
        {
          "text": "die KI‑Chips von Nvidia kauft",
          "start": 44.696,
          "end": 46.578
        }
      ]
    },
    {
      "id": "s10",
      "start": 46.578,
      "end": 51.688,
      "captions": [
        {
          "text": "Und amerikanische",
          "start": 46.578,
          "end": 47.464
        },
        {
          "text": "Geheimdienste vermuten:",
          "start": 47.464,
          "end": 48.664
        },
        {
          "text": "Sie soll für den chinesischen",
          "start": 48.664,
          "end": 50.176
        },
        {
          "text": "Geheimdienst gearbeitet haben",
          "start": 50.176,
          "end": 51.688
        }
      ]
    },
    {
      "id": "s11",
      "start": 51.688,
      "end": 56.625,
      "captions": [
        {
          "text": "China bestreitet das,",
          "start": 51.688,
          "end": 52.937
        },
        {
          "text": "und Nvidia sagt,",
          "start": 52.937,
          "end": 53.889
        },
        {
          "text": "es seien keine Geheimnisse",
          "start": 53.889,
          "end": 55.435
        },
        {
          "text": "weitergegeben worden",
          "start": 55.435,
          "end": 56.625
        }
      ]
    },
    {
      "id": "s12",
      "start": 56.625,
      "end": 58.242,
      "captions": [
        {
          "text": "Teil zwei: die Chips",
          "start": 56.625,
          "end": 58.242
        }
      ]
    },
    {
      "id": "s13",
      "start": 58.242,
      "end": 62.482,
      "captions": [
        {
          "text": "Moderne KI‑Chips dürfen",
          "start": 58.242,
          "end": 59.56
        },
        {
          "text": "aus Amerika nicht einfach",
          "start": 59.56,
          "end": 60.992
        },
        {
          "text": "nach China verkauft werden",
          "start": 60.992,
          "end": 62.482
        }
      ]
    },
    {
      "id": "s14",
      "start": 62.482,
      "end": 70.13,
      "captions": [
        {
          "text": "Der Verdacht ist,",
          "start": 62.482,
          "end": 63.467
        },
        {
          "text": "dass über Megaspeed",
          "start": 63.467,
          "end": 64.568
        },
        {
          "text": "trotzdem Chips nach China",
          "start": 64.568,
          "end": 66.016
        },
        {
          "text": "geflossen sind,",
          "start": 66.016,
          "end": 66.885
        },
        {
          "text": "laut einem Bericht im Wert",
          "start": 66.885,
          "end": 68.392
        },
        {
          "text": "von rund 7,5 Milliarden Dollar",
          "start": 68.392,
          "end": 70.13
        }
      ]
    },
    {
      "id": "s15",
      "start": 70.13,
      "end": 76.477,
      "captions": [
        {
          "text": "Schon seit 2024 wird",
          "start": 70.13,
          "end": 71.452
        },
        {
          "text": "gegen Megaspeed ermittelt,",
          "start": 71.452,
          "end": 73.171
        },
        {
          "text": "inzwischen auch",
          "start": 73.171,
          "end": 74.163
        },
        {
          "text": "vom amerikanischen",
          "start": 74.163,
          "end": 75.353
        },
        {
          "text": "Justizministerium",
          "start": 75.353,
          "end": 76.477
        }
      ]
    },
    {
      "id": "s16",
      "start": 76.477,
      "end": 80.8,
      "captions": [
        {
          "text": "Der Nvidia‑Vorstand hat",
          "start": 76.477,
          "end": 77.785
        },
        {
          "text": "deshalb eine eigene,",
          "start": 77.785,
          "end": 78.923
        },
        {
          "text": "unabhängige",
          "start": 78.923,
          "end": 79.549
        },
        {
          "text": "Untersuchung gestartet",
          "start": 79.549,
          "end": 80.8
        }
      ]
    },
    {
      "id": "s17",
      "start": 80.8,
      "end": 86.213,
      "captions": [
        {
          "text": "Schreib uns",
          "start": 80.8,
          "end": 81.395
        },
        {
          "text": "in die Kommentare: Glaubst du,",
          "start": 81.395,
          "end": 83.019
        },
        {
          "text": "das ist nur ein Sturm",
          "start": 83.019,
          "end": 84.156
        },
        {
          "text": "im Wasserglas,",
          "start": 84.156,
          "end": 84.914
        },
        {
          "text": "oder ein echtes Problem?",
          "start": 84.914,
          "end": 86.213
        }
      ]
    },
    {
      "id": "s18",
      "start": 86.213,
      "end": 87.863,
      "captions": [
        {
          "text": "Teil drei: die Aktie",
          "start": 86.213,
          "end": 87.863
        }
      ]
    },
    {
      "id": "s19",
      "start": 87.863,
      "end": 93.62,
      "captions": [
        {
          "text": "Am Montag fiel",
          "start": 87.863,
          "end": 88.924
        },
        {
          "text": "die Nvidia‑Aktie um gut 4 %,",
          "start": 88.924,
          "end": 91.044
        },
        {
          "text": "am Dienstag noch",
          "start": 91.044,
          "end": 92.257
        },
        {
          "text": "einmal um fast 6 %",
          "start": 92.257,
          "end": 93.62
        }
      ]
    },
    {
      "id": "s20",
      "start": 93.62,
      "end": 98.71,
      "captions": [
        {
          "text": "Allein am Dienstag sind damit",
          "start": 93.62,
          "end": 95.512
        },
        {
          "text": "rund 250 Milliarden Dollar",
          "start": 95.512,
          "end": 97.209
        },
        {
          "text": "Börsenwert verschwunden",
          "start": 97.209,
          "end": 98.71
        }
      ]
    },
    {
      "id": "s21",
      "start": 98.71,
      "end": 105.584,
      "captions": [
        {
          "text": "Und seit dem Rekord im Oktober",
          "start": 98.71,
          "end": 100.927
        },
        {
          "text": "hat Nvidia rund 30 % verloren,",
          "start": 100.927,
          "end": 103.145
        },
        {
          "text": "das sind etwa",
          "start": 103.145,
          "end": 104.106
        },
        {
          "text": "1,7 Billionen Dollar",
          "start": 104.106,
          "end": 105.584
        }
      ]
    },
    {
      "id": "s22",
      "start": 105.584,
      "end": 111.087,
      "captions": [
        {
          "text": "Dazu kam: Die Inflation",
          "start": 105.584,
          "end": 106.889
        },
        {
          "text": "in Amerika",
          "start": 106.889,
          "end": 107.456
        },
        {
          "text": "ist wieder gestiegen,",
          "start": 107.456,
          "end": 108.648
        },
        {
          "text": "viele rechnen jetzt",
          "start": 108.648,
          "end": 109.725
        },
        {
          "text": "sogar mit höheren Zinsen",
          "start": 109.725,
          "end": 111.087
        }
      ]
    },
    {
      "id": "s23",
      "start": 111.087,
      "end": 112.808,
      "captions": [
        {
          "text": "Teil vier: dein Geld",
          "start": 111.087,
          "end": 112.808
        }
      ]
    },
    {
      "id": "s24",
      "start": 112.808,
      "end": 118.677,
      "captions": [
        {
          "text": "Nvidia ist",
          "start": 112.808,
          "end": 113.498
        },
        {
          "text": "inzwischen die größte",
          "start": 113.498,
          "end": 114.948
        },
        {
          "text": "Firma im MSCI World,",
          "start": 114.948,
          "end": 116.329
        },
        {
          "text": "dem beliebtesten",
          "start": 116.329,
          "end": 117.434
        },
        {
          "text": "ETF in Deutschland",
          "start": 117.434,
          "end": 118.677
        }
      ]
    },
    {
      "id": "s25",
      "start": 118.677,
      "end": 123.39,
      "captions": [
        {
          "text": "Von 100 € in diesem",
          "start": 118.677,
          "end": 120.276
        },
        {
          "text": "ETF stecken knapp",
          "start": 120.276,
          "end": 121.707
        },
        {
          "text": "6 € allein in Nvidia",
          "start": 121.707,
          "end": 123.39
        }
      ]
    },
    {
      "id": "s26",
      "start": 123.39,
      "end": 129.115,
      "captions": [
        {
          "text": "Fällt Nvidia also um 10 %,",
          "start": 123.39,
          "end": 125.251
        },
        {
          "text": "verliert dein ETF",
          "start": 125.251,
          "end": 126.467
        },
        {
          "text": "allein dadurch rund",
          "start": 126.467,
          "end": 127.827
        },
        {
          "text": "ein halbes Prozent",
          "start": 127.827,
          "end": 129.115
        }
      ]
    },
    {
      "id": "s27",
      "start": 129.115,
      "end": 135.13,
      "captions": [
        {
          "text": "Das klingt wenig,",
          "start": 129.115,
          "end": 130.118
        },
        {
          "text": "aber bei KI‑Firmen hängen",
          "start": 130.118,
          "end": 131.592
        },
        {
          "text": "viele Aktien zusammen,",
          "start": 131.592,
          "end": 132.889
        },
        {
          "text": "und wenn eine wackelt,",
          "start": 132.889,
          "end": 134.186
        },
        {
          "text": "wackeln oft alle",
          "start": 134.186,
          "end": 135.13
        }
      ]
    },
    {
      "id": "s28",
      "start": 135.13,
      "end": 137.6,
      "captions": [
        {
          "text": "Teil fünf: was jetzt kommt",
          "start": 135.13,
          "end": 137.6
        }
      ]
    },
    {
      "id": "s29",
      "start": 137.6,
      "end": 141.981,
      "captions": [
        {
          "text": "Am 18. November soll",
          "start": 137.6,
          "end": 138.87
        },
        {
          "text": "Jensen Huang vor Politikern",
          "start": 138.87,
          "end": 140.584
        },
        {
          "text": "in Washington aussagen",
          "start": 140.584,
          "end": 141.981
        }
      ]
    },
    {
      "id": "s30",
      "start": 141.981,
      "end": 145.961,
      "captions": [
        {
          "text": "Und in den nächsten",
          "start": 141.981,
          "end": 143.127
        },
        {
          "text": "Tagen legt Nvidia seine",
          "start": 143.127,
          "end": 144.514
        },
        {
          "text": "neuen Quartalszahlen vor",
          "start": 144.514,
          "end": 145.961
        }
      ]
    },
    {
      "id": "s31",
      "start": 145.961,
      "end": 150.863,
      "captions": [
        {
          "text": "Sind die stark,",
          "start": 145.961,
          "end": 146.76
        },
        {
          "text": "kann sich die Aktie",
          "start": 146.76,
          "end": 147.773
        },
        {
          "text": "schnell erholen,",
          "start": 147.773,
          "end": 148.625
        },
        {
          "text": "enttäuschen sie,",
          "start": 148.625,
          "end": 149.478
        },
        {
          "text": "kann es weiter runtergehen",
          "start": 149.478,
          "end": 150.863
        }
      ]
    },
    {
      "id": "s32",
      "start": 150.863,
      "end": 153.0,
      "captions": [
        {
          "text": "Teil sechs: Was",
          "start": 150.863,
          "end": 151.806
        },
        {
          "text": "heißt das für dich?",
          "start": 151.806,
          "end": 153.0
        }
      ]
    },
    {
      "id": "s33",
      "start": 153.0,
      "end": 158.942,
      "captions": [
        {
          "text": "Erstens: Panik ist fast",
          "start": 153.0,
          "end": 154.454
        },
        {
          "text": "nie ein guter Ratgeber,",
          "start": 154.454,
          "end": 155.908
        },
        {
          "text": "wer in Krisen verkauft,",
          "start": 155.908,
          "end": 157.362
        },
        {
          "text": "verpasst oft die Erholung",
          "start": 157.362,
          "end": 158.942
        }
      ]
    },
    {
      "id": "s34",
      "start": 158.942,
      "end": 163.382,
      "captions": [
        {
          "text": "Zweitens: Schau dir an,",
          "start": 158.942,
          "end": 160.341
        },
        {
          "text": "wie viel von deinem Geld",
          "start": 160.341,
          "end": 161.801
        },
        {
          "text": "an wenigen KI‑Firmen hängt",
          "start": 161.801,
          "end": 163.382
        }
      ]
    },
    {
      "id": "s35",
      "start": 163.382,
      "end": 169.526,
      "captions": [
        {
          "text": "Und drittens:",
          "start": 163.382,
          "end": 164.083
        },
        {
          "text": "Ein Sparplan läuft weiter,",
          "start": 164.083,
          "end": 165.484
        },
        {
          "text": "auch wenn die Kurse fallen,",
          "start": 165.484,
          "end": 166.939
        },
        {
          "text": "dann bekommst du sogar",
          "start": 166.939,
          "end": 168.125
        },
        {
          "text": "mehr Anteile für dein Geld",
          "start": 168.125,
          "end": 169.526
        }
      ]
    },
    {
      "id": "s36",
      "start": 169.526,
      "end": 174.301,
      "captions": [
        {
          "text": "Der Nvidia‑Krimi ist",
          "start": 169.526,
          "end": 170.766
        },
        {
          "text": "noch nicht vorbei,",
          "start": 170.766,
          "end": 171.883
        },
        {
          "text": "also: ruhig bleiben",
          "start": 171.883,
          "end": 173.061
        },
        {
          "text": "und genau hinschauen",
          "start": 173.061,
          "end": 174.301
        }
      ]
    }
  ]
}