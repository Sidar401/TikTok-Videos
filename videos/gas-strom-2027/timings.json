     "end": 47.269
    },
    {
     "text": "Dezember da sein",
     "start": 47.269,
     "end": 48.112
    }
   ]
  },
  {
   "id": "s12",
   "start": 48.112,
   "end": 52.201,
   "captions": [
    {
     "text": "Lies deshalb den Brief",
     "start": 48.112,
     "end": 49.25
    },
    {
